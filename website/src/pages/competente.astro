---
import { Image, Picture } from "astro:assets";

import supportHeads from "../assets/competencies/support-heads.png";
import parentalCounselingIllustration from "../assets/competencies/parental-counseling-session.png";
import silviaPortrait from "../assets/homepage/silvia-dinu-portrait.png";
import SupportAreasAccordion from "../components/sections/SupportAreasAccordion";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials require Silvia's review before publication.

const supportAreas = [
  {
    title: "Anxietate și atacuri de panică",
    description:
      "Stări de neliniște, griji greu de oprit, frici, nevoia de a controla lucrurile sau episoade de panică care apar brusc și pot fi greu de înțeles.",
  },
  {
    title: "Stări depresive",
    description:
      "Tristețe care persistă, lipsă de energie sau de interes, retragere, vinovăție, sentiment de gol sau perioade în care lucrurile care înainte aveau sens nu mai aduc aceeași plăcere.",
  },
  {
    title: "Manifestări somatice",
    description:
      "Senzații sau simptome corporale care pot apărea atunci când anumite trăiri emoționale sunt dificil de înțeles, procesat sau exprimat în cuvinte. Dureri, tensiune, oboseală, disconfort digestiv, palpitații, amețeală, amorțeli sau alte senzații neplăcute în corp, mai ales atunci când acestea apar sau se intensifică în anumite perioade.",
  },
  {
    title: "Dificultăți în relații",
    description:
      "Conflicte care se repetă, dificultatea de a vă apropia sau de a avea încredere, teama de abandon, gelozie, dependență emoțională ori dificultatea de a spune ce aveți nevoie și de a pune limite.",
  },
  {
    title: "Stimă de sine și identitate",
    description:
      "Nesiguranță, autocritică, sentimentul că nu sunteți suficient de bun, nevoia frecventă de confirmare sau dificultatea de a înțelege mai clar ce vă doriți și ce vi se potrivește.",
  },
  {
    title: "Emoții greu de gestionat",
    description:
      "Furie, iritabilitate, impulsivitate, schimbări bruște de dispoziție, sensibilitate puternică la respingere sau momente în care ceea ce simțiți devine greu de controlat ori de pus în cuvinte.",
  },
  {
    title: "Tipare care se repetă",
    description:
      "Situații în care observați că ajungeți din nou la aceleași conflicte, alegeri sau rezultate, chiar dacă oamenii și împrejurările se schimbă și chiar dacă v-ați propus să procedați diferit.",
  },
  {
    title: "Pierderi și schimbări importante",
    description:
      "Doliu, despărțire, boală, epuizare, schimbarea locului de muncă, mutare, maternitate sau alte perioade de tranziție care pot aduce nesiguranță, neliniște sau nevoia de a vă regăsi un echilibru.",
  },
] as const;
---

<BaseLayout
  title="Competențe"
  description="Informații despre studiile, formarea, experiența, orientarea și ariile de lucru ale practicii Silviei Dinu."
>
  <section class="py-(--section-space)">
    <Container>
      <div class="about-layout">
        <div class="about-profile about-reveal about-reveal--profile">
          <figure class="profile-portrait">
            <Picture
              src={silviaPortrait}
              formats={["avif", "webp"]}
              widths={[320, 480, 640]}
              sizes="(max-width: 24.5rem) calc(100vw - 2.5rem), 22rem"
              quality={84}
              alt="Silvia Dinu"
              loading="eager"
              decoding="async"
            />
          </figure>

          <h1 class="about-title font-display">Silvia Dinu</h1>
          <p class="about-role text-foreground/80 mt-4 leading-7">
            Psihoterapeut psihanalitic
          </p>
        </div>

        <div class="about-narrative about-reveal about-reveal--narrative">
          <h2 class="about-method-title font-display">
            Dinspre sine către celălalt
          </h2>
          <div class="prose-editorial about-copy mt-8">
            <p>
              Am avut norocul ca întâlnirea mea cu psihanaliza să se întâmple la
              scurt timp după terminarea facultății de Psihologie. Am pornit pe
              acest drum cu multă curiozitate, dar și cu dorința de a înțelege,
              prin propria experiență, ce face demersul psihanalitic atât de
              valoros.
            </p>
            <p>
              Anii de formare și analiza personală m-au ajutat să îmi clădesc
              traseul în propria practică psihanalitică.
            </p>
            <p>
              În ultimii zece ani, întâlnirea din cabinet cu fiecare persoană și
              mai ales cu nevoile sale continuă să mă formeze ca psihoterapeut.
              Formarea teoretică și experiența de lucru au conturat modul în
              care lucrez în prezent: cu răbdare, curiozitate și respect pentru
              ritmul fiecărei persoane.
            </p>
            <p>
              <ActionLink href="/contact/">
                Solicitați o întâlnire preliminară
              </ActionLink>
            </p>
          </div>
        </div>

        <section
          class="about-support"
          aria-labelledby="about-support-title"
          data-therapy-help
        >
          <div class="about-section-intro">
            <h2
              id="about-support-title"
              class="heading-long about-support-title"
            >
              În practica mea, lucrez cu persoane care se confruntă cu astfel de
              dificultăți, fiecare în felul și ritmul său.
            </h2>
          </div>

          <Image
            class="about-support-heads"
            src={supportHeads}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />

          <SupportAreasAccordion
            items={supportAreas}
            headingLevel={3}
            client:load
          />
        </section>

        <section
          class="about-parental"
          aria-labelledby="about-parental-title"
          data-parent-counseling
        >
          <div class="about-parental-header">
            <div class="about-parental-heading">
              <h2
                id="about-parental-title"
                class="section-title about-parental-title"
              >
                Consiliere parentală
              </h2>
              <div class="about-parental-artwork" aria-hidden="true">
                <Image
                  src={parentalCounselingIllustration}
                  alt=""
                  widths={[480, 736]}
                  sizes="(max-width: 420px) 125vw, 480px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="about-parental-intro">
              <p>
                <strong>
                  Uneori, chiar și atunci când faceți tot ce puteți pentru
                  copilul dumneavoastră, pot apărea momente în care nu mai este
                  clar ce are nevoie, cum să vă apropiați sau ce ar fi de
                  ajutor. În astfel de perioade, și părinții pot avea nevoie de
                  un spațiu în care să înțeleagă mai bine ce se întâmplă.
                </strong>
              </p>
              <p>
                Poate observați o schimbare de comportament, conflictele au
                devenit mai frecvente, comunicarea este mai dificilă sau
                soluțiile care funcționau până acum nu mai par suficiente.
                Alteori, întrebarea este mai degrabă despre dumneavoastră ca
                părinte: cât să protejați, când să puneți o limită, când să
                oferiți mai multă libertate sau cum să rămâneți aproape într-o
                perioadă dificilă.
              </p>
            </div>
          </div>

          <div class="about-parental-uses">
            <h3
              class="about-parental-subtitle font-display text-2xl leading-tight"
            >
              Când vă poate ajuta consilierea parentală:
            </h3>
            <ul class="about-parental-list" data-parent-counseling-list>
              <li>
                copilul sau adolescentul este mai retras, anxios, trist,
                iritabil sau are reacții pe care vă este greu să le gestionați;
              </li>
              <li>
                apar conflicte frecvente legate de limite, școală, telefon,
                platforme sociale, anturaj sau nevoia de independență;
              </li>
              <li>
                simțiți că nu mai reușiți să comunicați așa cum o făceați
                înainte;
              </li>
              <li>
                apar probleme de somn, alimentație, concentrare sau manifestări
                corporale repetate;
              </li>
              <li>
                familia trece printr-un divorț, o pierdere, o mutare, apariția
                unui frate sau o altă schimbare importantă;
              </li>
              <li>
                vă este greu să găsiți un echilibru între protecție, limite și
                libertatea de care copilul are nevoie;
              </li>
              <li>
                vă simțiți epuizat, vinovat, neputincios sau nesigur în rolul de
                părinte;
              </li>
              <li>
                <strong>
                  copilul sau adolescentul urmează deja o psihoterapie și aveți
                  nevoie să înțelegeți cum îl puteți susține, păstrând în
                  același timp spațiul său personal
                </strong>.
              </li>
            </ul>
          </div>

          <div class="about-parental-closing">
            <p>
              Consilierea parentală nu caută un vinovat și nici o formulă
              perfectă de a fi părinte. Încercăm să înțelegem ce se întâmplă în
              această perioadă, ce poate sta în spatele anumitor reacții și ce
              ar putea ajuta relația dintre părinte și copil.
            </p>
            <p>
              Întâlnirile pot avea loc cu un singur părinte sau cu ambii
              părinți, în funcție de situație. Uneori sunt suficiente câteva
              ședințe pentru a clarifica o anumită problemă, iar alteori poate
              fi utilă o perioadă mai lungă de sprijin.
            </p>
          </div>
        </section>

        <section
          class="about-competencies"
          aria-labelledby="about-competencies-title"
        >
          <h2
            id="about-competencies-title"
            class="font-display text-3xl tracking-[-0.025em]"
          >
            Competențe
          </h2>

          <dl class="about-facts">
            <div class="about-studies">
              <dt class="text-muted-foreground text-sm">
                Studii și calificări
              </dt>
              <dd class="mt-2">
                <ul class="about-studies-list">
                  <li>
                    Licențiată în Psihologie — Universitatea de Vest din
                    Timișoara
                  </li>
                  <li>
                    Formare în Psihoterapie Psihanalitică la Asociația de
                    Consiliere și Psihoterapie Psihanalitică București (ACPPB)
                  </li>
                  <li>
                    Master în Psihanaliză la Universitatea Titu Maiorescu
                    București
                  </li>
                </ul>
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground text-sm">Orientare</dt>
              <dd class="mt-2">Psihanalitică / psihodinamică</dd>
            </div>
            <div>
              <dt class="text-muted-foreground text-sm">
                Experiență profesională
              </dt>
              <dd class="mt-2">Peste 10 ani</dd>
            </div>
            <div>
              <dt class="text-muted-foreground text-sm">Arii de lucru</dt>
              <dd class="mt-2">Depresie · Anxietate · Consiliere parentală</dd>
            </div>
          </dl>
        </section>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .about-layout {
    display: grid;
    gap: 3.5rem;
  }

  .about-reveal--profile {
    animation: about-profile-reveal var(--duration-panel) var(--ease-out) both;
  }

  .about-reveal--narrative {
    animation: about-content-reveal var(--duration-panel) var(--ease-out) both;
    animation-delay: 60ms;
  }

  .profile-portrait {
    width: min(100%, 22rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-inline: 0;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    border-radius: var(--radius-2xl);
    background: var(--muted);
  }

  .about-copy {
    max-width: 30rem;
  }

  .about-title {
    max-width: 12ch;
    margin-block-start: clamp(1.75rem, 3vw, 2.5rem);
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .about-role {
    max-width: 32rem;
  }

  .about-method-title {
    max-width: 18ch;
    margin-block-start: 0;
    font-size: clamp(2.25rem, 3.2vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .about-copy :global([data-slot="button"]:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .about-facts {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    border-block: 1px solid var(--border);
    padding-block: 1.5rem;
  }

  .about-support,
  .about-parental {
    grid-column: 1 / -1;
  }

  .about-support {
    margin-block-start: clamp(2rem, 5vw, 4.5rem);
  }

  .about-support-heads {
    display: block;
    width: 24rem;
    max-width: 100%;
    height: auto;
    margin-block-start: 2rem;
  }

  .about-support :global([data-therapy-help-list]) {
    margin-block-start: 2rem;
  }

  .section-title.about-parental-title {
    max-width: 10ch;
    font-size: clamp(2.125rem, 3.2vw, 2.75rem);
    text-wrap: balance;
  }

  .about-section-intro,
  .about-parental-header {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .about-parental {
    container-name: about-parental;
    container-type: inline-size;
    margin-block-start: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-2xl);
    background: color-mix(in oklch, var(--muted) 56%, var(--background));
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .about-parental-intro {
    display: grid;
    gap: 1.5rem;
    max-width: 65ch;
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .about-parental-artwork {
    width: min(100%, 24rem);
    margin-block-start: 2rem;
  }

  .about-parental-artwork img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-parental-intro strong,
  .about-parental-list strong {
    font-weight: 400;
  }

  .about-parental-intro > p:first-child strong {
    font-weight: 400;
  }

  .about-parental-uses {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .about-parental-subtitle {
    max-width: 28ch;
    text-wrap: balance;
  }

  .about-parental-list {
    display: grid;
    gap: 1.25rem clamp(2.5rem, 6vw, 5rem);
    max-width: 65ch;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about-parental-list li {
    position: relative;
    padding-inline-start: 1.5rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .about-parental-list li::before {
    position: absolute;
    inset-block-start: 0.72em;
    inset-inline-start: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: currentColor;
    content: "";
  }

  .about-parental-closing {
    display: grid;
    gap: 1.5rem clamp(2.5rem, 6vw, 5rem);
    max-width: 65ch;
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    color: var(--muted-foreground);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .about-studies-list {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 0;
    list-style: none;
  }

  .profile-portrait :global(picture),
  .profile-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .profile-portrait :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  @media (width < 48rem) {
    .about-support-title {
      font-size: clamp(1.75rem, 5vw, 2.25rem);
      line-height: 1.4;
    }

    .about-parental {
      margin-inline: calc(-1 * var(--page-gutter));
      border-radius: 0;
      padding-inline: var(--page-gutter);
    }
  }

  @media (min-width: 48rem) {
    .about-layout {
      grid-template-columns: minmax(0, min(32%, 22rem)) minmax(0, 1fr);
      column-gap: clamp(2rem, 4vw, 6rem);
    }

    .about-profile {
      grid-column: 1;
      grid-row: 1;
    }

    .about-narrative {
      grid-column: 2;
      grid-row: 1;
    }

    .about-competencies {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 40rem) {
    .about-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4rem);
    }

    .about-studies {
      grid-column: span 2;
    }
  }

  @container about-parental (min-width: 50rem) {
    .about-parental-header {
      grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1.28fr);
      column-gap: clamp(2.5rem, 6vw, 5rem);
    }

    .about-parental-list,
    .about-parental-closing {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 6vw, 5rem);
    }

    .about-parental-list,
    .about-parental-closing {
      max-width: none;
    }
  }

  @media (min-width: 64rem) {
    .about-layout {
      column-gap: clamp(3.5rem, 6vw, 6rem);
    }

    .about-facts {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @keyframes about-profile-reveal {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes about-content-reveal {
    from {
      transform: translateY(0.5rem);
    }

    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal {
      animation: none;
    }
  }
</style>
