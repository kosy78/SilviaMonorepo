---
import { getCollection } from "astro:content";
import ActionLink from "../../components/ui/ActionLink.astro";
import Container from "../../components/ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft || (import.meta.env.DEV && data.localPreview),
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const formatter = new Intl.DateTimeFormat("ro-RO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title="Blog Silvia Dinu · Psihoterapie și relații"
  description="Articole de Silvia Dinu despre psihoterapie psihanalitică, relații, viață emoțională și momente de schimbare."
  robots={posts.some((post) => post.data.draft)
    ? "noindex, nofollow"
    : undefined}
>
  <section class="py-(--section-space)">
    <Container>
      <h1 class="sr-only">Blog</h1>
      {
        posts.length > 0 ? (
          <ol class="divide-line divide-y p-0">
            {posts.map((post) => (
              <li class="grid list-none items-start gap-6 py-8 md:grid-cols-[14rem_1fr] md:gap-10">
                {post.data.cover && (
                  <a
                    href={`/blog/${post.id}/`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      {...post.data.cover}
                      alt=""
                      class="aspect-[4/3] w-full max-w-sm rounded-xl object-cover object-[center_40%]"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class:list={{ "md:col-start-2": !post.data.cover }}>
                  {post.data.draft ? (
                    <p class="text-muted-foreground text-sm">
                      Previzualizare · Ciornă
                    </p>
                  ) : (
                    <time
                      class="text-muted-foreground text-sm"
                      datetime={post.data.publishedAt.toISOString()}
                    >
                      {formatter.format(post.data.publishedAt)}
                    </time>
                  )}
                  <h2 class="mt-4 text-3xl tracking-[-0.025em]">
                    <a
                      class="underline-offset-6 hover:underline"
                      href={`/blog/${post.id}/`}
                    >
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-muted-foreground mt-3 max-w-2xl leading-7">
                    {post.data.description}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <div class="max-w-2xl">
            <h2 class="text-4xl tracking-[-0.035em]">Articole în pregătire</h2>
            <p class="text-muted-foreground mt-5 text-lg leading-8">
              Primele articole vor fi publicate după redactare, verificare și
              aprobarea formei finale.
            </p>
            <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
              <ActionLink
                href="/psihoterapie-si-consiliere/"
                variant="secondary"
              >
                Despre psihoterapie și consiliere
              </ActionLink>
            </div>
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
