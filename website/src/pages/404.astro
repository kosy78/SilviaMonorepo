---
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagină negăsită"
  description="Pagina căutată nu există sau adresa s-a schimbat."
  robots="noindex, follow"
  canonical={false}
  socialPreview={false}
>
  <section class="page-not-found">
    <Container>
      <div class="page-not-found__frame">
        <div class="page-not-found__visual" aria-hidden="true">
          <p class="page-not-found__number">404</p>
        </div>
        <div class="page-not-found__content">
          <h1 class="display-page">Pagina căutată nu există.</h1>
          <p class="page-not-found__description">
            Este posibil ca adresa să se fi schimbat sau să conțină o greșeală
            de scriere. Puteți continua din pagina principală sau printr-un
            mesaj.
          </p>
          <div class="page-not-found__actions">
            <ActionLink href="/">Mergeți la pagina principală</ActionLink>
            <a href="/contact/" class="page-not-found__contact">Contact</a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .page-not-found {
    display: grid;
    min-height: calc(100svh - var(--site-header-clearance));
    align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem);
    background: var(--background);
  }

  .page-not-found__frame {
    display: grid;
    min-height: clamp(31rem, 58vw, 39rem);
    grid-template-columns: minmax(17rem, 0.82fr) minmax(0, 1.18fr);
    overflow: hidden;
    border-block: 1px solid var(--border);
  }

  .page-not-found__visual {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    place-items: end start;
    background: var(--foreground);
  }

  .page-not-found__visual::before,
  .page-not-found__visual::after {
    position: absolute;
    z-index: -1;
    content: "";
    pointer-events: none;
  }

  .page-not-found__visual::before {
    top: -12%;
    right: -18%;
    width: 72%;
    height: 128%;
    background: color-mix(in oklch, var(--background) 18%, transparent);
    filter: blur(2rem);
    transform: rotate(13deg);
  }

  .page-not-found__visual::after {
    top: 0;
    right: 18%;
    width: 1px;
    height: 100%;
    background: color-mix(in oklch, var(--chart-3) 70%, transparent);
    box-shadow: 8rem 0 color-mix(in oklch, var(--chart-3) 26%, transparent);
    transform: rotate(13deg) scaleY(1.2);
  }

  .page-not-found__number {
    margin: 0 0 -0.085em -0.045em;
    color: color-mix(in oklch, var(--background) 92%, transparent);
    font-family: var(--font-display);
    font-size: clamp(8rem, 18vw, 14rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.09em;
  }

  .page-not-found__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 7vw, 5rem);
    background: var(--muted);
  }

  .page-not-found__content h1 {
    max-width: 12ch;
    font-size: clamp(2.75rem, 5.5vw, 5rem);
  }

  .page-not-found__description {
    max-width: 36rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 1.8vw, 1.1875rem);
    line-height: 1.7;
  }

  .page-not-found__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .page-not-found__contact {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: 0.25rem;
    font-size: 0.875rem;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  @media (max-width: 47rem) {
    .page-not-found__frame {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .page-not-found__visual {
      min-height: clamp(11rem, 48vw, 15rem);
    }

    .page-not-found__number {
      font-size: clamp(7.5rem, 35vw, 11rem);
    }

    .page-not-found__content {
      padding: clamp(2rem, 8vw, 3.5rem) clamp(1.5rem, 7vw, 3rem);
    }
  }

  @media (max-width: 25rem) {
    .page-not-found__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .page-not-found__actions :global([data-slot="button"]) {
      width: 100%;
    }

    .page-not-found__contact {
      justify-content: center;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .page-not-found__visual::before {
      display: none;
    }
  }
</style>
