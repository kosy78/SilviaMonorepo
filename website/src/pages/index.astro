---
import { IconArrowRight, IconMail } from "@tabler/icons-react";
import { Picture } from "astro:assets";

import practiceSky from "../assets/homepage/practice-sky.jpg";
import HomepageAbout from "../components/sections/HomepageAbout.astro";
import HomepageAreas from "../components/sections/HomepageAreas.astro";
import HomepageBlog from "../components/sections/HomepageBlog.astro";
import HomepageHero from "../components/sections/HomepageHero.astro";
import HomepageOrientation from "../components/sections/HomepageOrientation.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Separator } from "../components/ui/separator";
import { Tag } from "../components/ui/tag";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials, experience and practical wording require
// Silvia's review before publication.
---

<BaseLayout
  title="Psihoterapie psihanalitică în București și online"
  description="Psihoterapie psihanalitică și consiliere pentru adulți, tineri adulți și adolescenți de la 16 ani, în București, zona Piața Victoriei / Banu Manta, și online."
>
  <script is:inline>
    (() => {
      const revealRoot = document.documentElement;
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      if (prefersReducedMotion.matches || !("IntersectionObserver" in window))
        return;

      revealRoot.dataset.homeReveal = "ready";
      let revealInitialized = false;
      let revealFallback = 0;

      const initializeHomeReveal = () => {
        if (revealInitialized) return;
        revealInitialized = true;
        window.clearTimeout(revealFallback);

        try {
          const revealSections = document.querySelectorAll(
            "#continut > section:not([data-homepage-hero])",
          );
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;

                entry.target.dataset.homeReveal = "visible";
                revealObserver.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -14% 0px", threshold: 0.08 },
          );

          revealSections.forEach((section) => revealObserver.observe(section));
        } catch {
          delete revealRoot.dataset.homeReveal;
        }
      };

      const scheduleHomeReveal = () => {
        if (revealRoot.dataset.homeHeroReveal === "complete") {
          initializeHomeReveal();
          return;
        }

        window.addEventListener(
          "homepage-hero-reveal-complete",
          initializeHomeReveal,
          { once: true },
        );
        revealFallback = window.setTimeout(initializeHomeReveal, 2200);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", scheduleHomeReveal, {
          once: true,
        });
      } else {
        scheduleHomeReveal();
      }
    })();
  </script>

  <HomepageHero />
  <HomepageAreas />
  <HomepageOrientation />
  <HomepageAbout />

  <HomepageBlog />

  <section class="homepage-practice" aria-labelledby="homepage-practice-title">
    <div class="homepage-practice__background" aria-hidden="true">
      <Picture
        src={practiceSky}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1754]}
        sizes="100vw"
        quality={84}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="homepage-practice__foreground">
      <Container>
        <Card className="homepage-practice__card">
          <CardHeader className="homepage-practice__header">
            <Tag variant="section">Contact</Tag>
            <CardTitle>
              <h2 id="homepage-practice-title" class="section-title">
                În cabinet și online
              </h2>
            </CardTitle>
          </CardHeader>

          <Separator />

          <CardContent className="homepage-practice__steps">
            <article class="homepage-practice__step">
              <div class="homepage-practice__step-heading">
                <Tag variant="index">01</Tag>
                <h3>Primul mesaj</h3>
              </div>
              <p>
                Puteți întreba despre disponibilitate și puteți menționa
                formatul preferat. Nu este nevoie să trimiteți detalii sensibile
                sau să explicați întreaga situație.
              </p>
            </article>

            <Separator
              orientation="vertical"
              className="homepage-practice__separator homepage-practice__separator--wide"
            />
            <Separator
              className="homepage-practice__separator homepage-practice__separator--narrow"
            />

            <article class="homepage-practice__step">
              <div class="homepage-practice__step-heading">
                <Tag variant="index">02</Tag>
                <h3>Detaliile și prima întâlnire</h3>
              </div>
              <p>
                Vă răspund cu informații despre disponibilitate, onorariu și
                format. Dacă decideți să stabilim o primă întâlnire, putem vorbi
                atunci mai pe larg despre ceea ce vă preocupă și despre
                întrebările pe care le aveți.
              </p>
            </article>
          </CardContent>

          <CardFooter className="homepage-practice__contact">
            <div class="homepage-practice__contact-copy">
              <IconMail aria-hidden="true" />
              <p>Puteți folosi formularul sau adresa de email.</p>
            </div>
            <ActionLink href="/contact/">
              Trimiteți un prim mesaj
              <IconArrowRight data-icon="inline-end" aria-hidden="true" />
            </ActionLink>
          </CardFooter>
        </Card>
      </Container>
    </div>
  </section>
</BaseLayout>

<style>
  :global(
    html[data-home-reveal="ready"]
      #continut
      > section:not([data-homepage-hero]):not([data-home-reveal="visible"])
      > :not([aria-hidden="true"])
  ) {
    filter: blur(8px);
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0);
  }

  :global(
    html[data-home-reveal="ready"]
      #continut
      > section:not([data-homepage-hero])
      > :not([aria-hidden="true"])
  ) {
    transition:
      filter var(--duration-enter) var(--ease-out),
      opacity var(--duration-enter) var(--ease-out),
      transform var(--duration-enter) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(
      html[data-home-reveal="ready"]
        #continut
        > section:not([data-homepage-hero])
        > :not([aria-hidden="true"])
    ) {
      filter: none;
      opacity: 1;
      transform: none;
      transition: opacity var(--duration-exit) var(--ease-out);
    }
  }

  .homepage-practice {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--muted);
    padding-block: var(--section-space);
  }

  .homepage-practice::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--background) 14%, transparent),
      color-mix(in oklch, var(--background) 30%, transparent)
    );
    content: "";
    pointer-events: none;
  }

  .homepage-practice__background {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .homepage-practice__background :global(picture),
  .homepage-practice__background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-practice__background :global(img) {
    object-fit: cover;
    object-position: center 62%;
    outline: 1px solid color-mix(in oklch, var(--foreground) 10%, transparent);
    outline-offset: -1px;
  }

  .homepage-practice__foreground {
    position: relative;
    z-index: 2;
  }

  .homepage-practice__card {
    --card-spacing: clamp(1.5rem, 4vw, 3.5rem);

    gap: 0;
    padding-block: 0;
    background: color-mix(in oklch, var(--card) 90%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(90%);
    backdrop-filter: blur(12px) saturate(90%);
  }

  .homepage-practice__header {
    gap: 1.5rem;
    padding-block: var(--card-spacing);
  }

  .homepage-practice__steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: var(--card-spacing);
  }

  .homepage-practice__step {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .homepage-practice__step-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .homepage-practice__step h3 {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .homepage-practice__step p {
    max-width: 40rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.75;
  }

  .homepage-practice__separator--narrow {
    display: none;
  }

  .homepage-practice__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .homepage-practice__contact-copy {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .homepage-practice__contact-copy :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: var(--foreground);
  }

  @media (max-width: 48rem) {
    .homepage-practice__steps {
      display: flex;
      flex-direction: column;
      gap: var(--card-spacing);
    }

    .homepage-practice__separator--wide {
      display: none;
    }

    .homepage-practice__separator--narrow {
      display: block;
    }

    .homepage-practice__contact {
      align-items: stretch;
      flex-direction: column;
    }

    .homepage-practice__contact :global(a) {
      width: 100%;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-practice__card {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
