---
import { Picture } from "astro:assets";
import { IconArrowRight } from "@tabler/icons-react";

import silviaPortrait from "../../assets/homepage/silvia-dinu-portrait.png";
import silviaGraphic from "../../assets/homepage/silvia-reflection-graphic.png";
import Container from "../ui/Container.astro";

const aboutHref = "/competente/";
---

<section class="homepage-about" id="cum-lucrez">
  <Container>
    <a
      class="homepage-about__link"
      href={aboutHref}
      aria-labelledby="homepage-about-title"
      data-homepage-about
    >
      <figure class="homepage-about__card">
        <div class="homepage-about__copy">
          <div class="homepage-about__statement">
            <h2 class="homepage-about__title" id="homepage-about-title">
              Silvia Dinu
            </h2>
            <blockquote>
              Am avut norocul ca întâlnirea mea cu psihanaliza să se întâmple la
              scurt timp după terminarea facultății de Psihologie. Am pornit pe
              acest drum cu multă curiozitate, dar și cu dorința de a înțelege,
              prin propria experiență, ce face demersul psihanalitic atât de <span
                class="homepage-about__statement-ending"
                >valoros.<IconArrowRight
                  data-icon="inline-end"
                  aria-hidden="true"
                /></span
              >
            </blockquote>
          </div>

          <div class="homepage-about__graphic" aria-hidden="true">
            <Picture
              src={silviaGraphic}
              formats={["webp"]}
              widths={[384, 768]}
              sizes="(max-width: 30rem) 80vw, 384px"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="homepage-about__portrait">
          <Picture
            src={silviaPortrait}
            formats={["avif", "webp"]}
            widths={[384, 768]}
            sizes="(max-width: 47rem) calc(100vw - 2.5rem), 28rem"
            quality={84}
            alt="Silvia Dinu"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </a>
  </Container>
</section>

<style>
  .homepage-about {
    padding-block: var(--section-space);
  }

  .homepage-about__link {
    display: block;
    width: 100%;
    margin-inline: auto;
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
  }

  .homepage-about__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-about__card {
    display: grid;
    min-height: 24.9375rem;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 2fr);
    overflow: hidden;
    margin: 0;
    border-radius: inherit;
    background: var(--muted);
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-about__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 2.75rem;
  }

  .homepage-about__graphic {
    position: relative;
    width: min(100%, 21rem);
    aspect-ratio: 1045 / 402;
    flex-shrink: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Trim excess transparent margins, retaining breathing room around the ink. */
  .homepage-about__graphic :global(picture) {
    position: absolute;
    top: calc(-56 / 402 * 100%);
    left: calc(-77 / 1045 * 100%);
    width: calc(1199 / 1045 * 100%);
  }

  .homepage-about__graphic :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .homepage-about__statement {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .homepage-about__statement blockquote {
    max-width: 29.5rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: var(--body-copy-line-height);
    letter-spacing: 0.01em;
  }

  .homepage-about__title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .homepage-about__statement-ending {
    white-space: nowrap;
  }

  .homepage-about__statement :global([data-icon="inline-end"]) {
    display: inline-block;
    width: 1.125rem;
    height: 1.125rem;
    margin-inline-start: 0.25rem;
    vertical-align: -0.2em;
    transition: transform var(--duration-state) var(--ease-out);
  }

  .homepage-about__portrait {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }

  .homepage-about__portrait :global(picture) {
    position: absolute;
    inset: 0;
  }

  .homepage-about__portrait :global(picture),
  .homepage-about__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-about__portrait :global(img) {
    object-fit: cover;
    object-position: center 30%;
    transition: transform var(--duration-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-about__link:hover .homepage-about__card {
      box-shadow: 0 0 0 1px var(--border);
      transform: translateY(-2px);
    }

    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: scale(1.015);
    }

    .homepage-about__link:hover
      .homepage-about__statement
      :global([data-icon="inline-end"]) {
      transform: translateX(0.2rem);
    }
  }

  @media (max-width: 47rem) {
    .homepage-about__card {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .homepage-about__copy {
      gap: 2rem;
      padding: clamp(1.75rem, 7vw, 2.5rem);
      padding-block-end: 2rem;
    }

    .homepage-about__portrait {
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 32rem;
    }
  }

  @media (max-width: 25rem) {
    .homepage-about__statement blockquote {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-about__card,
    .homepage-about__statement :global([data-icon="inline-end"]),
    .homepage-about__portrait :global(img) {
      transition: none;
    }

    .homepage-about__link:hover .homepage-about__card,
    .homepage-about__link:hover
      .homepage-about__statement
      :global([data-icon="inline-end"]),
    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: none;
    }
  }
</style>
