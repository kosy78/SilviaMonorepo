---
import ContactForm from "../components/contact/ContactForm.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: in review after adding the minimal contact form. Practical,
// privacy and retention wording require Silvia's final review before launch.

const emailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire";
---

<BaseLayout
  title="Contact"
  description="Contact pentru psihoterapie psihanalitică și consiliere în București, zona Piața Victoriei / Banu Manta, sau online."
>
  <section class="border-line border-b py-(--intro-space)">
    <Container>
      <h1 class="display-page">Îmi puteți scrie.</h1>

      <div class="mt-10 grid gap-10 md:grid-cols-[1.25fr_0.75fr] md:items-end">
        <p class="text-muted max-w-2xl text-lg leading-8 md:text-xl">
          Nu este necesar să descrieți întreaga situație. Pentru început, este
          suficientă adresa dumneavoastră de email și, dacă doriți, câteva
          detalii practice.
        </p>
        <div class="md:justify-self-end md:text-right">
          <p class="text-muted text-sm">Adresă de email</p>
          <a
            href={emailHref}
            class="mt-2 block text-lg underline decoration-1 underline-offset-4"
          >
            silvia.drn@gmail.com
          </a>
          <p class="text-muted mt-4 max-w-xs text-sm leading-6">
            Dacă preferați, puteți folosi direct adresa de email în locul
            formularului.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-(--section-space)">
    <Container class="grid gap-14 md:grid-cols-[1fr_1.4fr]">
      <div>
        <h2 class="section-title">Trimiteți un mesaj</h2>
        <p class="text-muted mt-5 max-w-sm leading-7">
          Formularul cere numai informațiile necesare pentru a putea răspunde și
          a clarifica o posibilă primă întâlnire.
        </p>
      </div>

      <div>
        <ContactForm />
      </div>
    </Container>
  </section>

  <section class="bg-soft py-(--section-space)">
    <Container class="grid gap-14 md:grid-cols-[1fr_1.4fr]">
      <h2 class="section-title">După mesaj</h2>
      <div class="prose-editorial">
        <p>
          Vă voi răspunde la adresa de email indicată. Putem clarifica astfel
          disponibilitatea, alegerea între cabinet și online, onorariul și
          celelalte detalii practice.
        </p>
        <p>
          Dacă disponibilitatea și formatul vi se potrivesc, putem stabili o
          primă întâlnire. Atunci poate fi discutat mai pe larg ce vă aduce și
          cum ar putea continua procesul.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
