---
import { IconPlayerPause, IconPlayerPlay } from "@tabler/icons-react";
import { Picture } from "astro:assets";

import heroBackground from "../../assets/homepage/hero-bg.png";
import ActionLink from "../ui/ActionLink.astro";

const heroHeadingDelay = 100;
const heroHeadingDuration = 560;
const heroCtaGap = 80;
const heroCtaDuration = 320;
const heroSectionOverlap = 100;
const heroSectionRevealDelay = heroCtaDuration - heroSectionOverlap;
const heroCtaDelay = heroHeadingDelay + heroHeadingDuration + heroCtaGap;
---

<section class="homepage-hero" data-homepage-hero data-parallax-hero>
  <div class="homepage-hero__background" aria-hidden="true">
    <Picture
      src={heroBackground}
      formats={["avif", "webp"]}
      widths={[640, 1024, 1440, 1920, 2560]}
      sizes="100vw"
      quality={84}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <video
      class="homepage-hero__video"
      data-homepage-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="/videos/homepage-hero-leaf-shadows.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="homepage-hero__wash" aria-hidden="true"></div>

  <button
    type="button"
    class="homepage-hero__motion-control ui-control"
    aria-label="Puneți animația pe pauză"
    aria-pressed="false"
    data-homepage-hero-motion-control
    data-paused="false"
  >
    <IconPlayerPause
      className="homepage-hero__motion-pause"
      aria-hidden="true"
    />
    <IconPlayerPlay className="homepage-hero__motion-play" aria-hidden="true" />
  </button>

  <div class="homepage-hero__content">
    <h1
      data-homepage-hero-heading
      style={`--hero-heading-delay: ${heroHeadingDelay}ms`}
    >
      Unele lucruri au nevoie de <em>timp</em> și de un <em>spațiu</em> în care să
      poată fi înțelese.
    </h1>
    <div
      class="homepage-hero__actions"
      data-homepage-hero-actions
      data-homepage-section-reveal-delay={heroSectionRevealDelay}
      style={`--hero-cta-delay: ${heroCtaDelay}ms`}
    >
      <ActionLink href="/contact/" icon="mail">
        Solicitați o întâlnire preliminară
      </ActionLink>
    </div>
  </div>
</section>

<style>
  .homepage-hero {
    --hero-parallax-y: 0px;
    --hero-content-offset-y: 30px;
    position: relative;
    isolation: isolate;
    display: grid;
    height: calc(
      clamp(32rem, 41.6667vw, 37.5rem) + var(--hero-content-offset-y)
    );
    min-height: calc(32rem + var(--hero-content-offset-y));
    overflow: hidden;
    padding-bottom: var(--hero-content-offset-y);
    place-items: end center;
    background: var(--background);
  }

  .homepage-hero::after {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    height: clamp(8rem, 12vw, 10rem);
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklch, var(--background) 68%, transparent) 62%,
      var(--background)
    );
    content: "";
    pointer-events: none;
  }

  .homepage-hero__background {
    position: absolute;
    z-index: 0;
    inset: -1.5rem;
    transform: translate3d(0, var(--hero-parallax-y), 0) scale(1.035);
    will-change: transform;
  }

  .homepage-hero__background :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-hero__background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 47%;
  }

  .homepage-hero__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 47%;
    opacity: 0;
    transition: opacity var(--duration-panel) var(--ease-out);
  }

  .homepage-hero__video[data-ready="true"] {
    opacity: 1;
  }

  .homepage-hero__wash {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--background) 50%, transparent),
      transparent 62%
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .homepage-hero__motion-control {
    position: absolute;
    z-index: 3;
    top: 5.75rem;
    right: max(var(--page-gutter), calc((100vw - var(--content-width)) / 2));
    display: inline-grid;
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    border: 1px solid color-mix(in oklch, var(--border) 82%, transparent);
    border-radius: 999px;
    background: color-mix(in oklch, var(--background) 92%, transparent);
    color: var(--foreground);
    box-shadow: 0 0.25rem 1rem
      color-mix(in oklch, var(--foreground) 7%, transparent);
    opacity: 0;
    transform: translateY(-0.25rem);
    visibility: hidden;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      opacity var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out),
      visibility 0s linear var(--duration-state),
      background-color var(--duration-state) var(--ease-state);
  }

  .homepage-hero[data-video-ready="true"] .homepage-hero__motion-control {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .homepage-hero__motion-control:hover {
    background: var(--background);
  }

  .homepage-hero__motion-control :global(svg) {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    transition:
      opacity var(--duration-press) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-hero__motion-play {
    opacity: 0;
    transform: scale(0.8);
  }

  .homepage-hero__motion-control[data-paused="true"]
    .homepage-hero__motion-pause {
    opacity: 0;
    transform: scale(0.8);
  }

  .homepage-hero__motion-control[data-paused="true"]
    .homepage-hero__motion-play {
    opacity: 1;
    transform: scale(1);
  }

  .homepage-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(calc(100% - (2 * var(--page-gutter))), 33rem);
    flex-direction: column;
    align-items: center;
    gap: 2.3125rem;
    margin-bottom: clamp(0.625rem, 1.2vw, 1rem);
    color: var(--primary);
    text-align: center;
    transform: translateY(var(--hero-content-offset-y));
  }

  .homepage-hero__content h1 {
    width: 100%;
    color: var(--foreground);
    font-size: clamp(2rem, 2.25vw, 2.5rem);
    line-height: 1.241;
    letter-spacing: -0.02em;
    text-wrap: balance;
    animation: homepage-hero-heading-reveal var(--duration-enter)
      var(--ease-out) both;
    animation-delay: var(--hero-heading-delay);
  }

  .homepage-hero__content em {
    font-style: italic;
    font-weight: 400;
  }

  .homepage-hero__actions {
    display: flex;
    justify-content: center;
    animation: homepage-hero-cta-reveal var(--duration-panel) var(--ease-panel)
      both;
    animation-delay: var(--hero-cta-delay);
  }

  .homepage-hero__actions :global([data-slot="button"]) {
    border: 1px solid color-mix(in oklch, var(--border) 82%, transparent);
    background: color-mix(in oklch, var(--background) 94%, transparent);
    color: var(--muted-foreground);
    box-shadow: 0 0.25rem 1rem
      color-mix(in oklch, var(--primary) 6%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .homepage-hero__actions :global([data-slot="button"]:hover) {
    background: var(--background);
    color: var(--foreground);
  }

  @media (min-width: 82rem) {
    .homepage-hero {
      --hero-content-offset-y: 0px;
    }

    .homepage-hero__content {
      width: min(calc(100% - (2 * var(--page-gutter))), 48rem);
      margin-bottom: 1.75rem;
      transform: none;
    }
  }

  @media (max-width: 48rem) {
    .homepage-hero {
      height: calc(clamp(36rem, 82svh, 44rem) + var(--hero-content-offset-y));
      min-height: calc(36rem + var(--hero-content-offset-y));
    }

    .homepage-hero__background {
      inset: -0.75rem;
      transform: translate3d(0, var(--hero-parallax-y), 0) scale(1.025);
    }

    .homepage-hero__background :global(img) {
      object-position: center 47%;
    }

    .homepage-hero__video {
      object-position: center 47%;
    }

    .homepage-hero__content {
      gap: 1.75rem;
      margin-bottom: 1.25rem;
    }

    .homepage-hero__content h1 {
      font-size: clamp(2rem, 8.25vw, 2.5rem);
    }

    .homepage-hero__motion-control {
      right: var(--page-gutter);
    }
  }

  @media (max-width: 25rem) {
    .homepage-hero__actions,
    .homepage-hero__actions :global(a) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-hero__content h1,
    .homepage-hero__actions {
      filter: none;
      opacity: 1;
      transform: none;
      animation: none;
    }

    .homepage-hero__background {
      --hero-parallax-y: 0px;
      will-change: auto;
    }

    .homepage-hero__video {
      display: none;
      transition: none;
    }

    .homepage-hero__motion-control {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-hero__actions :global([data-slot="button"]) {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .homepage-hero__motion-control {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @keyframes homepage-hero-heading-reveal {
    from {
      filter: blur(64px);
      opacity: 0;
      transform: translate3d(0, 0.5rem, 0);
    }

    to {
      filter: blur(0);
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes homepage-hero-cta-reveal {
    from {
      filter: blur(8px);
      opacity: 0;
      transform: translate3d(0, 0.5rem, 0);
    }

    to {
      filter: blur(0);
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
</style>

<script>
  const parallaxHero = document.querySelector<HTMLElement>(
    "[data-parallax-hero]",
  );
  const parallaxBackground = parallaxHero?.querySelector<HTMLElement>(
    ".homepage-hero__background",
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );
  const heroVideo = parallaxHero?.querySelector<HTMLVideoElement>(
    "[data-homepage-hero-video]",
  );
  const heroMotionControl = parallaxHero?.querySelector<HTMLButtonElement>(
    "[data-homepage-hero-motion-control]",
  );
  const heroActions = parallaxHero?.querySelector<HTMLElement>(
    "[data-homepage-hero-actions]",
  );
  const signalHeroRevealComplete = () => {
    if (document.documentElement.dataset.homeHeroReveal === "complete") return;

    document.documentElement.dataset.homeHeroReveal = "complete";
    window.dispatchEvent(new Event("homepage-hero-reveal-complete"));
  };

  if (heroVideo) {
    let videoWasPausedByVisitor = false;
    const updateMotionControl = () => {
      if (!heroMotionControl) return;

      const isPaused = heroVideo.paused;
      heroMotionControl.dataset.paused = String(isPaused);
      heroMotionControl.setAttribute("aria-pressed", String(isPaused));
      heroMotionControl.setAttribute(
        "aria-label",
        isPaused ? "Reluați animația" : "Puneți animația pe pauză",
      );
    };
    const showVideo = () => {
      heroVideo.dataset.ready = "true";
      parallaxHero?.setAttribute("data-video-ready", "true");
      updateMotionControl();
    };
    const hideVideo = () => {
      delete heroVideo.dataset.ready;
      parallaxHero?.removeAttribute("data-video-ready");
    };
    const syncVideoPlayback = () => {
      if (prefersReducedMotion.matches) {
        heroVideo.pause();
        hideVideo();
        return;
      }

      if (
        videoWasPausedByVisitor &&
        heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA
      ) {
        showVideo();
        return;
      }

      void heroVideo.play().catch(() => {
        hideVideo();
      });
    };

    heroMotionControl?.addEventListener("click", () => {
      if (heroVideo.paused) {
        videoWasPausedByVisitor = false;
        void heroVideo.play().catch(hideVideo);
        return;
      }

      videoWasPausedByVisitor = true;
      heroVideo.pause();
    });
    heroVideo.addEventListener("canplay", showVideo);
    heroVideo.addEventListener("play", updateMotionControl);
    heroVideo.addEventListener("pause", updateMotionControl);
    heroVideo.addEventListener("error", hideVideo);
    prefersReducedMotion.addEventListener("change", syncVideoPlayback);
    syncVideoPlayback();
  }

  if (!heroActions || prefersReducedMotion.matches) {
    signalHeroRevealComplete();
  } else {
    const sectionRevealDelay = Number(
      heroActions.dataset.homepageSectionRevealDelay,
    );
    const scheduleSectionReveal = () => {
      if (!Number.isFinite(sectionRevealDelay)) return;

      window.setTimeout(signalHeroRevealComplete, sectionRevealDelay);
    };

    heroActions.addEventListener("animationstart", scheduleSectionReveal, {
      once: true,
    });
    heroActions.addEventListener("animationend", signalHeroRevealComplete, {
      once: true,
    });
    window.setTimeout(signalHeroRevealComplete, 2200);
  }

  if (parallaxHero && parallaxBackground && !prefersReducedMotion.matches) {
    let animationFrame = 0;
    let heroIsVisible = true;

    const renderScrollParallax = () => {
      animationFrame = 0;
      if (!heroIsVisible) return;

      const bounds = parallaxHero.getBoundingClientRect();
      const scrolledDistance = Math.min(
        Math.max(-bounds.top, 0),
        bounds.height,
      );
      const verticalOffset = Math.min(scrolledDistance * 0.05, 22);

      parallaxBackground.style.setProperty(
        "--hero-parallax-y",
        `${verticalOffset}px`,
      );
    };

    const requestScrollParallax = () => {
      if (animationFrame || !heroIsVisible) return;
      animationFrame = requestAnimationFrame(renderScrollParallax);
    };

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      heroIsVisible = entry?.isIntersecting ?? false;
      if (heroIsVisible) requestScrollParallax();
    });

    visibilityObserver.observe(parallaxHero);
    window.addEventListener("scroll", requestScrollParallax, { passive: true });
    requestScrollParallax();
  }
</script>
