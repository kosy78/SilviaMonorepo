---
import { Button } from "../ui/button";
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../ui/card";

const defaultMeasurementId = "G-D490J31F6H";
const measurementId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || defaultMeasurementId;
const hasMeasurementId = Boolean(measurementId);
---

{
  hasMeasurementId && (
    <>
      <Card
        data-analytics-consent
        hidden
        className="ui-panel-enter fixed right-4 bottom-4 left-4 z-50 max-h-[calc(100dvh-2rem)] max-w-md gap-0 overflow-y-auto overscroll-contain py-0 shadow-[0_1.25rem_3.75rem_color-mix(in_oklch,var(--foreground)_16%,transparent)] sm:right-auto sm:w-[calc(100%-2rem)] md:bottom-6 md:left-6"
        aria-labelledby="analytics-consent-title"
        aria-describedby="analytics-consent-description"
        role="dialog"
        tabIndex={-1}
      >
        <CardHeader className="px-4 py-3.5">
          <CardTitle id="analytics-consent-title" className="text-lg">
            Confidențialitate
          </CardTitle>
          <CardDescription
            id="analytics-consent-description"
            className="mt-0.5 text-sm leading-6 text-pretty text-foreground!"
          >
            Cu acordul dumneavoastră, folosim Google Analytics pentru a înțelege
            cum este utilizat site-ul.
          </CardDescription>
        </CardHeader>

        <CardFooter className="flex-row items-center justify-start gap-2 px-4 py-2.5">
          <Button
            type="button"
            data-analytics-accept
            size="sm"
            className="min-h-11"
          >
            Acceptați
          </Button>
          <Button
            type="button"
            data-analytics-reject
            variant="outline"
            size="sm"
            className="min-h-11"
          >
            Refuzați
          </Button>
        </CardFooter>
      </Card>

      <script
        is:inline
        defer
        src="/analytics-consent.js"
        data-ga-measurement-id={measurementId}
      />
    </>
  )
}
