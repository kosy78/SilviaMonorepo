---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: readonly FaqItem[];
}

const { items }: Props = Astro.props;
---

<div class="border-line divide-line divide-y border-y">
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-6 text-lg font-medium">
          <span>{item.question}</span>
          <span
            aria-hidden="true"
            class="mt-1 text-2xl leading-none transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="text-muted max-w-3xl pb-7 pr-12 text-lg leading-8">
          {item.answer}
        </p>
      </details>
    ))
  }
</div>
