---
import { cn } from "../../lib/utils";
import Container from "../ui/Container.astro";
import ActionLink from "../ui/ActionLink.astro";
import { buttonVariants } from "../ui/button";
import { Separator } from "../ui/separator";

interface Props {
  flush?: boolean;
}

const { flush = false } = Astro.props;
const year = new Date().getFullYear();
const preliminaryMeetingEmailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20%C3%AEnt%C3%A2lnire%20preliminar%C4%83";
const instagramHref =
  "https://www.instagram.com/despre.sine?igsi=cWJwdWN1Z3dkNDcw";
const legalLinks = [
  {
    href: "/politica-de-confidentialitate/",
    label: "Politica de confidențialitate",
  },
  { href: "/politica-cookies/", label: "Politica de cookies" },
] as const;
const explorationLinks = [
  { href: "/", label: "Acasă" },
  {
    href: "/psihoterapie-si-consiliere/",
    label: "Psihoterapia psihanalitică",
  },
  { href: "/competente/", label: "Competențe" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
  { href: "/reflectie-ghidata/", label: "O primă explorare" },
] as const;
const footerLinks = [...explorationLinks, ...legalLinks] as const;
---

<footer
  class:list={["site-footer", flush && "site-footer--flush"]}
  data-site-footer
>
  <Container>
    <div class="site-footer__inner">
      <div class="site-footer__masthead">
        <div class="site-footer__brand">
          <div class="site-footer__mark" aria-hidden="true">
            <img
              src="/images/despresine-logo.png"
              alt=""
              width="52"
              height="52"
            />
          </div>
          <div>
            <p class="site-footer__name">DespreSine</p>
            <p class="site-footer__subtitle">Psihoterapeut Silvia Dinu</p>
          </div>
        </div>
        <div class="site-footer__masthead-actions">
          <a
            class={cn(
              buttonVariants({ variant: "secondary", size: "icon" }),
              "site-footer__instagram-link",
            )}
            href={instagramHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="DespreSine pe Instagram (se deschide într-o filă nouă)"
            data-footer-instagram
            data-slot="button"
            data-variant="secondary"
            data-size="icon"
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="4.75"
              ></rect>
              <circle cx="12" cy="12" r="4.15"></circle>
              <circle
                cx="17.45"
                cy="6.65"
                r="1"
                fill="currentColor"
                stroke="none"></circle>
            </svg>
          </a>
          <div class="site-footer__masthead-action">
            <ActionLink
              href={preliminaryMeetingEmailHref}
              variant="secondary"
              icon="mail"
            >
              Solicitați o întâlnire preliminară
            </ActionLink>
          </div>
        </div>
      </div>

      <Separator className="site-footer__separator" />

      <nav class="site-footer__navigation" aria-label="Navigare în subsol">
        <ul class="site-footer__links">
          {
            footerLinks.map((item) => (
              <li>
                <a
                  class={cn(
                    buttonVariants({ variant: "link", size: "inline" }),
                    "justify-start",
                  )}
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              data-analytics-settings
              hidden
              class={cn(
                buttonVariants({ variant: "link", size: "inline" }),
                "justify-start",
              )}
            >
              Setări analytics
            </button>
          </li>
        </ul>
      </nav>

      <div class="site-footer__bottom">
        <p>© {year} Despre Sine - Psihoterapeut Silvia Dinu</p>
      </div>
    </div>
  </Container>

  <div class="site-footer__sofa" data-footer-sofa aria-hidden="true">
    <img
      src="/images/footer-sofa.webp"
      alt=""
      width="774"
      height="1161"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  .site-footer {
    --site-footer-quiet: color-mix(
      in oklch,
      var(--foreground) 28%,
      var(--muted-foreground)
    );
    --site-footer-line: color-mix(
      in oklch,
      var(--border) 78%,
      var(--foreground) 6%
    );

    margin-top: var(--section-space);
    border-top: 1px solid var(--site-footer-line);
    background: var(--muted);
    color: var(--foreground);
    padding-block: clamp(2.5rem, 4vw, 3.5rem) 0;
  }

  .site-footer--flush {
    margin-top: 0;
  }

  .site-footer__inner {
    container-name: site-footer;
    container-type: inline-size;
  }

  .site-footer__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-footer__mark {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: 0 0 0 1px
      color-mix(in oklch, var(--foreground) 10%, transparent);
  }

  .site-footer__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .site-footer__subtitle,
  .site-footer__bottom {
    color: var(--site-footer-quiet);
  }

  .site-footer__subtitle {
    font-size: 0.875rem;
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .site-footer__masthead-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.75rem;
  }

  .site-footer__masthead-action :global([data-slot="button"]:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  :global(.site-footer__separator) {
    background: var(--site-footer-line);
    margin-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.125rem;
    margin: 0;
    padding: 0;
  }

  .site-footer__links li {
    list-style: none;
  }

  .site-footer__links :global(a),
  .site-footer__links :global(button) {
    min-width: 2.75rem;
    font-size: 0.9375rem;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(3.5rem, 6vw, 4rem);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }

  .site-footer__sofa {
    position: relative;
    height: clamp(14rem, 22vw, 22rem);
    margin-top: clamp(1.5rem, 3vw, 3rem);
    overflow: hidden;
  }

  .site-footer__sofa img {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(64rem, 74vw);
    height: 100%;
    object-fit: cover;
    object-position: center 68%;
    -webkit-mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 14%) 12%,
        #000 38%
      ),
      linear-gradient(to right, transparent 0%, rgb(0 0 0 / 12%) 10%, #000 34%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(0 0 0 / 14%) 12%,
        #000 38%
      ),
      linear-gradient(to right, transparent 0%, rgb(0 0 0 / 12%) 10%, #000 34%);
    mask-composite: intersect;
  }

  @container site-footer (max-width: 58rem) {
    .site-footer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container site-footer (max-width: 40rem) {
    .site-footer__masthead {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__masthead-actions {
      width: 100%;
    }

    .site-footer__masthead-action {
      flex: 1;
      min-width: 0;
    }

    .site-footer__masthead-action :global(a) {
      width: 100%;
    }

    .site-footer__links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .site-footer__sofa {
      height: clamp(14rem, 72vw, 19rem);
      margin-top: 2rem;
    }

    .site-footer__sofa img {
      width: 100%;
      object-position: center 64%;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-footer__masthead-action :global([data-slot="button"]) {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
