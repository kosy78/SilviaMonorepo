---
import { IconArrowUpRight, IconMail } from "@tabler/icons-react";

import { cn } from "../../lib/utils";
import Container from "../ui/Container.astro";
import { buttonVariants } from "../ui/button";
import { Separator } from "../ui/separator";

const year = new Date().getFullYear();
const legalLinks = [
  {
    href: "/politica-de-confidentialitate/",
    label: "Politica de confidențialitate",
  },
  { href: "/politica-cookies/", label: "Politica de cookies" },
] as const;
---

<footer class="site-footer" data-site-footer>
  <Container>
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <div class="site-footer__mark" aria-hidden="true">
          <img
            src="/images/despresine-logo.png"
            alt=""
            width="52"
            height="52"
          />
        </div>
        <div>
          <p class="site-footer__name">DespreSine</p>
          <p class="site-footer__subtitle">Silvia Dinu</p>
        </div>
      </div>
      <a
        class={buttonVariants({ variant: "secondary", size: "lg" })}
        href="mailto:silvia.drn@gmail.com"
      >
        <IconMail data-icon="inline-start" aria-hidden="true" />
        Scrieți un prim mesaj
      </a>
    </div>

    <Separator className="site-footer__separator" />

    <div class="site-footer__grid">
      <div>
        <p class="site-footer__label">Practica profesională</p>
        <p class="site-footer__copy">
          Psiholog cu drept de liberă practică<br />
          Psihoterapeut psihanalitic sub supervizare
        </p>
      </div>

      <div>
        <p class="site-footer__label">Loc și format</p>
        <p class="site-footer__copy">
          București, zona Piața Victoriei / Banu Manta<br />
          Ședințe în cabinet și online
        </p>
      </div>

      <nav aria-label="Informații legale">
        <p class="site-footer__label">Informații legale</p>
        <ul class="site-footer__links">
          {
            legalLinks.map((item) => (
              <li>
                <a
                  class={cn(
                    buttonVariants({ variant: "link", size: "inline" }),
                    "text-primary-foreground!",
                  )}
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              data-analytics-settings
              hidden
              class={cn(
                buttonVariants({ variant: "link", size: "inline" }),
                "text-primary-foreground!",
              )}
            >
              Setări analytics
            </button>
          </li>
        </ul>
      </nav>

      <div>
        <p class="site-footer__label">Soluționarea litigiilor</p>
        <a
          class="site-footer__anpc ui-control"
          href="https://reclamatiisal.anpc.ro/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Soluționarea Alternativă a Litigiilor prin ANPC"
        >
          <img
            src="/trust/anpc-sal-online.png"
            alt="ANPC - Soluționarea alternativă a litigiilor"
            width="250"
            height="49"
            loading="lazy"
            decoding="async"
          />
          <IconArrowUpRight aria-hidden="true" />
        </a>
      </div>
    </div>

    <Separator className="site-footer__separator" />
    <p class="site-footer__copyright">© {year} Silvia Dinu</p>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    background: var(--primary);
    color: var(--primary-foreground);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }

  .site-footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-footer__mark {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .site-footer__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
  }

  .site-footer__subtitle,
  .site-footer__label,
  .site-footer__copyright {
    color: color-mix(in oklch, var(--primary-foreground) 68%, var(--primary));
    font-size: 0.875rem;
  }

  .site-footer__subtitle {
    margin-top: 0.35rem;
  }

  .site-footer__separator {
    margin-block: 2.5rem;
    background: color-mix(
      in oklch,
      var(--primary-foreground) 18%,
      var(--primary)
    );
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .site-footer__copy {
    margin-top: 1rem;
    line-height: 1.8;
  }

  .site-footer__links {
    display: grid;
    gap: 0.125rem;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .site-footer__links li {
    list-style: none;
  }

  .site-footer__anpc {
    position: relative;
    display: inline-flex;
    max-width: 15.625rem;
    margin-top: 1rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--background);
  }

  .site-footer__anpc :global(svg) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 1rem;
    height: 1rem;
    color: var(--foreground);
  }

  @media (max-width: 62rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .site-footer__top {
      align-items: stretch;
      flex-direction: column;
    }

    .site-footer__top :global(a) {
      width: 100%;
    }

    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
