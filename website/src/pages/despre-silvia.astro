---
import PageIntro from "../components/sections/PageIntro.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials require Silvia's review before publication.
---

<BaseLayout
  title="Despre Silvia"
  description="Informații despre Silvia Dinu și orientarea psihanalitică a practicii."
>
  <PageIntro
    title="Despre Silvia"
    description="O prezentare clară și reținută a cadrului profesional și a modului de lucru."
  />

  <section class="py-(--section-space)">
    <Container class="grid gap-14 md:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="text-muted leading-7">
          Psiholog cu drept de liberă practică<br />
          Psihoterapeut psihanalitic sub supervizare
        </p>
        <dl class="border-line mt-8 border-t">
          <div class="border-line border-b py-5">
            <dt class="text-muted text-sm">Experiență</dt>
            <dd class="mt-2">Peste 10 ani</dd>
          </div>
          <div class="border-line border-b py-5">
            <dt class="text-muted text-sm">Formare</dt>
            <dd class="mt-2">ACPP-B</dd>
          </div>
          <div class="border-line border-b py-5">
            <dt class="text-muted text-sm">Orientare</dt>
            <dd class="mt-2">Psihanalitică / psihodinamică</dd>
          </div>
        </dl>
      </div>

      <div class="prose-editorial">
        <p>
          Silvia Dinu lucrează cu adulți, tineri adulți și adolescenți de la 16
          ani, în cabinet și online.
        </p>
        <p>
          Orientarea psihanalitică acordă atenție felului în care experiențele,
          relațiile și conflictele interioare se pot repeta sau pot deveni
          vizibile în prezent.
        </p>
        <p>
          Modul de lucru este atent la ritmul fiecărei persoane și la
          construirea unui cadru în care ceea ce este dificil de spus sau de
          înțeles poate fi explorat în timp.
        </p>
        <p>
          <ActionLink href="/contact/">
            Scrieți pentru o primă discuție
          </ActionLink>
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
