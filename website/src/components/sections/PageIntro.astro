---
import Container from "../ui/Container.astro";

interface Props {
  title: string;
  subtitle?: string;
  description?: string | string[];
  layout?: "stacked" | "split";
  showAccent?: boolean;
}

const {
  title,
  subtitle,
  description,
  layout = "stacked",
  showAccent = true,
} = Astro.props;
const paragraphs = Array.isArray(description) ? description : [description];
---

<section
  class:list={[
    "page-intro page-enter",
    { "page-intro--split": layout === "split" },
  ]}
>
  <Container>
    <div class="page-intro__inner">
      {showAccent && <span class="page-intro__accent" aria-hidden="true" />}
      <div class="page-intro__content">
        <div class="page-intro__heading">
          <h1 class="display-page">
            {title}
          </h1>
          {
            subtitle && (
              <p class="page-intro__subtitle font-display mt-8 max-w-3xl text-3xl leading-tight tracking-[-0.025em] md:text-4xl">
                {subtitle}
              </p>
            )
          }
        </div>
        {
          description && (
            <div class="page-intro__description text-foreground mt-8 grid max-w-4xl gap-5 text-lg leading-8">
              {paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <slot name="description-after" />
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .page-intro {
    border-bottom: 1px solid var(--border);
    background: var(--muted);
    padding-block: var(--intro-space);
  }

  .page-intro__inner {
    position: relative;
  }

  .page-intro__accent {
    display: block;
    width: 3rem;
    height: 0.3rem;
    margin-bottom: 2rem;
    border-radius: 999px;
    background: var(--chart-3);
  }

  .page-intro--split {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .page-intro--split .page-intro__accent {
    margin-bottom: 1.5rem;
  }

  .page-intro--split .page-intro__subtitle {
    margin-top: 1.5rem;
  }

  .page-intro--split .page-intro__description {
    max-width: var(--reading-width);
    margin-top: clamp(2.5rem, 6vw, 3rem);
  }

  @media (min-width: 64rem) {
    .page-intro--split .page-intro__content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
      gap: clamp(3rem, 6vw, 5rem);
    }

    .page-intro--split .page-intro__description {
      margin-top: 0;
    }
  }
</style>
