---
import { IconArrowRight } from "@tabler/icons-react";

import PsiGraphic from "../ui/PsiGraphic.astro";
import Container from "../ui/Container.astro";
import { Card } from "../ui/card";
---

<section
  class="homepage-orientation"
  aria-labelledby="homepage-orientation-title"
>
  <Container>
    <a
      class="homepage-orientation__link"
      data-psi-trigger
      href="/psihoterapie-si-consiliere/"
      aria-labelledby="homepage-orientation-title"
    >
      <Card className="homepage-orientation__card">
        <div class="homepage-orientation__image" aria-hidden="true">
          <video
            class="homepage-orientation__video"
            poster="/videos/psychotherapy-clouds-poster.jpg"
            preload="none"
            muted
            loop
            playsinline
            width="528"
            height="752"
            tabindex="-1"
          >
            <source src="/videos/psychotherapy-clouds.mp4" type="video/mp4" />
          </video>
        </div>

        <div class="homepage-orientation__layout">
          <header class="homepage-orientation__intro">
            <div>
              <PsiGraphic class="homepage-orientation__psi" size={53.55} />
              <h2 id="homepage-orientation-title" class="heading-long">
                Despre Psihoterapia Psihanalitică
              </h2>
            </div>

            <div class="homepage-orientation__summary">
              <p class="homepage-orientation__lead">
                Psihoterapia psihanalitică pornește din tradiția psihanalizei,
                dar este practicată astăzi într-o formă adaptată vieții și
                nevoilor <span class="homepage-orientation__lead-ending"
                  >contemporane.<IconArrowRight
                    data-icon="inline-end"
                    aria-hidden="true"
                  /></span
                >
              </p>
            </div>
          </header>
        </div>
      </Card>
    </a>
  </Container>
</section>

<style>
  .homepage-orientation {
    /* The outer card clips the edge-to-edge media, like the Silvia card. */
    --orientation-radius: var(--radius-xl);
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-orientation__link {
    display: block;
    width: 100%;
    border-radius: var(--orientation-radius);
    color: inherit;
    text-decoration: none;
  }

  .homepage-orientation__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-orientation__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 30.37%);
    align-items: center;
    width: 100%;
    gap: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--orientation-radius);
    background: #f4ede3;
    padding: 0;
    color: #000;
    box-shadow: none;
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-orientation__image {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: stretch;
    overflow: hidden;
    aspect-ratio: 263 / 340;
    pointer-events: none;
  }

  .homepage-orientation__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .homepage-orientation__layout {
    position: relative;
    display: flex;
    min-width: 0;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    align-items: center;
    padding: 2rem 2.5rem 2rem 3.25rem;
  }

  .homepage-orientation__intro {
    display: grid;
    gap: 1.5rem;
  }

  .homepage-orientation__intro :global(.homepage-orientation__psi) {
    margin-block-end: calc(var(--spacing) * 3);
  }

  .homepage-orientation__intro .heading-long {
    max-width: 16ch;
    color: #000;
    text-wrap: balance;
  }

  .homepage-orientation__summary {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }

  .homepage-orientation__lead {
    max-width: 32rem;
    color: #000;
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .homepage-orientation__lead-ending {
    white-space: nowrap;
  }

  .homepage-orientation__lead :global([data-icon="inline-end"]) {
    display: inline-block;
    width: 1.125rem;
    height: 1.125rem;
    margin-inline-start: 0.25rem;
    vertical-align: -0.2em;
    transition: transform var(--duration-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-orientation__link:hover .homepage-orientation__card {
      box-shadow: 0 0 0 1px var(--border);
      transform: translateY(-2px);
    }

    .homepage-orientation__link:hover
      .homepage-orientation__lead
      :global([data-icon="inline-end"]) {
      transform: translateX(0.2rem);
    }
  }

  @media (max-width: 56rem) {
    .homepage-orientation__card {
      grid-template-columns: minmax(0, 1fr);
    }

    .homepage-orientation__image {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }

    .homepage-orientation__layout {
      grid-column: 1;
      grid-row: 2;
      padding: 2rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-orientation__card,
    .homepage-orientation__lead :global([data-icon="inline-end"]) {
      transition: none;
    }

    .homepage-orientation__link:hover .homepage-orientation__card,
    .homepage-orientation__link:hover
      .homepage-orientation__lead
      :global([data-icon="inline-end"]) {
      transform: none;
    }
  }
</style>

<script>
  const orientationLink = document.querySelector<HTMLAnchorElement>(
    ".homepage-orientation__link",
  );
  const orientationVideo = orientationLink?.querySelector<HTMLVideoElement>(
    ".homepage-orientation__video",
  );

  if (orientationLink && orientationVideo) {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const hoverPointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    );
    const resetVideo = () => {
      orientationVideo.pause();
      if (orientationVideo.currentTime !== 0) orientationVideo.currentTime = 0;
    };
    const syncVideo = () => {
      const active =
        (hoverPointer.matches && orientationLink.matches(":hover")) ||
        orientationLink.matches(":focus-visible");

      if (!active || reducedMotion.matches || document.hidden) {
        resetVideo();
        return;
      }

      // Keep the poster if playback is unavailable; rapid exits may abort play().
      void orientationVideo.play().catch(() => {});
    };

    orientationLink.addEventListener("pointerenter", syncVideo);
    orientationLink.addEventListener("pointerleave", syncVideo);
    orientationLink.addEventListener("focus", syncVideo);
    orientationLink.addEventListener("blur", syncVideo);
    reducedMotion.addEventListener("change", syncVideo);
    hoverPointer.addEventListener("change", syncVideo);
    document.addEventListener("visibilitychange", syncVideo);
    window.addEventListener("pagehide", resetVideo);
    syncVideo();
  }
</script>
