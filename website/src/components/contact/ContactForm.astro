---
import { Alert, AlertDescription } from "../ui/alert";
import { Button } from "../ui/button";
import { Choice } from "../ui/choice";
import {
  Field,
  FieldDescription,
  FieldGroup,
  FieldLabel,
  FieldLegend,
  FieldSet,
} from "../ui/field";
import { Input } from "../ui/input";
import { Textarea } from "../ui/textarea";

const emailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire";
---

<div class="border-line border-t pt-7">
  <form action="/api/contact" method="post" class="max-w-2xl" data-contact-form>
    <FieldGroup>
      <Field>
        <FieldLabel htmlFor="contact-name">
          Nume sau prenume
          <span class="font-normal text-muted-foreground">(opțional)</span>
        </FieldLabel>
        <Input
          id="contact-name"
          name="name"
          type="text"
          autoComplete="name"
          maxLength={100}
        />
      </Field>

      <Field>
        <FieldLabel htmlFor="contact-email">Adresă de email</FieldLabel>
        <Input
          id="contact-email"
          name="email"
          type="email"
          autoComplete="email"
          inputMode="email"
          maxLength={254}
          aria-describedby="contact-email-hint"
          required
        />
        <FieldDescription id="contact-email-hint">
          Adresa este necesară pentru a vă putea răspunde.
        </FieldDescription>
      </Field>

      <FieldSet>
        <FieldLegend variant="label">
          Ce format preferați?
          <span class="font-normal text-muted-foreground"> (opțional)</span>
        </FieldLegend>
        <FieldGroup className="grid gap-3 sm:grid-cols-3">
          {
            [
              ["cabinet", "În cabinet"],
              ["online", "Online"],
              ["nesigur", "Nu am încă o preferință"],
            ].map(([value, label]) => (
              <Choice className="items-center gap-3 px-4 py-3">
                <input
                  class="size-5 shrink-0 accent-primary focus-visible:shadow-none"
                  type="radio"
                  name="meeting_format"
                  value={value}
                />
                <span>{label}</span>
              </Choice>
            ))
          }
        </FieldGroup>
      </FieldSet>

      <Field>
        <FieldLabel htmlFor="contact-availability">
          Intervale potrivite sau alte detalii practice
          <span class="font-normal text-muted-foreground">(opțional)</span>
        </FieldLabel>
        <Textarea
          id="contact-availability"
          name="availability"
          rows={4}
          maxLength={400}
          aria-describedby="contact-availability-hint"
          placeholder="De exemplu: zilele sau intervalele în care puteți participa"
        />
        <FieldDescription id="contact-availability-hint">
          Păstrați acest câmp pentru detalii practice. Nu includeți informații
          medicale, istoricul personal sau alte date sensibile.
        </FieldDescription>
      </Field>

      <div class="hp-field" aria-hidden="true">
        <label for="contact-company">Companie</label>
        <input
          id="contact-company"
          name="company"
          type="text"
          autocomplete="off"
          tabindex="-1"
        />
      </div>

      <Alert
        variant="default"
        className="hidden"
        role="status"
        aria-live="polite"
        tabIndex={-1}
        data-contact-status
      >
        <AlertDescription />
      </Alert>

      <Field>
        <Button type="submit" data-contact-submit> Trimiteți mesajul </Button>
        <FieldDescription className="max-w-xl leading-6">
          Formularul transmite mesajul către adresa profesională de email.
          Website-ul nu îl păstrează într-o bază de date. {" "}
          <a href="/politica-de-confidentialitate/">
            Aflați cum sunt prelucrate datele.
          </a>
        </FieldDescription>
      </Field>

      <noscript>
        <p class="border-line border-y py-4 leading-7">
          Pentru trimiterea formularului este necesar JavaScript. Puteți scrie
          direct la {" "}
          <a class="underline" href={emailHref}>silvia.drn@gmail.com</a>.
        </p>
      </noscript>
    </FieldGroup>
  </form>
</div>

<style>
  :global([data-contact-status][data-state="error"]) {
    border-color: var(--color-destructive);
    color: var(--color-destructive);
  }
</style>

<script>
  const contactForm = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );
  const contactStatus = document.querySelector<HTMLElement>(
    "[data-contact-status]",
  );
  const contactSubmit = document.querySelector<HTMLButtonElement>(
    "[data-contact-submit]",
  );
  const showContactStatus = (message: string, state: "success" | "error") => {
    if (!contactStatus) return;

    contactStatus.textContent = message;
    contactStatus.dataset.state = state;
    contactStatus.classList.remove("hidden");
    contactStatus.focus();
  };

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!contactForm.reportValidity()) return;

    contactSubmit?.setAttribute("disabled", "");
    if (contactSubmit) contactSubmit.textContent = "Se trimite…";
    contactStatus?.classList.add("hidden");

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(contactForm),
      });

      if (!response.ok) {
        throw new Error(`Contact form failed with ${response.status}`);
      }

      contactForm.reset();
      showContactStatus(
        "Mesajul a fost trimis către adresa profesională a Silviei Dinu. Adresa de email indicată va fi folosită pentru răspuns.",
        "success",
      );
    } catch {
      showContactStatus(
        "Mesajul nu a fost trimis. Încercați din nou sau scrieți direct la silvia.drn@gmail.com.",
        "error",
      );
    } finally {
      contactSubmit?.removeAttribute("disabled");
      if (contactSubmit) contactSubmit.textContent = "Trimiteți mesajul";
    }
  });
</script>
