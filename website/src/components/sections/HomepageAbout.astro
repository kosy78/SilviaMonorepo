---
import { Picture } from "astro:assets";

import silviaPortrait from "../../assets/competencies/silvia-dinu-portrait-2026-10-08.jpeg";
import Container from "../ui/Container.astro";

const aboutHref = "/competente/";
---

<section class="homepage-about" id="cum-lucrez">
  <Container>
    <a
      class="homepage-about__link"
      href={aboutHref}
      aria-labelledby="homepage-about-title"
      data-homepage-about
    >
      <figure class="homepage-about__card">
        <figcaption class="homepage-about__caption">
          <div class="homepage-about__identity">
            <h2 class="homepage-about__title" id="homepage-about-title">
              Silvia Dinu
            </h2>
            <p class="homepage-about__credential">
              Psihoterapeut de orientare psihanalitică
            </p>
          </div>
          <div class="homepage-about__portrait">
            <Picture
              src={silviaPortrait}
              formats={["avif", "webp"]}
              widths={[144, 176, 264]}
              sizes="(max-width: 43.75rem) 4.5rem, 5.5rem"
              quality={84}
              alt="Silvia Dinu"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figcaption>

        <blockquote class="homepage-about__quote">
          Am avut norocul ca întâlnirea mea cu psihanaliza să se întâmple la
          scurt timp după terminarea facultății de Psihologie. Am pornit pe
          acest drum cu multă curiozitate, dar și cu dorința de a înțelege, prin
          propria experiență, ce face demersul psihanalitic atât de valoros.
        </blockquote>
      </figure>
    </a>
  </Container>
</section>

<style>
  .homepage-about {
    padding-block: var(--section-space);
  }

  .homepage-about__link {
    display: block;
    width: 100%;
    max-width: 55rem;
    margin-inline: auto;
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .homepage-about__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-about__card {
    display: grid;
    gap: 1.75rem;
    overflow: hidden;
    margin: 0;
    padding: 2.25rem 2.5rem;
    border-radius: inherit;
    background: var(--muted);
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-about__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .homepage-about__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .homepage-about__identity {
    display: grid;
    gap: 0.625rem;
  }

  .homepage-about__title {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .homepage-about__credential {
    max-width: 34ch;
    color: color-mix(in oklch, var(--foreground) 76%, var(--background));
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .homepage-about__portrait {
    position: relative;
    width: 5.5rem;
    flex-shrink: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    border-radius: 0.625rem;
  }

  .homepage-about__portrait :global(picture) {
    position: absolute;
    inset: 0;
  }

  .homepage-about__portrait :global(picture),
  .homepage-about__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-about__portrait :global(img) {
    object-fit: cover;
    position: absolute;
    bottom: 0;
    height: 130%;
    object-position: center bottom;
    transition: transform var(--duration-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-about__link:hover .homepage-about__card {
      box-shadow: 0 0 0 1px var(--border);
      transform: translateY(-2px);
    }

    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: scale(1.015);
    }
  }

  @media (max-width: 43.75rem) {
    .homepage-about__card {
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .homepage-about__quote {
      font-size: 1.125rem;
      letter-spacing: 0;
    }

    .homepage-about__caption {
      gap: 1rem;
    }

    .homepage-about__identity {
      gap: 0.5rem;
    }

    .homepage-about__title {
      font-size: 1.75rem;
    }

    .homepage-about__credential {
      font-size: 0.875rem;
    }

    .homepage-about__portrait {
      width: 4.5rem;
      border-radius: 0.5rem;
    }
  }

  @media (max-width: 22.4375rem) {
    .homepage-about__card {
      padding: 1.25rem;
    }

    .homepage-about__caption {
      gap: 0.75rem;
    }

    .homepage-about__title {
      font-size: 1.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-about__card,
    .homepage-about__portrait :global(img) {
      transition: none;
    }

    .homepage-about__link:hover .homepage-about__card,
    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: none;
    }
  }
</style>
