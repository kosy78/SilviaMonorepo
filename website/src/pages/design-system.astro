---
// Approved direction: this is a living, internal reference. It reads canonical
// CSS sources and the UI directory at build time instead of duplicating them.
import { IconArrowRight, IconInfoCircle, IconMail } from "@tabler/icons-react";

import InteractiveShowcase from "../components/design-system/InteractiveShowcase";
import ActionLink from "../components/ui/ActionLink.astro";
import ExplorationPromoCard from "../components/ui/ExplorationPromoCard.astro";
import PsiGraphic from "../components/ui/PsiGraphic.astro";
import { Alert, AlertDescription, AlertTitle } from "../components/ui/alert";
import { Button } from "../components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Choice } from "../components/ui/choice";
import {
  Disclosure,
  DisclosureContent,
  DisclosureIcon,
  DisclosureTrigger,
} from "../components/ui/disclosure";
import { LineRevealText } from "../components/ui/line-reveal-text";
import { Input } from "../components/ui/input";
import { Label } from "../components/ui/label";
import { Progress } from "../components/ui/progress";
import { Separator } from "../components/ui/separator";
import { Tag } from "../components/ui/tag";
import { Textarea } from "../components/ui/textarea";
import DesignSystemLayout from "../layouts/DesignSystemLayout.astro";
import {
  extractCssRecipe,
  extractDesignTokens,
  getComponentExports,
} from "../lib/design-system";
import globalCss from "../styles/global.css?raw";
import tokensCss from "../styles/tokens.css?raw";

const themeTokens = extractDesignTokens(
  tokensCss,
  "@theme",
  "tokens.css:@theme",
);
const foundationTokens = extractDesignTokens(
  tokensCss,
  ":root",
  "tokens.css::root",
);
const lightTokens = extractDesignTokens(globalCss, ":root", "global.css::root");
const darkTokens = extractDesignTokens(globalCss, ".dark", "global.css:.dark");

const colorAliasTokens = themeTokens.filter((token) =>
  token.name.startsWith("--color-"),
);
const typographyTokens = themeTokens.filter((token) =>
  token.name.startsWith("--font-"),
);
const breakpointTokens = themeTokens.filter((token) =>
  token.name.startsWith("--breakpoint-"),
);
const motionTokens = foundationTokens.filter((token) =>
  /--(?:duration|delay|ease)-/.test(token.name),
);
const layoutTokens = [
  ...breakpointTokens,
  ...foundationTokens.filter(
    (token) => !motionTokens.some((motion) => motion.name === token.name),
  ),
  ...lightTokens.filter((token) => token.name === "--radius"),
];
const lightColorTokens = lightTokens.filter(
  (token) => token.name !== "--radius",
);
const totalTokens =
  themeTokens.length +
  foundationTokens.length +
  lightTokens.length +
  darkTokens.length;

const typographyRecipes = [
  extractCssRecipe(globalCss, ".display-hero"),
  extractCssRecipe(globalCss, ".display-page"),
  extractCssRecipe(globalCss, ".section-title"),
  extractCssRecipe(globalCss, ".heading-long"),
  extractCssRecipe(globalCss, ".text-body"),
  extractCssRecipe(globalCss, ".prose-editorial"),
];

const componentSources = import.meta.glob("../components/ui/*.{astro,tsx}", {
  eager: true,
  query: "?raw",
  import: "default",
}) as Record<string, string>;
const previewedComponents = new Set([
  "accordion.tsx",
  "alert.tsx",
  "button.tsx",
  "card.tsx",
  "choice.tsx",
  "disclosure.tsx",
  "input.tsx",
  "label.tsx",
  "line-reveal-text.tsx",
  "progress.tsx",
  "radio-group.tsx",
  "separator.tsx",
  "tag.tsx",
  "textarea.tsx",
  "ActionLink.astro",
  "ExplorationPromoCard.astro",
  "PsiGraphic.astro",
]);
const componentInventory = Object.entries(componentSources)
  .map(([path, source]) => {
    const fileName = path.split("/").at(-1) ?? path;
    const fallbackName = fileName.replace(/\.(astro|tsx)$/i, "");

    return {
      fileName,
      framework: fileName.endsWith(".astro") ? "Astro" : "React",
      exports: getComponentExports(source, fallbackName),
      previewed: previewedComponents.has(fileName),
    };
  })
  .sort((a, b) => a.fileName.localeCompare(b.fileName));

const buttonVariants = [
  ["default", "Primar"],
  ["outline", "Contur"],
  ["secondary", "Secundar"],
  ["ghost", "Discret"],
  ["destructive", "Critică"],
  ["link", "Link"],
] as const;

const navigation = [
  ["principii", "Principii"],
  ["culori", "Culori"],
  ["tipografie", "Tipografie"],
  ["layout", "Layout, spațiere și colțuri"],
  ["miscare", "Mișcare"],
  ["componente", "Componente"],
  ["inventar", "Inventar"],
  ["mentenanta", "Mentenanță"],
] as const;
---

<DesignSystemLayout
  title="Sistem de design | DespreSine"
  description="Referință internă pentru tokenurile, variabilele și componentele interfeței DespreSine."
>
  <header class="ds-hero">
    <div class="ds-container">
      <div class="ds-eyebrow">
        <Tag variant="status">Referință internă</Tag>
        <code>/design-system/</code>
      </div>
      <h1 class="display-page">Sistemul de design DespreSine</h1>
      <p class="ds-lede">
        O vedere actualizată asupra limbajului vizual folosit în site: tokenuri,
        variabile, tipografie, mișcare și componente reale. Valorile sunt citite
        direct din sursele canonice la fiecare build.
      </p>

      <dl class="ds-stats" aria-label="Rezumatul sistemului de design">
        <div>
          <dt>Tokenuri</dt>
          <dd>{totalTokens}</dd>
        </div>
        <div>
          <dt>Componente UI</dt>
          <dd>{componentInventory.length}</dd>
        </div>
        <div>
          <dt>Surse canonice</dt>
          <dd>2</dd>
        </div>
        <div>
          <dt>Actualizare</dt>
          <dd>La build</dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="ds-container ds-layout">
    <aside class="ds-sidebar">
      <nav aria-label="Cuprinsul sistemului de design">
        <p>Cuprins</p>
        <ol>
          {
            navigation.map(([href, label], index) => (
              <li>
                <a href={`#${href}`}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>

    <article class="ds-content">
      <section
        id="principii"
        class="ds-section"
        aria-labelledby="principii-title"
      >
        <div class="ds-section-heading">
          <Tag variant="index">01</Tag>
          <div>
            <h2 id="principii-title">Principii</h2>
            <p>Deciziile care țin piesele împreună.</p>
          </div>
        </div>
        <div class="ds-principles">
          <article>
            <p class="ds-principle-index">01</p>
            <h3>Editorial, nu decorativ</h3>
            <p>
              Tipografia și spațiul stabilesc ierarhia. Efectele rămân discrete
              și au un rol funcțional.
            </p>
          </article>
          <article>
            <p class="ds-principle-index">02</p>
            <h3>Semantic înainte de local</h3>
            <p>
              Se folosesc tokenurile comune înaintea valorilor izolate. O
              variantă nouă trebuie să răspundă unei nevoi repetate.
            </p>
          </article>
          <article>
            <p class="ds-principle-index">03</p>
            <h3>Accesibil implicit</h3>
            <p>
              Structura semantică, focusul vizibil, contrastul și mișcarea
              redusă fac parte din componentă, nu sunt completări ulterioare.
            </p>
          </article>
          <article>
            <p class="ds-principle-index">04</p>
            <h3>Proporțional și concentric</h3>
            <p>
              Controalele folosesc un scor de rotunjire de 60%: diametrul
              colțului este 60% din latura scurtă. Suprafețele imbricate scad
              raza interioară cu insetul vizibil dintre contururi.
            </p>
          </article>
        </div>
      </section>

      <section id="culori" class="ds-section" aria-labelledby="culori-title">
        <div class="ds-section-heading">
          <Tag variant="index">02</Tag>
          <div>
            <h2 id="culori-title">Culori</h2>
            <p>
              Paleta semantică Linen + Quiet Olive, aliasurile editoriale și
              accentele rezervate reflecției ghidate.
            </p>
          </div>
        </div>

        <div class="ds-subsection">
          <div class="ds-subsection-heading">
            <h3>Aliasuri editoriale</h3>
            <code>src/styles/tokens.css · @theme</code>
          </div>
          <ul class="ds-token-grid" role="list">
            {
              colorAliasTokens.map((token) => (
                <li
                  class="ds-color-token"
                  data-token-name={token.name}
                  data-token-source={token.source}
                  style={`--ds-swatch: ${token.value}`}
                >
                  <span class="ds-swatch" aria-hidden="true" />
                  <div>
                    <code>{token.name}</code>
                    <span>{token.value}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-subsection">
          <div class="ds-subsection-heading">
            <h3>Temă luminoasă</h3>
            <code>src/styles/global.css · :root</code>
          </div>
          <ul class="ds-token-grid" role="list">
            {
              lightColorTokens.map((token) => (
                <li
                  class="ds-color-token"
                  data-token-name={token.name}
                  data-token-source={token.source}
                  style={`--ds-swatch: var(${token.name})`}
                >
                  <span class="ds-swatch" aria-hidden="true" />
                  <div>
                    <code>{token.name}</code>
                    <span>{token.value}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ds-subsection ds-dark-theme dark">
          <div class="ds-subsection-heading">
            <div>
              <h3>Temă întunecată</h3>
              <p>
                Set disponibil în sursă, fără activare în experiența publică V1.
              </p>
            </div>
            <code>src/styles/global.css · .dark</code>
          </div>
          <ul class="ds-token-grid" role="list">
            {
              darkTokens.map((token) => (
                <li
                  class="ds-color-token"
                  data-token-name={token.name}
                  data-token-source={token.source}
                  style={`--ds-swatch: var(${token.name})`}
                >
                  <span class="ds-swatch" aria-hidden="true" />
                  <div>
                    <code>{token.name}</code>
                    <span>{token.value}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section
        id="tipografie"
        class="ds-section"
        aria-labelledby="tipografie-title"
      >
        <div class="ds-section-heading">
          <Tag variant="index">03</Tag>
          <div>
            <h2 id="tipografie-title">Tipografie</h2>
            <p>
              Aceeași familie Avenir susține atât expresia editorială, cât și
              controalele de interfață. Folosim greutatea Regular (400),
              inclusiv pentru titluri și acțiuni; ierarhia vine din dimensiune
              și spațiere.
            </p>
          </div>
        </div>

        <ul class="ds-variable-list" role="list">
          {
            typographyTokens.map((token) => (
              <li data-token-name={token.name} data-token-source={token.source}>
                <code>{token.name}</code>
                <span>{token.value}</span>
              </li>
            ))
          }
        </ul>

        <div class="ds-type-specimens">
          {
            typographyRecipes.map((recipe) => (
              <article>
                <div class="ds-recipe-meta">
                  <code>{recipe.selector}</code>
                  <span>
                    {recipe.declarations
                      .map(({ property, value }) => `${property}: ${value}`)
                      .join(" · ")}
                  </span>
                </div>
                {recipe.selector === ".display-hero" && (
                  <p class="display-hero">
                    Un spațiu pentru ceea ce cere atenție.
                  </p>
                )}
                {recipe.selector === ".display-page" && (
                  <p class="display-page">Psihoterapie psihanalitică</p>
                )}
                {recipe.selector === ".section-title" && (
                  <p class="section-title">Despre procesul terapeutic</p>
                )}
                {recipe.selector === ".heading-long" && (
                  <p class="heading-long">
                    Oare cum va fi prima ședință, la ce să mă aștept?
                  </p>
                )}
                {recipe.selector === ".text-body" && (
                  <p class="text-body">
                    Întâlnirile au câteva repere clare, care oferă continuitate
                    și siguranță.
                  </p>
                )}
                {recipe.selector === ".prose-editorial" && (
                  <div class="prose-editorial">
                    <p>
                      Psihoterapia poate crea un spațiu în care experiențele
                      dificile sunt privite cu răbdare, nu reduse la explicații
                      rapide.
                    </p>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section id="layout" class="ds-section" aria-labelledby="layout-title">
        <div class="ds-section-heading">
          <Tag variant="index">04</Tag>
          <div>
            <h2 id="layout-title">Layout, spațiere și colțuri</h2>
            <p>
              Lățimi de lectură, margini fluide, ritm vertical și rotunjiri
              proporționale pentru pagini aerisite pe toate dimensiunile.
            </p>
          </div>
        </div>

        <ul class="ds-variable-list ds-variable-list-large" role="list">
          {
            layoutTokens.map((token) => (
              <li data-token-name={token.name} data-token-source={token.source}>
                <code>{token.name}</code>
                <span>{token.value}</span>
              </li>
            ))
          }
        </ul>

        <div
          class="ds-measure-demo"
          aria-label="Demonstrație pentru lățimile de conținut"
        >
          <div class="ds-measure ds-measure-content">
            <span>--content-width</span>
          </div>
          <div class="ds-measure ds-measure-reading">
            <span>--reading-width</span>
          </div>
        </div>
      </section>

      <section id="miscare" class="ds-section" aria-labelledby="miscare-title">
        <div class="ds-section-heading">
          <Tag variant="index">05</Tag>
          <div>
            <h2 id="miscare-title">Mișcare</h2>
            <p>
              Feedback tactil scurt, tranziții de stare și intrări rare. Toate
              păstrează alternativa pentru mișcare redusă.
            </p>
          </div>
        </div>

        <ul class="ds-variable-list ds-variable-list-large" role="list">
          {
            motionTokens.map((token) => (
              <li data-token-name={token.name} data-token-source={token.source}>
                <code>{token.name}</code>
                <span>{token.value}</span>
              </li>
            ))
          }
        </ul>

        <button class="ds-motion-demo" type="button">
          <span>Focalizați sau treceți cursorul pentru demonstrație</span>
          <span class="ds-motion-track" aria-hidden="true">
            <span class="ds-motion-dot"></span>
          </span>
        </button>
      </section>

      <section
        id="componente"
        class="ds-section"
        aria-labelledby="componente-title"
      >
        <div class="ds-section-heading">
          <Tag variant="index">06</Tag>
          <div>
            <h2 id="componente-title">Componente</h2>
            <p>
              Mostre randate din implementările reale. Interacționați cu ele
              pentru a verifica stările de hover, focus, activă și dezactivată.
            </p>
          </div>
        </div>

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Butoane și acțiuni</h3>
            <code>button.tsx · ActionLink.astro</code>
          </div>
          <div class="ds-button-grid">
            {
              buttonVariants.map(([variant, label]) => (
                <div>
                  <Button
                    variant={variant}
                    disabled={variant === "destructive"}
                  >
                    {label}
                  </Button>
                  <code>{variant}</code>
                  {variant === "destructive" && (
                    <span class="ds-component-note">contrast de revizuit</span>
                  )}
                </div>
              ))
            }
          </div>
          <div class="ds-button-sizes" aria-label="Dimensiunile butoanelor">
            <Button size="xs">Extra mic</Button>
            <Button size="sm">Mic</Button>
            <Button size="default">Implicit</Button>
            <Button size="lg">Mare</Button>
            <Button size="icon" aria-label="Trimite mesaj">
              <IconMail aria-hidden="true" />
            </Button>
            <Button disabled>Indisponibil</Button>
          </div>
          <div class="ds-action-links">
            <ActionLink href="#componente">Acțiune primară</ActionLink>
            <ActionLink href="#componente" variant="secondary">
              Acțiune secundară
            </ActionLink>
            <Button variant="ghost">
              Continuați
              <IconArrowRight data-icon="inline-end" aria-hidden="true" />
            </Button>
          </div>
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Etichete</h3>
            <code>tag.tsx</code>
          </div>
          <div class="ds-tags">
            <Tag variant="section">Secțiune</Tag>
            <Tag variant="status">Publicat</Tag>
            <Tag variant="index">03</Tag>
          </div>
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Carduri și mesaje</h3>
            <code>card.tsx · alert.tsx</code>
          </div>
          <div class="ds-card-grid">
            <Card>
              <CardHeader>
                <CardTitle>Card editorial</CardTitle>
                <CardDescription>
                  Grupează informații legate fără a concura cu pagina.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <p>Conținut scurt, clar și susținut de spațierea comună.</p>
              </CardContent>
              <CardFooter>
                <Button variant="ghost" size="inline">Citiți detaliile</Button>
              </CardFooter>
            </Card>
            <div class="ds-alert-stack">
              <Alert role="status">
                <IconInfoCircle aria-hidden="true" />
                <AlertTitle>Mesaj informativ</AlertTitle>
                <AlertDescription>
                  Acesta este un exemplu de stare neutră, nu un mesaj clinic.
                </AlertDescription>
              </Alert>
              <Alert role="status" variant="destructive">
                <AlertTitle>Este nevoie de atenție</AlertTitle>
                <AlertDescription>
                  Starea critică folosește și text, nu doar culoare.
                </AlertDescription>
              </Alert>
            </div>
          </div>
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Câmpuri și selecții</h3>
            <code>input.tsx · textarea.tsx · choice.tsx</code>
          </div>
          <div class="ds-form-grid">
            <div class="ds-field">
              <Label htmlFor="ds-email">Adresă de email</Label>
              <Input
                id="ds-email"
                type="email"
                placeholder="nume@exemplu.ro"
                autoComplete="email"
              />
              <p>Text ajutător opțional.</p>
            </div>
            <div class="ds-field">
              <Label htmlFor="ds-disabled">Câmp indisponibil</Label>
              <Input id="ds-disabled" value="Nu poate fi modificat" disabled />
              <p>Starea dezactivată rămâne explicită.</p>
            </div>
            <div class="ds-field">
              <Label htmlFor="ds-invalid">Câmp cu eroare</Label>
              <Input
                id="ds-invalid"
                value="valoare incorectă"
                aria-invalid="true"
                aria-describedby="ds-invalid-error"
              />
              <p id="ds-invalid-error" class="ds-error">
                Verificați valoarea introdusă.
              </p>
            </div>
            <div class="ds-field">
              <Label htmlFor="ds-message">Mesaj</Label>
              <Textarea id="ds-message" placeholder="Scrieți aici…" rows={4} />
              <p>Textarea păstrează minimum 16 px pe mobil.</p>
            </div>
          </div>
          <fieldset class="ds-choice-group">
            <legend>Tonurile componentei Choice</legend>
            <Choice tone="soft">
              <input type="radio" name="ds-choice" value="soft" checked />
              <span>
                <strong>Soft</strong>
                <small>Selecție calmă, pe un fundal discret.</small>
              </span>
            </Choice>
            <Choice tone="solid">
              <input type="radio" name="ds-choice" value="solid" />
              <span>
                <strong>Solid</strong>
                <small>Selecție cu accent mai vizibil.</small>
              </span>
            </Choice>
          </fieldset>
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Dezvăluire și progres</h3>
            <code>disclosure.tsx · progress.tsx</code>
          </div>
          <div class="ds-native-grid">
            <Disclosure>
              <DisclosureTrigger>
                Exemplu de conținut pliabil
                <DisclosureIcon />
              </DisclosureTrigger>
              <DisclosureContent>
                <LineRevealText
                  text="Componenta folosește elementele native details și summary, deci rămâne funcțională fără JavaScript."
                  client:load
                />
              </DisclosureContent>
            </Disclosure>
            <div>
              <div class="ds-progress-label">
                <span>Progres orientativ</span>
                <span>67%</span>
              </div>
              <Progress value={67} aria-label="Progres orientativ: 67%" />
            </div>
          </div>
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Componente interactive</h3>
            <code>
              accordion.tsx · dialog.tsx · line-reveal-text.tsx ·
              radio-group.tsx
            </code>
          </div>
          <InteractiveShowcase client:load />
        </div>

        <Separator />

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Invitație la explorare</h3>
            <code>ExplorationPromoCard.astro</code>
          </div>
          <ExplorationPromoCard idPrefix="design-system-reflection" />
        </div>

        <div class="ds-component-group">
          <div class="ds-subsection-heading">
            <h3>Simbol animat pentru psihoterapie</h3>
            <code>PsiGraphic.astro</code>
          </div>
          <PsiGraphic playback="auto" />
        </div>
      </section>

      <section
        id="inventar"
        class="ds-section"
        aria-labelledby="inventar-title"
      >
        <div class="ds-section-heading">
          <Tag variant="index">07</Tag>
          <div>
            <h2 id="inventar-title">Inventarul componentelor</h2>
            <p>
              Lista este generată automat din <code>src/components/ui/</code>.
              Un fișier nou apare aici la următorul build.
            </p>
          </div>
        </div>

        <div
          class="ds-table-wrap"
          tabindex="0"
          role="region"
          aria-label="Tabel cu componente UI"
        >
          <table>
            <thead>
              <tr>
                <th scope="col">Fișier</th>
                <th scope="col">Tehnologie</th>
                <th scope="col">Exporturi</th>
                <th scope="col">Acoperire</th>
              </tr>
            </thead>
            <tbody>
