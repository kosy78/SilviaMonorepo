---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ActionLink from "../../components/ui/ActionLink.astro";
import Container from "../../components/ui/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft || (import.meta.env.DEV && data.localPreview),
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat("ro-RO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  robots={post.data.draft ? "noindex, nofollow" : undefined}
  canonical={!post.data.draft}
  socialPreview={!post.data.draft}
  articleImage={post.data.cover?.src}
>
  <article class="py-(--section-space)">
    <Container class="blog-reading-column">
      <header>
        {
          post.data.draft ? (
            <p class="text-muted-foreground text-sm">Previzualizare · Ciornă</p>
          ) : (
            <time
              class="text-muted-foreground text-sm"
              datetime={post.data.publishedAt.toISOString()}
            >
              {formatter.format(post.data.publishedAt)}
            </time>
          )
        }
        {
          post.data.updatedAt && (
            <p class="text-muted-foreground mt-2 text-sm">
              Actualizat la {formatter.format(post.data.updatedAt)}
            </p>
          )
        }
        <h1
          class="mt-6 text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.05] tracking-[-0.04em]"
        >
          {post.data.title}
        </h1>
        <p class="text-muted-foreground mt-8 text-xl leading-8">
          {post.data.description}
        </p>
        <p class="text-muted-foreground mt-6 text-sm">
          De <a class="underline underline-offset-4" href="/competente/"
            >{post.data.author}</a
          >
        </p>
      </header>

      <div class="prose-editorial mt-16">
        {
          post.data.cover && (
            <figure class="article-cover">
              <img {...post.data.cover} loading="lazy" decoding="async" />
            </figure>
          )
        }
        <Content />
      </div>

      <aside
        class="border-line mt-16 border-y py-8"
        aria-labelledby="article-next-step-title"
      >
        <h2 id="article-next-step-title" class="text-3xl tracking-[-0.025em]">
          Despre cadrul de lucru
        </h2>
        <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
          Puteți continua cu informațiile despre psihoterapie, consiliere și
          felul în care poate începe procesul.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <ActionLink href="/psihoterapie-si-consiliere/" variant="secondary">
            Psihoterapie și consiliere
          </ActionLink>
          <ActionLink
            href="/arii-de-lucru/consiliere-parentala/"
            variant="secondary"
          >
            Consiliere parentală
          </ActionLink>
        </div>
      </aside>

      <p class="border-line mt-16 border-t pt-6">
        <a
          class="inline-flex min-h-11 items-center underline decoration-1 underline-offset-4"
          href="/blog/"
        >
          Înapoi la toate articolele
        </a>
      </p>
    </Container>
  </article>
</BaseLayout>

<style>
  article :global(.blog-reading-column) {
    max-width: calc(44rem + 2 * var(--page-gutter));
  }

  article :global(:is(h2, h3, h4, h5, h6)[id]) {
    scroll-margin-top: calc(var(--site-header-clearance) + 1rem);
  }

  .prose-editorial {
    display: flow-root;
  }

  .article-cover {
    width: min(100%, 18rem);
    margin: 0 auto 2rem;
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }

  @media (min-width: 48rem) {
    .article-cover {
      float: right;
      width: 40%;
      margin: 0 0 1.5rem 2rem;
    }
  }

  @media (min-width: 90rem) {
    .article-cover {
      width: 20rem;
      margin-right: -10rem;
    }
  }

  .prose-editorial :global(h2) {
    clear: both;
    margin-block-start: clamp(2.5rem, 4vw, 3.5rem);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1.4;
  }

  .prose-editorial :global(a) {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* Tailwind's preflight removes list markers; reference lists need their numbers. */
  .prose-editorial :global(ol) {
    list-style: decimal;
    padding-inline-start: 1.75em;
    color: var(--color-quiet);
    font-size: 0.875em;
    line-height: 1.6;
  }

  .prose-editorial :global(ol > li + li) {
    margin-top: 0.75em;
  }

  .prose-editorial :global(ol > li::marker) {
    font-variant-numeric: tabular-nums;
  }

  .prose-editorial :global(.prose-hinge) {
    margin-block: clamp(2.5rem, 4vw, 3.25rem) clamp(2.25rem, 3.5vw, 3rem);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
    padding-inline-start: 1.375rem;
    border-inline-start: 1px solid var(--color-line);
  }

  .prose-editorial :global(.prose-setoff) {
    margin-block: 2.25rem;
    padding-inline-start: 1.375rem;
    border-inline-start: 1px solid var(--color-line);
    font-size: 1.1em;
    line-height: 1.6;
  }

  .prose-editorial :global(.prose-drawing) {
    display: block;
    color: var(--color-ink);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .prose-editorial :global(.prose-drawing path) {
    vector-effect: non-scaling-stroke;
  }

  .prose-editorial :global(.prose-drawing .is-open) {
    stroke-dasharray: 3 4;
  }

  .prose-editorial :global(.prose-drawing--pair) {
    width: 11rem;
    height: auto;
    margin: 2rem auto;
  }

  .prose-editorial :global(.prose-drawing--time) {
    width: 100%;
    height: clamp(5.5rem, 9vw, 8rem);
    margin-block: 2.5rem;
  }

  @media (min-width: 48rem) {
    .prose-editorial :global(.prose-drawing--pair) {
      float: right;
      width: 17rem;
      margin: 0.5rem 0 1.25rem 1.75rem;
    }
  }

  .prose-editorial :global(.article-illustration) {
    width: min(100%, 18rem);
    aspect-ratio: 1;
    overflow: hidden;
    margin-block: 2rem;
    margin-inline: auto;
  }

  .prose-editorial :global(.article-illustration img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: multiply;
  }

  @media (min-width: 48rem) {
    .prose-editorial :global(.article-illustration) {
      float: right;
      width: 40%;
      max-width: 17rem;
      margin: 0 0 1rem 1.75rem;
    }
  }
</style>
