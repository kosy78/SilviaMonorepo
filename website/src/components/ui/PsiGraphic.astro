---
import { Image } from "astro:assets";
import psiHead from "../../assets/homepage/psychotherapy-psi-head.png";
import psiOverlay from "../../assets/homepage/psychotherapy-psi-overlay.png";

interface Props {
  size?: number;
  playback?: "interaction" | "auto";
  class?: string;
}

// Interaction mode follows a containing interactive surface with data-psi-trigger.
const { size = 63, playback = "interaction", class: className } = Astro.props;
---

<div
  class:list={[
    "psi-graphic",
    { "psi-graphic--auto": playback === "auto" },
    className,
  ]}
  style={`--psi-size-scale: ${size / 63}`}
  aria-hidden="true"
>
  <div class="psi-graphic__art">
    {
      [0, 1].map(() => (
        <div class="psi-graphic__head">
          <Image src={psiHead} width={124} alt="" />
        </div>
      ))
    }
    <div class="psi-graphic__head">
      <div class="psi-graphic__overlay">
        <Image src={psiOverlay} width={380} alt="" />
      </div>
    </div>
    <span class="psi-graphic__letter">Ψ</span>
  </div>
</div>

<style>
  .psi-graphic {
    position: relative;
    width: calc(63px * var(--psi-size-scale));
    height: calc(63px * var(--psi-size-scale));
    overflow: hidden;
    pointer-events: none;
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter 497ms cubic-bezier(0.5, 0, 0.5, 1),
      opacity 150ms var(--ease-out);
  }

  .psi-graphic__art {
    position: relative;
    width: 63px;
    height: 63px;
    transform: scale(var(--psi-size-scale));
    transform-origin: top left;
  }

  .psi-graphic__head {
    position: absolute;
    top: -1px;
    left: 1px;
    width: 62px;
    height: 64px;
    transform: rotate(180deg) scaleY(-1);
  }

  .psi-graphic__head > img {
    width: 100%;
    height: 100%;
    object-position: bottom;
  }

  .psi-graphic__overlay {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    animation: var(--psi-overlay-animation, none);
  }

  .psi-graphic__overlay img {
    position: absolute;
    width: 306.79%;
    height: 446.43%;
    max-width: none;
    left: -196.91%;
    top: -220.24%;
  }

  .psi-graphic__letter {
    position: absolute;
    left: calc(50% - 21.5px);
    top: calc(50% - 24.5px);
    color: #141414;
    font-family: var(--font-sans);
    font-size: 52px;
    font-weight: 400;
    line-height: 1.156;
    animation: var(--psi-letter-animation, none);
  }

  /* Figma 152:631: two coordinated tracks share the same 3.05s loop. */
  @keyframes psi-color {
    0% {
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
      opacity: 0;
    }
    16.295%,
    100% {
      opacity: 1;
    }
  }

  @keyframes psi-scale {
    0% {
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
      scale: 1 1;
    }
    16.295%,
    100% {
      scale: 0.9 0.9;
    }
  }

  .psi-graphic--auto,
  :global([data-psi-trigger]:focus-visible) .psi-graphic {
    --psi-overlay-animation: psi-color 3.05s linear infinite;
    --psi-letter-animation: psi-scale 3.05s linear infinite;
    filter: grayscale(0);
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    :global([data-psi-trigger]:hover) .psi-graphic {
      --psi-overlay-animation: psi-color 3.05s linear infinite;
      --psi-letter-animation: psi-scale 3.05s linear infinite;
      filter: grayscale(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .psi-graphic {
      transition: none;
    }
    .psi-graphic__overlay,
    .psi-graphic__letter {
      animation: none;
    }

    .psi-graphic--auto .psi-graphic__overlay,
    :global([data-psi-trigger]:focus-visible) .psi-graphic__overlay {
      opacity: 1;
    }

    .psi-graphic--auto .psi-graphic__letter {
      scale: 0.9;
    }

    @media (hover: hover) and (pointer: fine) {
      :global([data-psi-trigger]:hover) .psi-graphic__overlay {
        opacity: 1;
      }
    }
  }
</style>
