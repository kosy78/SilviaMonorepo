---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";

import cardBody from "../../assets/homepage/card-body.png";
import cardChanges from "../../assets/homepage/card-changes.png";
import cardRelations from "../../assets/homepage/card-relations.png";
import Container from "../ui/Container.astro";
import HomepageBlogCarousel, { type BlogPreview } from "./HomepageBlogCarousel";

const [cardBodyOptimized, cardChangesOptimized, cardRelationsOptimized] =
  await Promise.all([
    getImage({ src: cardBody, width: 720, format: "webp", quality: 75 }),
    getImage({ src: cardChanges, width: 720, format: "webp", quality: 75 }),
    getImage({ src: cardRelations, width: 720, format: "webp", quality: 75 }),
  ]);

const placeholders: BlogPreview[] = [
  {
    imageHeight: cardBody.height,
    imageSrc: cardBodyOptimized.src,
    imageWidth: cardBody.width,
    title: "Ce înseamnă să începeți psihoterapia?",
    description:
      "Câteva repere despre prima întâlnire, ritmul procesului și felul în care poate prinde contur un cadru de lucru.",
    tone: "body",
  },
  {
    imageHeight: cardRelations.height,
    imageSrc: cardRelationsOptimized.src,
    imageWidth: cardRelations.width,
    title: "Când aceleași dificultăți revin",
    description:
      "O privire asupra tiparelor care se repetă în relații și asupra întrebărilor pe care le pot deschide.",
    tone: "relations",
  },
  {
    imageHeight: cardChanges.height,
    imageSrc: cardChangesOptimized.src,
    imageWidth: cardChanges.width,
    title: "Despre schimbare și timpul ei",
    description:
      "De ce unele schimbări au nevoie de răbdare, continuitate și un spațiu în care experiența să poată fi pusă în cuvinte.",
    tone: "changes",
  },
];

const publishedPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const publishedPreviews: BlogPreview[] = publishedPosts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: `/blog/${post.id}/`,
  imageSrc: post.data.cover?.src ?? cardBodyOptimized.src,
  imageWidth: post.data.cover?.width ?? cardBody.width,
  imageHeight: post.data.cover?.height ?? cardBody.height,
  tone: post.data.cover ? "cover" : "body",
}));
const previews = [
  ...publishedPreviews,
  ...placeholders.slice(publishedPreviews.length),
];
---

<section class="homepage-blog" aria-labelledby="homepage-blog-title">
  <Container>
    <HomepageBlogCarousel previews={previews} client:visible />
  </Container>
</section>

<style>
  .homepage-blog {
    background: var(--background);
    padding-block: var(--section-space-compact);
  }

  .homepage-blog :global(.homepage-blog__header) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .homepage-blog :global(.homepage-blog__heading) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .homepage-blog :global(.homepage-blog__heading h2) {
    max-width: 13ch;
  }

  .homepage-blog :global(.homepage-blog__actions) {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 1.25rem;
  }

  .homepage-blog :global(.homepage-blog__controls) {
    display: flex;
    gap: 0.5rem;
  }

  .homepage-blog
    :global(
      .homepage-blog__actions:has(
          .homepage-blog__control:first-child:disabled
        ):has(.homepage-blog__control:last-child:disabled)
    ) {
    display: none;
  }

  .homepage-blog :global(.homepage-blog__control) {
    position: static;
    inset: auto;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    transform: none;
  }

  .homepage-blog :global(.homepage-blog__track) {
    align-items: stretch;
  }

  .homepage-blog :global(.homepage-blog__slide) {
    height: auto;
  }

  .homepage-blog :global(.homepage-blog__card) {
    position: relative;
    min-block-size: 26rem;
  }

  .homepage-blog :global(.homepage-blog__visual) {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 9;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklch, var(--secondary), var(--background) 35%);
  }

  .homepage-blog :global(.homepage-blog__visual[data-tone="body"]) {
    background: color-mix(in oklch, var(--secondary), var(--chart-3) 8%);
  }

  .homepage-blog :global(.homepage-blog__visual[data-tone="relations"]) {
    background: color-mix(in oklch, var(--secondary), var(--chart-2) 8%);
  }

  .homepage-blog :global(.homepage-blog__visual[data-tone="changes"]) {
    background: color-mix(in oklch, var(--secondary), var(--chart-4) 8%);
  }

  .homepage-blog :global(.homepage-blog__visual img) {
    width: min(66%, 14rem);
    height: 76%;
    object-fit: contain;
    opacity: 0.78;
  }

  .homepage-blog :global(.homepage-blog__visual[data-tone="cover"] img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    opacity: 1;
  }

  .homepage-blog :global(.homepage-blog__article-link::after) {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
  }

  .homepage-blog :global(.homepage-blog__article-link:hover) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .homepage-blog :global(.homepage-blog__card:focus-within) {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  .homepage-blog :global(.homepage-blog__status) {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  .homepage-blog :global(.homepage-blog__card-header) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    min-inline-size: 0;
    padding: 1.5rem;
  }

  .homepage-blog :global(.homepage-blog__card-title) {
    max-inline-size: 16ch;
    font-family: var(--font-display);
    font-weight: 400;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .homepage-blog :global(.homepage-blog__card-description) {
    max-inline-size: 38ch;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.7;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  @media (max-width: 56rem) {
    .homepage-blog :global(.homepage-blog__header) {
      grid-template-columns: 1fr;
    }

    .homepage-blog :global(.homepage-blog__actions) {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }

    .homepage-blog :global(.homepage-blog__card) {
      min-block-size: 25rem;
    }
  }

  @media (max-width: 34rem) {
    .homepage-blog :global(.homepage-blog__actions) {
      align-items: stretch;
      flex-direction: column;
    }

    .homepage-blog :global(.homepage-blog__controls) {
      align-self: flex-end;
    }
  }
</style>
