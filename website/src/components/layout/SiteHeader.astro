---
import { IconMenu2, IconX } from "@tabler/icons-react";

import { cn } from "../../lib/utils";
import { buttonVariants } from "../ui/button";

const navigation = [
  { href: "/", label: "Acasă" },
  { href: "/reflectie-ghidata/", label: "O primă explorare" },
  {
    href: "/psihoterapie-si-consiliere/",
    label: "Psihoterapia psihanalitică",
  },
  { href: "/competente/", label: "Competențe" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-site-header data-scrolled="false">
  <div class="site-header__inner">
    <a
      href="/"
      class="site-header__brand"
      aria-label="Despre Sine, Psihoterapeut Silvia Dinu"
    >
      <span class="site-header__mark" aria-hidden="true">
        <img src="/images/despresine-logo.png" alt="" width="38" height="38" />
      </span>
      <span class="site-header__wordmark">
        <span class="site-header__name">Despre Sine</span>
        <span class="site-header__practitioner">
          Psihoterapeut Silvia Dinu
        </span>
      </span>
    </a>

    <button
      type="button"
      class={cn(
        buttonVariants({ variant: "ghost", size: "icon" }),
        "site-header__menu-toggle",
      )}
      aria-expanded="false"
      aria-controls="navigatie-principala"
      aria-label="Deschideți meniul"
      data-navigation-toggle
    >
      <IconMenu2 className="site-header__menu-open" aria-hidden="true" />
      <IconX className="site-header__menu-close" aria-hidden="true" />
    </button>

    <nav
      id="navigatie-principala"
      class="site-header__navigation"
      aria-label="Navigație principală"
      aria-hidden="true"
      data-site-navigation
      inert
    >
      <ul class="site-header__links">
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                data-active={isActive(item.href) ? "true" : undefined}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="site-header__link"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 40;
    top: 0;
    right: 0;
    left: 0;
    isolation: isolate;
    background: transparent;
  }

  .site-header::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: color-mix(in oklch, var(--background) 80%, transparent);
    box-shadow:
      inset 0 -1px color-mix(in oklch, var(--border) 82%, transparent),
      0 0.5rem 1.5rem color-mix(in oklch, var(--foreground) 6%, transparent);
    opacity: 0;
    -webkit-backdrop-filter: blur(16px) saturate(125%);
    backdrop-filter: blur(16px) saturate(125%);
    content: "";
    pointer-events: none;
    transition: opacity var(--duration-state) var(--ease-out);
  }

  .site-header[data-scrolled="true"]::before,
  .site-header[data-navigation-open="true"]::before {
    opacity: 1;
  }

  .site-header__inner {
    display: flex;
    width: min(calc(100% - (2 * var(--page-gutter))), var(--content-width));
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
  }

  .site-header__brand {
    display: inline-flex;
    min-height: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .site-header__mark {
    position: relative;
    display: grid;
    width: 2.375rem;
    height: 2.375rem;
    flex-shrink: 0;
    place-items: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .site-header__mark::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0.25rem 0.25rem
      color-mix(in oklch, var(--background) 25%, transparent);
    content: "";
    pointer-events: none;
  }

  .site-header__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-header__wordmark {
    display: flex;
    width: 11.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    color: var(--foreground);
    font-family: var(--font-display);
    font-weight: 400;
  }

  .site-header__name {
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .site-header__practitioner {
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
  }

  .site-header__links li {
    list-style: none;
  }

  .site-header__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding-inline: 0.75rem;
    background: transparent;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    white-space: nowrap;
  }

  .site-header__link:is(:hover, :focus-visible, [data-active="true"]) {
    text-decoration-color: currentColor;
  }

  .site-header__link:focus-visible {
    box-shadow: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .site-header__navigation {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .site-header__menu-toggle {
    position: relative;
    display: none;
    flex-shrink: 0;
    border: 0;
  }

  .site-header__menu-toggle :global(svg) {
    position: absolute;
    transition:
      opacity var(--duration-press) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .site-header__menu-close {
    opacity: 0;
    transform: scale(0.8) rotate(-18deg);
  }

  .site-header[data-navigation-open="true"] .site-header__menu-open {
    opacity: 0;
    transform: scale(0.8) rotate(18deg);
  }

  .site-header[data-navigation-open="true"] .site-header__menu-close {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  @media (max-width: 69.999rem) {
    .site-header__menu-toggle {
      display: inline-flex;
    }

    .site-header__navigation {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: grid;
      max-height: calc(100dvh - 4.75rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      gap: 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--background);
      padding: 1rem var(--page-gutter) 1.5rem;
      opacity: 0;
      transform: translateY(-0.5rem);
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--duration-exit) var(--ease-out),
        transform var(--duration-state) var(--ease-out),
        visibility 0s linear var(--duration-state);
    }

    .site-header[data-navigation-open="true"] .site-header__navigation {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    .site-header__links {
      display: grid;
      gap: 0.25rem;
    }

    .site-header__link {
      width: 100%;
      min-height: 3rem;
      justify-content: flex-start;
      padding-inline: 1rem;
    }
  }

  @media (max-width: 34rem) {
    .site-header__inner {
      width: calc(100% - 2rem);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header::before {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header::before {
      transition: none;
    }

    .site-header__menu-toggle :global(svg) {
      transition: opacity var(--duration-press) var(--ease-out);
    }

    .site-header__menu-toggle .site-header__menu-open,
    .site-header__menu-toggle .site-header__menu-close,
    .site-header[data-navigation-open="true"] .site-header__menu-open,
    .site-header[data-navigation-open="true"] .site-header__menu-close {
      transform: none;
    }

    .site-header__navigation {
      transform: none;
      transition:
        opacity var(--duration-exit) var(--ease-out),
        visibility 0s linear var(--duration-exit);
    }

    .site-header[data-navigation-open="true"] .site-header__navigation {
      transform: none;
    }
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const navigationToggle = document.querySelector<HTMLButtonElement>(
    "[data-navigation-toggle]",
  );
  const siteNavigation = document.querySelector<HTMLElement>(
    "[data-site-navigation]",
  );
  const desktopNavigation = window.matchMedia("(min-width: 1120px)");

  const setNavigationOpen = (open: boolean) => {
    if (!navigationToggle || !siteNavigation) return;

    const nextOpen = desktopNavigation.matches ? false : open;
    const navigationIsAvailable = desktopNavigation.matches || nextOpen;

    navigationToggle.setAttribute("aria-expanded", String(nextOpen));
    navigationToggle.setAttribute(
      "aria-label",
      nextOpen ? "Închideți meniul" : "Deschideți meniul",
    );
    siteNavigation.setAttribute("aria-hidden", String(!navigationIsAvailable));
    siteNavigation.toggleAttribute("inert", !navigationIsAvailable);
    siteHeader?.setAttribute("data-navigation-open", String(nextOpen));
  };

  navigationToggle?.addEventListener("click", () => {
    setNavigationOpen(
      navigationToggle.getAttribute("aria-expanded") !== "true",
    );
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      navigationToggle?.getAttribute("aria-expanded") === "true"
    ) {
      setNavigationOpen(false);
      navigationToggle.focus();
    }
  });

  desktopNavigation.addEventListener("change", () => setNavigationOpen(false));
  setNavigationOpen(false);

  const updateScrolledState = () => {
    siteHeader?.setAttribute("data-scrolled", String(window.scrollY > 0));
  };

  updateScrolledState();
  window.addEventListener("scroll", updateScrolledState, { passive: true });
</script>
