---
import ContactForm from "../components/contact/ContactForm.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: in review after adding the minimal contact form. Practical,
// privacy and retention wording require Silvia's final review before launch.
---

<BaseLayout
  title="Contact"
  description="Contactați-o pe Silvia Dinu pentru a întreba despre disponibilitatea pentru psihoterapie psihanalitică și consiliere, în București sau online."
>
  <section class="py-(--intro-space)" data-contact-section>
    <Container
      class="grid gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-start md:gap-16"
    >
      <div class="max-w-xl">
        <h1 class="display-page">Îmi puteți scrie.</h1>
        <p
          class="text-muted-foreground mt-8 max-w-2xl text-lg leading-8 md:text-xl"
        >
          Pentru început, este suficient să întrebați dacă există
          disponibilitate. Nu este nevoie să descrieți întreaga situație sau să
          includeți informații sensibile.
        </p>
      </div>

      <div class="md:pt-2">
        <h2 id="formular-contact" class="sr-only">Formular de contact</h2>
        <ContactForm />
      </div>
    </Container>
  </section>
</BaseLayout>
