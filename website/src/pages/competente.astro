---
import { getImage, Image, Picture } from "astro:assets";

import anxietyIllustration from "../assets/competencies/support-areas/anxietate-si-atacuri-de-panica.png";
import depressionIllustration from "../assets/competencies/support-areas/stari-depresive-preview.jpg";
import somaticIllustration from "../assets/competencies/support-areas/manifestari-somatice.png";
import relationsIllustration from "../assets/competencies/support-areas/dificultati-in-relatii.png";
import identityIllustration from "../assets/competencies/support-areas/stima-de-sine-si-identitate.png";
import emotionsIllustration from "../assets/competencies/support-areas/emotii-greu-de-gestionat.png";
import patternsIllustration from "../assets/competencies/support-areas/tipare-care-se-repeta-preview.jpg";
import transitionsIllustration from "../assets/competencies/support-areas/pierderi-si-schimbari-importante.png";
import parentalCounselingIllustration from "../assets/competencies/parental-counseling-session.png";
import parentalRoomStars from "../assets/competencies/parental-room-stars.png";
import parentalCounselingRoomIllustration from "../assets/competencies/parental-counseling-room-refined.png";
import parentalTeddyBullet from "../assets/competencies/parental-bullets/teddy-head.png";
import parentalStarsBullet from "../assets/competencies/parental-bullets/stars.png";
import parentalBlocksBullet from "../assets/competencies/parental-bullets/toy-blocks.png";
import parentalMoonBullet from "../assets/competencies/parental-bullets/moon.png";
import silviaPortrait from "../assets/competencies/silvia-dinu-portrait-2026-10-08.jpeg";
import reflectionBackground from "../assets/homepage/content-pixie-Px5UF7da7q4-unsplash.jpg";
import SupportAreasAccordion from "../components/sections/SupportAreasAccordion";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials require Silvia's review before publication.
// User confirmed permission to publish the selected illustrations on 2026-10-07.

const background = await getImage({
  src: reflectionBackground,
  width: 1920,
  format: "webp",
  quality: 80,
});

const supportAreas = [
  {
    title: "Anxietate și atacuri de panică",
    illustration: anxietyIllustration,
    description:
      "Stări de neliniște, ruminații, stare de teamă, nevoia de a controla lucrurile sau episoade de panică, cu sau fără un context clar.",
  },
  {
    title: "Stări depresive",
    illustrationWrap: true,
    illustration: depressionIllustration,
    description:
      "Tristețe care persistă, lipsă de energie sau de interes, retragere, vinovăție, sentiment de gol sau perioade în care lucrurile care înainte aveau sens nu mai aduc aceeași plăcere.",
  },
  {
    title: "Manifestări somatice",
    illustration: somaticIllustration,
    description:
      "Senzații sau simptome corporale care pot însoți trăiri emoționale greu de înțeles sau exprimat. Dureri, tensiune, oboseală, disconfort digestiv, palpitații, amețeală, amorțeli sau alte senzații neplăcute în corp, mai ales atunci când acestea apar sau se intensifică în anumite perioade.",
  },
  {
    title: "Dificultăți în relații",
    illustrationWrap: true,
    illustration: relationsIllustration,
    description:
      "Conflicte care se repetă, dificultatea de a vă apropia sau de a avea încredere, teama de abandon, gelozie, dependență emoțională ori dificultatea de a spune ce aveți nevoie și de a pune limite.",
  },
  {
    title: "Stima de sine scăzută",
    illustration: identityIllustration,
    description:
      "Nesiguranță, autocritică, sentimentul că nu sunteți suficient de bun, nevoia frecventă de confirmare sau dificultatea de a înțelege mai clar ce vă doriți și ce vi se potrivește.",
  },
  {
    title: "Emoții greu de gestionat",
    illustration: emotionsIllustration,
    description:
      "Furie, iritabilitate, impulsivitate, schimbări bruște de dispoziție, sensibilitate puternică la respingere sau momente în care ceea ce simțiți devine greu de controlat ori de pus în cuvinte.",
  },
  {
    title: "Tipare care se repetă",
    illustrationCrop: true,
    illustration: patternsIllustration,
    description:
      "Situații în care observați că ajungeți din nou la aceleași conflicte, alegeri sau rezultate, chiar dacă oamenii și împrejurările se schimbă și chiar dacă v-ați propus să procedați diferit.",
  },
  {
    title: "Pierderi și schimbări importante",
    illustration: transitionsIllustration,
    description:
      "Doliu, despărțire, boală, epuizare, schimbarea locului de muncă, mutare, maternitate sau alte perioade de tranziție care pot aduce nesiguranță, neliniște sau nevoia de a vă regăsi un echilibru.",
  },
] as const;

const parentalCounselingSituations = [
  {
    illustration: parentalTeddyBullet,
    text: "copilul sau adolescentul este mai retras, anxios, trist, iritabil sau are reacții pe care vă este greu să le gestionați;",
    emphasized: false,
  },
  {
    illustration: parentalBlocksBullet,
    text: "apar conflicte frecvente legate de limite, școală, telefon, platforme sociale, anturaj sau nevoia de independență;",
    emphasized: false,
  },
  {
    illustration: parentalStarsBullet,
    text: "simțiți că nu mai reușiți să comunicați așa cum o făceați înainte;",
    emphasized: false,
  },
  {
    illustration: parentalMoonBullet,
    text: "apar probleme de somn, alimentație, concentrare sau manifestări corporale repetate;",
    emphasized: false,
  },
  {
    illustration: parentalBlocksBullet,
    text: "familia trece printr-un divorț, o pierdere, o mutare, apariția unui frate sau o altă schimbare importantă;",
    emphasized: false,
  },
  {
    illustration: parentalStarsBullet,
    text: "vă este greu să găsiți un echilibru între protecție, limite și libertatea de care copilul are nevoie;",
    emphasized: false,
  },
  {
    illustration: parentalMoonBullet,
    text: "vă simțiți epuizat, vinovat, neputincios sau nesigur în rolul de părinte;",
    emphasized: false,
  },
  {
    illustration: parentalTeddyBullet,
    text: "copilul sau adolescentul urmează deja o psihoterapie și aveți nevoie să înțelegeți cum îl puteți susține, păstrând în același timp spațiul său personal.",
    emphasized: true,
  },
] as const;

const supportAreasWithIllustrations = await Promise.all(
  supportAreas.map(async ({ illustration, ...item }) => {
    const optimizedIllustration = await getImage({
      src: illustration,
      width:
        "illustrationCrop" in item || "illustrationWrap" in item ? 720 : 420,
      format: "webp",
      quality: 82,
    });

    return {
      ...item,
      illustrationHeight: illustration.height,
      illustrationSrc: optimizedIllustration.src,
      illustrationWidth: illustration.width,
    };
  }),
);
---

<BaseLayout
  title="Silvia Dinu · Formare și competențe"
  description="Informații despre studiile, formarea, experiența, orientarea și ariile de lucru ale practicii Silviei Dinu."
>
  <section
    class="about-page py-(--section-space)"
    style={`--reflection-background: url('${background.src}')`}
  >
    <Container>
      <div class="about-layout">
        <div class="about-introduction">
          <div class="about-profile about-reveal about-reveal--profile">
            <figure class="profile-portrait">
              <Picture
                src={silviaPortrait}
                formats={["avif", "webp"]}
                widths={[224, 320, 480, 640]}
                sizes="(max-width: 47.99rem) 7rem, (max-width: 58.33rem) 14rem, (max-width: 75rem) 24vw, 18rem"
                quality={84}
                alt="Silvia Dinu"
                loading="eager"
                decoding="async"
              />
            </figure>

            <div class="about-identity">
              <h1 class="about-title font-display">Silvia Dinu</h1>
              <p class="about-role text-foreground/80">
                Psihoterapeut de orientare psihanalitică
              </p>
            </div>
          </div>

          <div class="about-narrative about-reveal about-reveal--narrative">
            <h2 class="about-method-title font-display">
              Dinspre sine către celălalt
            </h2>
            <div class="prose-editorial about-copy">
              <p>
                Am avut norocul ca întâlnirea mea cu psihanaliza să se întâmple
                la scurt timp după terminarea facultății de Psihologie. Am
                pornit pe acest drum cu multă curiozitate, dar și cu dorința de
                a înțelege, prin propria experiență, ce face demersul
                psihanalitic atât de valoros.
              </p>
              <p>
                Anii de formare și analiza personală m-au ajutat să îmi clădesc
                traseul în propria practică psihanalitică.
              </p>
              <p>
                În ultimii ani, întâlnirea din cabinet cu fiecare persoană și
                mai ales cu nevoile sale continuă să mă formeze ca
                psihoterapeut. Formarea teoretică și experiența de lucru au
                conturat modul în care lucrez în prezent: cu răbdare,
                curiozitate și respect pentru ritmul fiecărei persoane.
              </p>
              <p>
                <ActionLink href="/contact/">
                  Solicitați o întâlnire preliminară
                </ActionLink>
              </p>
            </div>
          </div>
        </div>

        <section
          class="about-support"
          aria-labelledby="about-support-title"
          data-therapy-help
        >
          <div class="about-section-intro">
            <h2
              id="about-support-title"
              class="heading-long about-support-title"
            >
              În practica mea, lucrez cu persoane care se confruntă cu
              dificultăți precum:
            </h2>
          </div>

          <SupportAreasAccordion
            items={supportAreasWithIllustrations}
            headingLevel={3}
            client:load
          />
        </section>

        <section
          class="about-parental"
          aria-labelledby="about-parental-title"
          data-parent-counseling
        >
          <div class="about-parental-header">
            <div class="about-parental-copy">
              <h2
                id="about-parental-title"
                class="section-title about-parental-title"
              >
                Consiliere parentală
              </h2>
              <div class="about-parental-intro">
                <p>
                  Uneori, chiar și atunci când faceți tot ce puteți pentru
                  copilul dumneavoastră, pot apărea momente în care nu mai este
                  clar ce are nevoie, cum să vă apropiați sau ce ar fi de
                  ajutor.
                </p>
                <p>
                  În astfel de perioade, și părinții pot avea nevoie de un
                  spațiu în care să înțeleagă mai bine ce se întâmplă.
                </p>
              </div>
            </div>
            <div class="about-parental-artwork" aria-hidden="true">
              <Image
                src={parentalCounselingIllustration}
                alt=""
                widths={[320, 480, 736]}
                sizes="(max-width: 767px) 276px, (max-width: 1023px) 332px, 424px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div
            class="about-parental-uses"
            role="group"
            aria-labelledby="about-parental-uses-title"
          >
            <div class="about-parental-uses-header">
              <h3
                id="about-parental-uses-title"
                class="about-parental-subtitle"
              >
                Când vă ajută <em>consilierea parentală</em>
              </h3>
              <div class="about-parental-uses-artwork" aria-hidden="true">
                <Image
                  class="about-parental-stars"
                  src={parentalRoomStars}
                  alt=""
                  widths={[240, 480]}
                  sizes="240px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
                <Image
                  class="about-parental-room"
                  src={parentalCounselingRoomIllustration}
                  alt=""
                  aria-hidden="true"
                  widths={[288, 440, 630]}
                  sizes="(max-width: 580px) 288px, (max-width: 1023px) 320px, 440px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <ul
              class="about-parental-list"
              role="list"
              data-parent-counseling-list
            >
              {
                parentalCounselingSituations.map(
                  ({ illustration, text, emphasized }) => (
                    <li>
                      <Image
                        class="about-parental-bullet"
                        src={illustration}
                        alt=""
                        aria-hidden="true"
                        width={64}
                        height={64}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>{emphasized ? <strong>{text}</strong> : text}</span>
                    </li>
                  ),
                )
              }
            </ul>
          </div>

          <aside
            class="about-parental-disclaimer"
            aria-label="Despre consilierea parentală"
          >
            <p>
              Consilierea parentală nu caută un vinovat și nici o formulă
              perfectă de a fi părinte. Încercăm să înțelegem ce se întâmplă în
              această perioadă, ce poate sta în spatele anumitor reacții și ce
              ar putea ajuta relația dintre părinte și copil.
            </p>
            <p>
              Întâlnirile pot avea loc cu un singur părinte sau cu ambii
              părinți, în funcție de situație. Uneori sunt suficiente câteva
              ședințe pentru a clarifica o anumită problemă, iar alteori poate
              fi utilă o perioadă mai lungă de sprijin.
            </p>
          </aside>
        </section>

        <section
          class="about-competencies"
          aria-labelledby="about-competencies-title"
        >
          <h2
            id="about-competencies-title"
            class="font-display text-3xl tracking-[-0.025em]"
          >
            Studii și calificări
          </h2>

          <dl class="about-facts">
            <div class="about-studies">
              <dt class="sr-only">Studii și calificări</dt>
              <dd>
                <ul class="about-studies-list">
                  <li>
                    Licențiată în Psihologie — Universitatea de Vest din
                    Timișoara
                  </li>
                  <li>
                    Formare în Psihoterapie Psihanalitică la Asociația de
                    Consiliere și Psihoterapie Psihanalitică București (ACPPB)
                  </li>
                  <li>
                    Master în Psihanaliză la Universitatea Titu Maiorescu
                    București
                  </li>
                  <li>Membru ACPPB / Colegiul Psihologilor</li>
                </ul>
              </dd>
            </div>
            <div>
              <dt class="text-muted-foreground text-sm">Orientare</dt>
              <dd class="mt-2">Psihanalitică / psihodinamică</dd>
            </div>
            <div>
              <dt class="text-muted-foreground text-sm">Arii de lucru</dt>
              <dd class="mt-2">Psihoterapie cu adulți și adolescenți</dd>
            </div>
          </dl>
        </section>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .about-page {
    position: relative;
    isolation: isolate;
    margin-block-start: calc(-1 * var(--site-header-clearance));
    padding-block-start: calc(
      var(--site-header-clearance) + var(--section-space)
    );
    background: var(--background);
  }

  .about-page::before {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 100svh;
    background:
      var(--botanical-backdrop-wash),
      var(--reflection-background) center top / cover no-repeat;
    opacity: var(--botanical-backdrop-opacity);
    mask-image: var(--botanical-backdrop-fade);
    content: "";
    pointer-events: none;
  }

  .about-layout {
    display: grid;
    gap: 3.5rem;
  }

  .about-introduction {
    display: grid;
    gap: 3rem;
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
  }

  .about-reveal--profile {
    animation: about-profile-reveal var(--duration-panel) var(--ease-out) both;
  }

  .about-reveal--narrative {
    animation: about-content-reveal var(--duration-panel) var(--ease-out) both;
    animation-delay: 60ms;
  }

  .about-profile {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    align-content: start;
    gap: 1.25rem;
  }

  .about-identity {
    display: grid;
    gap: 0.5rem;
  }

  .profile-portrait {
    position: relative;
    width: 7rem;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin: 0;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    border-radius: var(--radius-lg);
    background: var(--muted);
  }

  .about-copy {
    max-width: 38rem;
    margin-block-start: 2rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.125rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .about-copy > p:first-child {
    font-size: clamp(1.125rem, 1.6vw, 1.25rem);
    line-height: 1.65;
  }

  .about-copy > p + p {
    margin-block-start: 1.5rem;
  }

  .about-copy > p:last-child {
    margin-block-start: 2rem;
  }

  .about-title {
    max-width: 12ch;
    margin: 0;
    font-size: 2rem;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .about-role {
    max-width: 24ch;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .about-method-title {
    max-width: 15ch;
    margin-block-start: 0;
    font-size: clamp(2.25rem, 4.8vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .about-copy :global([data-slot="button"]:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .about-facts {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
    border-block: 1px solid var(--border);
    padding-block: 1.5rem;
  }

  .about-support,
  .about-parental {
    grid-column: 1 / -1;
  }

  .about-support {
    margin-block-start: clamp(2rem, 5vw, 4.5rem);
  }

  .about-support-title {
    font-size: 2.125rem;
  }

  .about-support :global([data-therapy-help-list]) {
    margin-block-start: 2rem;
  }

  .section-title.about-parental-title {
    max-width: 16ch;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .about-section-intro,
  .about-parental-header {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .about-parental {
    container-name: about-parental;
    container-type: inline-size;
    margin-block-start: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-2xl);
    background: color-mix(in oklch, var(--muted) 56%, var(--background));
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .about-parental-intro {
    display: grid;
    gap: 1rem;
    max-width: 65ch;
    margin-block-start: 1.5rem;
    color: var(--muted-foreground);
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .about-parental-artwork {
    width: min(100%, 17.25rem);
    justify-self: center;
    align-self: center;
  }

  .about-parental-artwork img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-parental-list strong {
    font-weight: 400;
  }

  .about-parental-uses {
    display: grid;
    gap: 2rem;
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    border-radius: 1rem;
    padding: 1.625rem;
    background: #e2e7d9;
    color: #2f382b;
    font-size: 1rem;
  }

  .about-parental-uses-header {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: start;
    gap: 1.75rem;
  }

  .about-parental-subtitle {
    max-width: 15ch;
    margin: 0;
    scroll-margin-block-start: calc(var(--site-header-clearance) + 5rem);
    font-size: clamp(1.875rem, 8.7vw, 2.125rem);
    font-weight: 400;
    line-height: 1.13;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .about-parental-subtitle em {
    color: #526347;
    font-weight: 400;
  }

  .about-parental-uses-artwork {
    display: block;
    width: min(100%, 18rem);
    height: auto;
    align-self: center;
  }

  .about-parental-room {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-parental-stars {
    display: block;
    width: min(82%, 15rem);
    height: auto;
    margin: 0 auto -0.75rem;
  }

  .about-parental-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-parental-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: start;
    column-gap: 0.75rem;
    border-block-start: 1px solid #bac5af;
    padding-block: 1.125rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .about-parental-bullet {
    display: block;
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .about-parental-list li:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .about-parental-list li:last-child {
    padding-block-end: 0;
  }

  .about-parental-disclaimer {
    display: grid;
    gap: 1.5rem clamp(2.5rem, 6vw, 5rem);
    margin-block-start: clamp(2rem, 4vw, 3rem);
    border-block-start: 1px solid
      color-mix(in oklch, var(--foreground) 16%, transparent);
    padding-block-start: 1.25rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .about-studies-list {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 0;
    list-style: none;
  }

  .profile-portrait :global(picture),
  .profile-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .profile-portrait :global(img) {
    object-fit: cover;
    position: absolute;
    bottom: 0;
    height: 130%;
    object-position: center bottom;
  }

  @media (width < 48rem) {
    .about-page::before {
      background-position: left top;
    }

    .about-title {
      font-size: 1.75rem;
    }

    .about-support-title {
      font-size: clamp(1.75rem, 5vw, 2.125rem);
      line-height: 1.4;
    }

    .about-parental {
      margin-inline: calc(-1 * var(--page-gutter));
      border-radius: 0;
      padding-inline: var(--page-gutter);
    }
  }

  @media (min-width: 48rem) {
