---
import ContactForm from "../components/contact/ContactForm.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: in review after adding the minimal contact form. Practical,
// privacy and retention wording require Silvia's final review before launch.
---

<BaseLayout
  title="Contact"
  description="Contactați-o pe Silvia Dinu pentru a întreba despre disponibilitatea pentru psihoterapie psihanalitică și consiliere, în București sau online."
  footerFlush
>
  <section class="contact-letter-section" data-contact-section>
    <Container>
      <article class="contact-letter" data-contact-letter>
        <div class="contact-letter__recipient">
          <span class="contact-letter__recipient-label">Către</span>
          <span class="contact-letter__recipient-name">Silvia Dinu</span>
        </div>

        <div class="contact-letter__layout">
          <header class="contact-letter__intro">
            <h1 class="contact-letter__title">
              Solicitați o întâlnire preliminară.
            </h1>
            <p class="contact-letter__opening">
              Dacă doriți să aflați mai multe sau să stabilim o primă întâlnire,
              îmi puteți scrie și pe adresa de email
              {" "}
              <a
                href="mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire"
                >silvia.drn@gmail.com</a
              >.
            </p>

            <figure class="contact-letter__map" data-contact-map>
              <div
                class="contact-letter__map-placeholder"
                data-contact-map-placeholder
              >
                <div>
                  <p class="contact-letter__map-eyebrow">În cabinet</p>
                  <p class="contact-letter__map-area">
                    București, zona Piața Victoriei / Banu Manta
                  </p>
                </div>
                <button
                  class="contact-letter__map-button"
                  type="button"
                  data-contact-map-load
                >
                  Încărcați harta Google
                </button>
                <p class="contact-letter__map-note">
                  Conexiunea către Google pornește numai după ce apăsați
                  butonul.
                </p>
              </div>
              <iframe
                class="contact-letter__map-frame"
                title="Google Maps — zona Piața Victoriei / Banu Manta"
                data-contact-map-frame
                data-src="https://www.google.com/maps?ll=44.4553,26.0806&z=15&hl=ro&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer"
                allowfullscreen
                hidden></iframe>
              <figcaption class="sr-only">
                Hartă orientativă pentru zona Piața Victoriei / Banu Manta din
                București. Adresa exactă nu este publicată pe website.
              </figcaption>
              <noscript>
                <p class="contact-letter__map-noscript">
                  <a
                    href="https://www.google.com/maps/search/?api=1&query=Pia%C8%9Ba%20Victoriei%20Banu%20Manta%20Bucure%C8%99ti"
                    target="_blank"
                    rel="noopener noreferrer">Deschideți zona în Google Maps</a
                  >.
                </p>
              </noscript>
            </figure>
          </header>

          <div class="contact-letter__form">
            <h2 id="formular-contact" class="sr-only">Formular de contact</h2>
            <ContactForm />
          </div>
        </div>
      </article>
    </Container>
  </section>
</BaseLayout>

<style>
  .contact-letter-section {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(
        circle at 15% 10%,
        color-mix(in oklch, var(--secondary) 72%, transparent),
        transparent 36rem
      ),
      color-mix(in oklch, var(--muted) 52%, var(--background));
  }

  .contact-letter {
    position: relative;
    isolation: isolate;
    max-width: 68rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--card);
    padding: clamp(1.5rem, 5vw, 4.5rem);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--foreground) 8%, transparent),
      0 0.25rem 1rem color-mix(in oklch, var(--foreground) 4%, transparent),
      0 1.75rem 4.5rem color-mix(in oklch, var(--foreground) 9%, transparent);
  }

  .contact-letter::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        color-mix(in oklch, var(--background) 34%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 82% 18%,
        color-mix(in oklch, var(--foreground) 1.8%, transparent),
        transparent 28rem
      );
    content: "";
    pointer-events: none;
  }

  .contact-letter__recipient {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid
      color-mix(in oklch, var(--border) 72%, transparent);
  }

  .contact-letter__recipient-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-letter__recipient-name {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
  }

  .contact-letter__layout {
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
    padding-block-start: clamp(2.25rem, 5vw, 4.5rem);
  }

  .contact-letter__intro {
    max-width: 32rem;
  }

  .contact-letter__title {
    max-width: 10ch;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .contact-letter__opening {
    max-width: 36ch;
    margin-block-start: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--muted-foreground);
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.65;
  }

  .contact-letter__opening a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact-letter__map {
    overflow: hidden;
    margin-block-start: clamp(2rem, 5vw, 3rem);
    border: 1px solid color-mix(in oklch, var(--border) 78%, transparent);
    border-radius: var(--radius-lg);
    background: var(--muted);
  }

  .contact-letter__map-placeholder {
    display: grid;
    min-height: clamp(16rem, 30vw, 20rem);
    align-content: end;
    gap: 1rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background:
      linear-gradient(
        135deg,
        transparent 0 42%,
        color-mix(in oklch, var(--foreground) 8%, transparent) 42% 43%,
        transparent 43% 100%
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 3.5rem,
        color-mix(in oklch, var(--foreground) 5%, transparent) 3.5rem
          calc(3.5rem + 1px)
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 3.5rem,
        color-mix(in oklch, var(--foreground) 5%, transparent) 3.5rem
          calc(3.5rem + 1px)
      ),
      color-mix(in oklch, var(--secondary) 64%, var(--card));
  }

  .contact-letter__map-eyebrow {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-letter__map-area {
    max-width: 24ch;
    margin-block-start: 0.35rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    line-height: 1.35;
  }

  .contact-letter__map-button {
    display: inline-flex;
    min-height: 2.75rem;
    width: fit-content;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--foreground);
    border-radius: var(--radius-md);
    background: var(--foreground);
    color: var(--background);
    padding: 0.65rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color var(--duration-exit) var(--ease-out),
      color var(--duration-exit) var(--ease-out);
  }

  .contact-letter__map-button:hover {
    background: transparent;
    color: var(--foreground);
  }

  .contact-letter__map-note,
  .contact-letter__map-noscript {
    max-width: 32ch;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .contact-letter__map-frame {
    display: block;
    width: 100%;
    min-height: clamp(16rem, 30vw, 20rem);
    border: 0;
    filter: grayscale(1) saturate(0) contrast(0.88) brightness(1.08);
  }

  .contact-letter__map-placeholder[hidden],
  .contact-letter__map-frame[hidden] {
    display: none;
  }

  .contact-letter__form {
    min-width: 0;
  }

  @media (min-width: 56rem) {
    .contact-letter__layout {
      grid-template-columns: minmax(18rem, 0.95fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-contact-map]")
    .forEach((map) => {
      const loadButton = map.querySelector<HTMLButtonElement>(
        "[data-contact-map-load]",
      );
      const placeholder = map.querySelector<HTMLElement>(
        "[data-contact-map-placeholder]",
      );
      const frame = map.querySelector<HTMLIFrameElement>(
        "[data-contact-map-frame]",
      );

      loadButton?.addEventListener("click", () => {
        const source = frame?.dataset.src;
        if (!frame || !source) return;

        frame.src = source;
        frame.hidden = false;
        placeholder?.setAttribute("hidden", "");
        frame.focus({ preventScroll: true });
      });
    });
</script>
