---
import GuidedReflection from "../components/islands/GuidedReflection";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. The guided reflection is non-diagnostic and requires
// Silvia's review before publication.
---

<BaseLayout
  title="Despre sine: Reflecție ghidată"
  description="O reflecție ghidată anonimă despre felul în care o dificultate se poate face vizibilă în corp, în stări emoționale sau în relații."
>
  <section class="border-line border-b py-(--section-space)">
    <Container>
      <h1
        class="max-w-5xl text-[clamp(3.25rem,10vw,8rem)] leading-[0.92] tracking-[-0.045em]"
      >
        Ce pare să ceară atenție acum?
      </h1>

      <div class="mt-10">
        <p class="text-muted max-w-2xl text-lg leading-8 md:text-xl">
          O reflecție scurtă pentru momentele în care dificultatea nu este încă
          ușor de formulat. Parcursul poate ajuta la observarea locului în care
          ceva se face vizibil: în corp, în stări emoționale sau în relații.
        </p>
      </div>
    </Container>
  </section>

  <GuidedReflection client:load />

  <section class="py-(--section-space)">
    <Container
      class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <h2
          class="max-w-3xl text-4xl leading-tight tracking-[-0.035em] md:text-6xl"
        >
          Rezultatul poate fi un punct de pornire, nu o concluzie.
        </h2>
        <p class="text-muted mt-5 max-w-xl text-lg leading-8">
          Dacă o întrebare rămâne importantă, puteți trimite un mesaj scurt. Nu
          este necesar să descrieți detalii sensibile în primul contact.
        </p>
      </div>
      <ActionLink href="/contact/">Scrieți pentru o primă discuție</ActionLink>
    </Container>
  </section>
</BaseLayout>
