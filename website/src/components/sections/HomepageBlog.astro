---
import { IconArrowRight } from "@tabler/icons-react";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";

import cardBody from "../../assets/homepage/card-body.png";
import Container from "../ui/Container.astro";

const cardBodyOptimized = await getImage({
  src: cardBody,
  width: 720,
  format: "webp",
  quality: 75,
});

const publishedPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const publishedPreviews = publishedPosts.map((post) => ({
  id: `homepage-blog-${post.id}`,
  title: post.data.title,
  description: post.data.description,
  href: `/blog/${post.id}/`,
  imageSrc: post.data.cover?.src ?? cardBodyOptimized.src,
  imageWidth: post.data.cover?.width ?? cardBody.width,
  imageHeight: post.data.cover?.height ?? cardBody.height,
  tone: post.data.cover ? "cover" : "body",
}));
---

{
  publishedPreviews.length > 0 && (
    <section class="homepage-blog" aria-labelledby="homepage-blog-title">
      <Container>
        <h2
          id="homepage-blog-title"
          class="section-title homepage-blog__heading"
        >
          Blog
        </h2>

        <div
          class:list={[
            "homepage-blog__articles",
            {
              "homepage-blog__articles--featured":
                publishedPreviews.length === 1,
            },
          ]}
          style={`--article-count: ${publishedPreviews.length}`}
        >
          {publishedPreviews.map((preview) => (
            <article class="homepage-blog__article">
              <a
                class="homepage-blog__article-link"
                href={preview.href}
                aria-labelledby={preview.id}
              >
                <div class="homepage-blog__visual" data-tone={preview.tone}>
                  <img
                    src={preview.imageSrc}
                    width={preview.imageWidth}
                    height={preview.imageHeight}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="homepage-blog__copy">
                  <h3 class="homepage-blog__article-title" id={preview.id}>
                    {preview.title}
                  </h3>
                  <p class="homepage-blog__description">
                    {preview.description}
                  </p>
                  <span class="homepage-blog__read">
                    <span>Citiți articolul</span>
                    <IconArrowRight size={20} stroke={1.5} aria-hidden="true" />
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </Container>
    </section>
  )
}

<style>
  .homepage-blog {
    background: var(--background);
    padding-block: var(--section-space-compact);
  }

  .homepage-blog__heading {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .homepage-blog__articles {
    display: grid;
    grid-template-columns: repeat(var(--article-count), minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .homepage-blog__article-link {
    display: grid;
    gap: 1.5rem;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-lg);
  }

  .homepage-blog__article-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 6px;
  }

  .homepage-blog__visual {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 10;
    place-items: center;
    overflow: hidden;
    border-radius: 1rem;
    background: color-mix(in oklch, var(--secondary), var(--background) 35%);
  }

  .homepage-blog__visual img {
    width: 66%;
    height: 76%;
    object-fit: contain;
  }

  .homepage-blog__visual[data-tone="cover"] img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .homepage-blog__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
    min-width: 0;
  }

  .homepage-blog__article-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .homepage-blog__description {
    max-width: 44ch;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .homepage-blog__read {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    color: var(--primary);
    font-size: 1rem;
  }

  .homepage-blog__read > span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .homepage-blog__read :global(svg) {
    flex-shrink: 0;
    transition: transform var(--duration-state) var(--ease-out);
  }

  .homepage-blog__articles--featured .homepage-blog__article-link {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .homepage-blog__articles--featured .homepage-blog__visual {
    aspect-ratio: 1;
  }

  .homepage-blog__articles--featured .homepage-blog__copy {
    gap: 1.5rem;
  }

  .homepage-blog__articles--featured .homepage-blog__article-title {
    max-width: 22ch;
    font-size: clamp(1.75rem, 3.4vw, 2.625rem);
  }

  .homepage-blog__articles--featured .homepage-blog__description {
    font-size: 1.125rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-blog__article-link:hover .homepage-blog__read :global(svg) {
      transform: translateX(0.25rem);
    }

    .homepage-blog__article-link:hover .homepage-blog__read > span {
      text-decoration-thickness: 2px;
    }
  }

  @media (width < 64rem) {
    .homepage-blog__articles {
      grid-template-columns: repeat(
        min(var(--article-count), 2),
        minmax(0, 1fr)
      );
    }
  }

  @media (width < 48rem) {
    .homepage-blog__articles,
    .homepage-blog__articles--featured .homepage-blog__article-link {
      grid-template-columns: 1fr;
    }

    .homepage-blog__articles {
      gap: 3rem;
    }

    .homepage-blog__articles--featured .homepage-blog__article-link {
      gap: 1.75rem;
    }

    .homepage-blog__articles--featured .homepage-blog__visual {
      aspect-ratio: 4 / 3;
    }

    .homepage-blog__articles--featured .homepage-blog__copy {
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-blog__read :global(svg) {
      transition: none;
      transform: none !important;
    }
  }
</style>
