---
import { IconArrowRight } from "@tabler/icons-react";

import Container from "../ui/Container.astro";

const psychotherapyHref = "/psihoterapie-si-consiliere/";
---

<section
  class="homepage-psychodynamic"
  aria-labelledby="homepage-psychodynamic-title"
>
  <Container>
    <a
      class="homepage-psychodynamic__link"
      href={psychotherapyHref}
      aria-label="Despre psihoterapia psihodinamică"
      data-homepage-psychodynamic
    >
      <div class="homepage-psychodynamic__copy">
        <h2 id="homepage-psychodynamic-title">
          Despre psihoterapia psihodinamică
        </h2>
        <p>
          Sprijinul prietenilor și al familiei contează, dar uneori nu este
          suficient pentru a desluși ceea ce se repetă, apasă sau rămâne greu de
          pus în cuvinte. Psihoterapia oferă un cadru în care vă puteți apropia
          treptat de aceste dificultăți, alături de un profesionist.
        </p>
        <span class="homepage-psychodynamic__cta">
          Citiți mai mult
          <IconArrowRight aria-hidden="true" />
        </span>
      </div>

      <div class="homepage-psychodynamic__graphic" aria-hidden="true">
        <svg viewBox="0 0 520 440" fill="none">
          <path
            class="homepage-psychodynamic__contour"
            d="M-48 80C38 18 133 3 214 41C296 79 309 160 393 183C457 201 519 173 570 119"
          ></path>
          <path
            class="homepage-psychodynamic__contour"
            d="M-54 129C26 67 122 45 202 76C284 108 307 184 384 210C452 233 519 210 575 160"
          ></path>
          <path
            class="homepage-psychodynamic__contour"
            d="M-62 181C14 119 109 91 191 112C276 134 304 207 374 237C442 266 513 252 579 207"
          ></path>
          <path
            class="homepage-psychodynamic__contour"
            d="M-67 236C4 174 95 138 179 148C264 158 299 226 364 263C428 300 501 296 582 260"
          ></path>
          <path
            class="homepage-psychodynamic__contour"
            d="M-70 292C-4 234 78 190 165 185C251 181 291 245 351 287C409 329 482 341 583 317"
          ></path>
          <path
            class="homepage-psychodynamic__contour homepage-psychodynamic__contour--strong"
            d="M-68 348C-8 298 65 247 149 222C232 198 279 261 337 310C391 356 463 384 580 374"
          ></path>
          <path
            class="homepage-psychodynamic__thread"
            d="M121 456C129 386 170 350 224 320C284 286 322 238 318 181C315 130 280 92 231 78"
          ></path>
          <path
            class="homepage-psychodynamic__thread homepage-psychodynamic__thread--fine"
            d="M190 461C188 402 218 368 265 334C326 290 360 240 347 176C337 126 305 92 260 68"
          ></path>
          <circle cx="320" cy="184" r="8" class="homepage-psychodynamic__point"
          ></circle>
          <circle cx="320" cy="184" r="24" class="homepage-psychodynamic__ring"
          ></circle>
        </svg>
      </div>
    </a>
  </Container>
</section>

<style>
  .homepage-psychodynamic {
    border-bottom: 1px solid var(--border);
    padding-block: var(--section-space);
    background: color-mix(in oklch, var(--muted) 42%, var(--background));
  }

  .homepage-psychodynamic__link {
    display: grid;
    max-width: 58.75rem;
    min-height: 25rem;
    grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    overflow: hidden;
    margin-inline: auto;
    border-block: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .homepage-psychodynamic__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-psychodynamic__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--background);
  }

  .homepage-psychodynamic h2 {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .homepage-psychodynamic p {
    max-width: 37rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.72;
  }

  .homepage-psychodynamic__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .homepage-psychodynamic__cta :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform var(--duration-state) var(--ease-state);
  }

  .homepage-psychodynamic__graphic {
    position: relative;
    display: grid;
    min-width: 0;
    overflow: hidden;
    background: color-mix(in oklch, var(--chart-1) 22%, var(--card));
    place-items: center;
  }

  .homepage-psychodynamic__graphic::after {
    position: absolute;
    inset: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid color-mix(in oklch, var(--chart-4) 18%, transparent);
    border-radius: 50%;
    content: "";
  }

  .homepage-psychodynamic__graphic svg {
    width: 118%;
    height: 118%;
    transform: translate3d(2%, 1%, 0);
    transition: transform var(--duration-panel) var(--ease-out);
  }

  .homepage-psychodynamic__contour,
  .homepage-psychodynamic__thread,
  .homepage-psychodynamic__ring {
    vector-effect: non-scaling-stroke;
  }

  .homepage-psychodynamic__contour {
    stroke: color-mix(in oklch, var(--chart-4) 32%, var(--border));
    stroke-width: 1.25;
  }

  .homepage-psychodynamic__contour--strong,
  .homepage-psychodynamic__thread {
    stroke: var(--chart-4);
  }

  .homepage-psychodynamic__thread {
    stroke-linecap: round;
    stroke-width: 2;
  }

  .homepage-psychodynamic__thread--fine {
    opacity: 0.55;
    stroke-width: 1;
  }

  .homepage-psychodynamic__point {
    fill: var(--chart-4);
  }

  .homepage-psychodynamic__ring {
    stroke: color-mix(in oklch, var(--chart-4) 38%, transparent);
    stroke-width: 1;
  }

  .homepage-psychodynamic__link:hover .homepage-psychodynamic__graphic svg,
  .homepage-psychodynamic__link:focus-visible
    .homepage-psychodynamic__graphic
    svg {
    transform: translate3d(0, 0, 0) scale(1.015);
  }

  .homepage-psychodynamic__link:hover .homepage-psychodynamic__cta :global(svg),
  .homepage-psychodynamic__link:focus-visible
    .homepage-psychodynamic__cta
    :global(svg) {
    transform: translateX(0.2rem);
  }

  @media (max-width: 47rem) {
    .homepage-psychodynamic__link {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .homepage-psychodynamic__copy {
      padding: clamp(1.75rem, 7vw, 2.5rem);
    }

    .homepage-psychodynamic__graphic {
      min-height: 17rem;
    }

    .homepage-psychodynamic__graphic svg {
      width: 108%;
      height: 108%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-psychodynamic__graphic svg,
    .homepage-psychodynamic__cta :global(svg) {
      transition: none;
    }
  }
</style>
