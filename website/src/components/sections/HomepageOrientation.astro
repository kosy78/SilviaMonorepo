---
import ActionLink from "../ui/ActionLink.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../ui/card";
import Container from "../ui/Container.astro";
import { Separator } from "../ui/separator";
import { Tag } from "../ui/tag";

const startingPoints = [
  {
    title: "Stări emoționale și manifestări ale corpului",
    description:
      "Anxietate și neliniște, stări depresive sau manifestări psihosomatice.",
  },
  {
    title: "Relații, identitate și stimă de sine",
    description:
      "Dificultăți relaționale, situații care se repetă sau întrebări despre felul în care vă raportați la dumneavoastră și la ceilalți.",
  },
  {
    title: "Schimbări și tranziții de viață",
    description:
      "Perioade în care rolurile, relațiile sau reperele obișnuite se schimbă.",
  },
] as const;
---

<section
  class="homepage-orientation"
  aria-labelledby="homepage-orientation-title"
>
  <Container>
    <Card className="homepage-orientation__card">
      <CardHeader className="homepage-orientation__intro">
        <div>
          <Tag variant="section">Psihoterapie</Tag>
          <CardTitle asChild>
            <h2 id="homepage-orientation-title" class="section-title">
              Psihoterapie psihanalitică și consiliere
            </h2>
          </CardTitle>
        </div>

        <CardDescription className="homepage-orientation__lead">
          Punctul de plecare poate fi o dificultate pe care o puteți numi sau
          doar sentimentul că ceva important are nevoie de atenție. Nu este
          necesar să aveți de la început o explicație sau o concluzie.
        </CardDescription>
      </CardHeader>

      <Separator />

      <CardContent className="homepage-orientation__areas">
        {
          startingPoints.map((item, index) => (
            <>
              {index > 0 && (
                <>
                  <Separator
                    orientation="vertical"
                    className="homepage-orientation__separator homepage-orientation__separator--wide"
                  />
                  <Separator className="homepage-orientation__separator homepage-orientation__separator--narrow" />
                </>
              )}
              <article>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            </>
          ))
        }
      </CardContent>

      <CardFooter className="homepage-orientation__action">
        <ActionLink href="/psihoterapie-si-consiliere/" variant="secondary">
          Despre psihoterapie și consiliere
        </ActionLink>
      </CardFooter>
    </Card>
  </Container>
</section>

<style>
  .homepage-orientation {
    border-bottom: 1px solid var(--border);
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-orientation__card {
    --card-spacing: clamp(1.75rem, 4vw, 3.5rem);

    gap: 0;
  }

  .homepage-orientation__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-bottom: var(--card-spacing);
  }

  .homepage-orientation__intro .section-title {
    margin-top: 1.5rem;
  }

  .homepage-orientation__lead {
    max-width: 42rem;
    align-self: end;
    color: var(--foreground);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .homepage-orientation__areas {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) auto minmax(0, 1fr) auto
      minmax(0, 1fr);
    padding-block: var(--card-spacing);
  }

  .homepage-orientation__areas article {
    padding-inline: clamp(0rem, 2vw, 2rem);
  }

  .homepage-orientation__areas h3 {
    max-width: 16ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .homepage-orientation__areas p {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .homepage-orientation__action {
    justify-content: flex-start;
  }

  .homepage-orientation__separator--narrow {
    display: none;
  }

  @media (max-width: 56rem) {
    .homepage-orientation__intro {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47rem) {
    .homepage-orientation__areas {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .homepage-orientation__areas article {
      padding-block: 1.75rem;
      padding-inline: 0;
    }

    .homepage-orientation__separator--wide {
      display: none;
    }

    .homepage-orientation__separator--narrow {
      display: block;
    }

    .homepage-orientation__action :global(a) {
      width: 100%;
    }
  }
</style>
