---
import { Picture } from "astro:assets";

import silviaPortrait from "../../assets/homepage/silvia-dinu-portrait.jpeg";
import Container from "../ui/Container.astro";
import { Tag } from "../ui/tag";

const aboutHref = "/competente/";
---

<section class="homepage-about" id="cum-lucrez">
  <Container>
    <a
      class="homepage-about__link"
      href={aboutHref}
      aria-label="Formarea, orientarea și experiența Silviei Dinu"
      data-homepage-about
    >
      <figure class="homepage-about__card">
        <div class="homepage-about__copy">
          <div class="homepage-about__statement">
            <Tag variant="section">Competențe</Tag>
            <h2 class="homepage-about__title">Silvia Dinu</h2>
            <blockquote>
              Am avut norocul ca întâlnirea mea cu psihanaliza să se întâmple
              devreme, la scurt timp după terminarea facultății de Psihologie.
              Am pornit pe acest drum cu multă curiozitate, fără să știu la ce
              să mă aștept.
            </blockquote>
          </div>

          <figcaption>
            <strong>Silvia Dinu</strong>
            <span>
              Psihoterapeut psihanalitic<br />
              Peste 10 ani de experiență
            </span>
          </figcaption>
        </div>

        <div class="homepage-about__portrait">
          <Picture
            src={silviaPortrait}
            formats={["avif", "webp"]}
            widths={[384, 768]}
            sizes="(max-width: 47rem) calc(100vw - 2.5rem), 28rem"
            quality={84}
            alt="Silvia Dinu"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </a>
  </Container>
</section>

<style>
  .homepage-about {
    border-bottom: 1px solid var(--border);
    padding-block: var(--section-space);
  }

  .homepage-about__link {
    display: block;
    width: 100%;
    margin-inline: auto;
    border-radius: var(--radius-xl);
    color: inherit;
    text-decoration: none;
  }

  .homepage-about__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-about__card {
    display: grid;
    min-height: 24.9375rem;
    grid-template-columns: minmax(0, 3fr) minmax(17rem, 2fr);
    overflow: hidden;
    margin: 0;
    border-radius: inherit;
    background: var(--muted);
    transition: transform var(--duration-state) var(--ease-out);
  }

  .homepage-about__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    gap: 2.375rem;
    padding: 2.3125rem;
  }

  .homepage-about__statement {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .homepage-about__statement blockquote {
    max-width: 29.5rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .homepage-about__title {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .homepage-about__copy figcaption {
    display: flex;
    max-width: 31rem;
    flex-direction: column;
    gap: 0.875rem;
  }

  .homepage-about__copy strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .homepage-about__copy figcaption span {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .homepage-about__portrait {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .homepage-about__portrait :global(picture),
  .homepage-about__portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-about__portrait :global(img) {
    object-fit: cover;
    object-position: center top;
    transition: transform var(--duration-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-about__link:hover .homepage-about__card {
      box-shadow: 0 0 0 1px var(--border);
      transform: translateY(-2px);
    }

    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: scale(1.015);
    }
  }

  @media (max-width: 47rem) {
    .homepage-about__card {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .homepage-about__copy {
      gap: 2rem;
      padding: clamp(1.75rem, 7vw, 2.5rem);
    }

    .homepage-about__portrait {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .homepage-about__portrait :global(img) {
      object-position: center 30%;
    }
  }

  @media (max-width: 25rem) {
    .homepage-about__statement blockquote {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-about__card,
    .homepage-about__portrait :global(img) {
      transition: none;
    }

    .homepage-about__link:hover .homepage-about__card,
    .homepage-about__link:hover .homepage-about__portrait :global(img) {
      transform: none;
    }
  }
</style>
