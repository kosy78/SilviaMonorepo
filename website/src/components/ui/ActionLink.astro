---
import { IconMail } from "@tabler/icons-react";

import { buttonVariants } from "./button";

interface Props {
  href: string;
  variant?:
    "primary" | "secondary" | "heroPrimary" | "heroSecondary" | "reflection";
  icon?: "mail";
  size?: "default" | "lg";
}

const { href, variant = "primary", icon, size = "default" } = Astro.props;

const variants = {
  primary: "default",
  secondary: "outline",
  heroPrimary: "default",
  heroSecondary: "outline",
  reflection: "default",
} as const;
---

<a
  href={href}
  data-slot="button"
  data-variant={variants[variant]}
  data-size={size}
  class={buttonVariants({ variant: variants[variant], size })}
>
  {icon === "mail" && <IconMail data-icon="inline-start" aria-hidden="true" />}
  <slot />
</a>
