---
import { IconArrowRight } from "@tabler/icons-react";
import ActionLink from "../ui/ActionLink.astro";
import Container from "../ui/Container.astro";
---

<section
  class="homepage-closing"
  aria-labelledby="homepage-closing-title"
  data-homepage-closing
>
  <Container>
    <div class="homepage-closing__stage">
      <div class="homepage-closing__media" aria-hidden="true">
        <video
          data-homepage-closing-video
          muted
          loop
          playsinline
          preload="none"
          poster="/videos/homepage-closing-leaf-shadows-poster.jpg"
        >
          <source
            src="/videos/homepage-closing-leaf-shadows.mp4"
            type="video/mp4"
          />
        </video>
      </div>
      <div class="homepage-closing__content">
        <h2 id="homepage-closing-title" class="section-title">
          Solicitați o întâlnire preliminară.
        </h2>
        <p class="homepage-closing__intro">
          Dacă aveți și alte întrebări sau doriți să stabilim o primă întâlnire,
          îmi puteți scrie și pe adresa de email <a
            href="mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire"
            >silvia.drn@gmail.com</a
          >.
        </p>
        <div class="homepage-closing__action">
          <ActionLink href="/contact/" size="lg">
            Solicitați o întâlnire preliminară
            <IconArrowRight data-icon="inline-end" aria-hidden="true" />
          </ActionLink>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .homepage-closing {
    background: #f1ede6;
    padding-block: clamp(4rem, 8.5vw, 7.5rem);
    overflow-x: clip;
  }

  .homepage-closing__stage {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .homepage-closing__media {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc(50% - 50vw);
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: multiply;
    mask-image:
      linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent),
      linear-gradient(to right, transparent, #000 5%, #000 95%, transparent),
      radial-gradient(
        ellipse 32rem 60% at center,
        rgb(0 0 0 / 72%) 45%,
        #000 100%
      );
    mask-composite: intersect;
    animation: homepage-closing-breathe 14s ease-in-out infinite;
  }

  .homepage-closing__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(0.25);
  }

  .homepage-closing__content {
    max-inline-size: 38rem;
    margin-inline: auto;
    text-align: center;
  }

  .homepage-closing h2 {
    margin-inline: auto;
    text-wrap: balance;
  }

  .homepage-closing__intro {
    margin-block-start: 1.5rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .homepage-closing__action {
    margin-block-start: 2rem;
  }

  .homepage-closing__intro a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .homepage-closing__action :global(a) {
    max-inline-size: 100%;
    white-space: normal;
  }

  @keyframes homepage-closing-breathe {
    0%,
    100% {
      opacity: 0.15;
    }

    50% {
      opacity: 0.27;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-closing__media {
      opacity: 0.2;
      animation: none;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>(
    "[data-homepage-closing-video]",
  );
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  if (video) {
    let inView = false;
    const sync = () => {
      if (inView && !prefersReducedMotion.matches) {
        video.playbackRate = 0.65;
        void video.play().catch(() => undefined);
      } else {
        video.pause();
      }
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry?.isIntersecting ?? false;
        sync();
      },
      { rootMargin: "200px 0px" },
    ).observe(video);
    prefersReducedMotion.addEventListener("change", sync);
  }
</script>
