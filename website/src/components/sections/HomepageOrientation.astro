---
import { Picture } from "astro:assets";
import { IconArrowRight } from "@tabler/icons-react";

import psychotherapyGraphic from "../../assets/homepage/psychotherapy-psychoanalysis.png";
import Container from "../ui/Container.astro";
import { Card } from "../ui/card";
---

<section
  class="homepage-orientation"
  aria-labelledby="homepage-orientation-title"
>
  <Container>
    <a
      class="homepage-orientation__link"
      data-psi-trigger
      href="/psihoterapie-si-consiliere/"
      aria-labelledby="homepage-orientation-title"
    >
      <Card className="homepage-orientation__card">
        <div class="homepage-orientation__image" aria-hidden="true">
          <Picture
            src={psychotherapyGraphic}
            formats={["avif", "webp"]}
            widths={[352, 528, 704]}
            sizes="(max-width: 56rem) min(18rem, calc(100vw - 6rem)), (max-width: 80rem) 34vw, 26rem"
            quality={86}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="homepage-orientation__layout">
          <header class="homepage-orientation__intro">
            <h2 id="homepage-orientation-title" class="heading-long">
              Despre Psihoterapia Psihanalitică
            </h2>

            <div class="homepage-orientation__summary">
              <p class="homepage-orientation__lead">
                Psihoterapia psihanalitică pornește din tradiția psihanalizei,
                dar este practicată astăzi într-o formă adaptată vieții și
                nevoilor <span class="homepage-orientation__lead-ending"
                  >contemporane.<IconArrowRight
                    data-icon="inline-end"
                    aria-hidden="true"
                  /></span
                >
              </p>
            </div>
          </header>
        </div>
      </Card>
    </a>
  </Container>
</section>

<style>
  .homepage-orientation {
    /* The transparent illustration sits within the card's shared surface. */
    --orientation-radius: var(--radius-xl);
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-orientation__link {
    display: block;
    width: 100%;
    border-radius: var(--orientation-radius);
    color: inherit;
    text-decoration: none;
  }

  .homepage-orientation__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-orientation__card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: center;
    width: 100%;
    min-block-size: 23rem;
    gap: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--orientation-radius);
    background: #f4ede3;
    padding: 0;
    color: #000;
    box-shadow: none;
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-orientation__image {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    inline-size: calc(100% - 3.25rem);
    margin-block: 2rem;
    margin-inline-end: 3.25rem;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .homepage-orientation__image :global(picture),
  .homepage-orientation__image :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-orientation__image :global(img) {
    object-fit: contain;
    object-position: center;
  }

  .homepage-orientation__layout {
    position: relative;
    display: flex;
    min-width: 0;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    align-items: center;
    padding-block: 2rem;
    padding-inline: 3.25rem 2rem;
  }

  .homepage-orientation__intro {
    display: grid;
    gap: 1.5rem;
  }

  .homepage-orientation__intro .heading-long {
    max-width: 16ch;
    color: #000;
    text-wrap: balance;
  }

  .homepage-orientation__summary {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }

  .homepage-orientation__lead {
    max-width: 32rem;
    color: #000;
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .homepage-orientation__lead-ending {
    white-space: nowrap;
  }

  .homepage-orientation__lead :global([data-icon="inline-end"]) {
    display: inline-block;
    width: 1.125rem;
    height: 1.125rem;
    margin-inline-start: 0.25rem;
    vertical-align: -0.2em;
    transition: transform var(--duration-state) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-orientation__link:hover .homepage-orientation__card {
      box-shadow: 0 0 0 1px var(--border);
      transform: translateY(-2px);
    }

    .homepage-orientation__link:hover
      .homepage-orientation__lead
      :global([data-icon="inline-end"]) {
      transform: translateX(0.2rem);
    }
  }

  @media (max-width: 56rem) {
    .homepage-orientation__card {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: auto;
    }

    .homepage-orientation__image {
      grid-column: 1;
      grid-row: 1;
      inline-size: min(18rem, calc(100% - 3rem));
      margin-block: 1.5rem 0;
      margin-inline: auto;
    }

    .homepage-orientation__layout {
      grid-column: 1;
      grid-row: 2;
      padding-block: 1.5rem 2rem;
      padding-inline: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-orientation__card,
    .homepage-orientation__lead :global([data-icon="inline-end"]) {
      transition: none;
    }

    .homepage-orientation__link:hover .homepage-orientation__card,
    .homepage-orientation__link:hover
      .homepage-orientation__lead
      :global([data-icon="inline-end"]) {
      transform: none;
    }
  }
</style>
