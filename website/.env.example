# TinaCloud credentials. Values are configured in TinaCloud and Cloudflare Pages,
# not committed to Git.
NEXT_PUBLIC_TINA_CLIENT_ID="your-tina-client-id"
TINA_TOKEN="your-tina-token"

# Optional local override. Cloudflare Pages provides CF_PAGES_BRANCH at build time.
NEXT_PUBLIC_TINA_BRANCH="main"

# Optional temporary build bypass while a TinaCloud branch is being indexed.
# Do not leave enabled once the branch is available in TinaCloud.
TINA_SKIP_CLOUD_CHECKS="0"
