---
import { Image } from "astro:assets";
import reflectionBackground from "../../assets/homepage/content-pixie-Px5UF7da7q4-unsplash.jpg";
import ExplorationPromoCard from "../ui/ExplorationPromoCard.astro";
import Container from "../ui/Container.astro";
---

<section class="homepage-areas" aria-labelledby="homepage-reflection-title">
  <Image
    class="homepage-areas__background"
    src={reflectionBackground}
    widths={[640, 960, 1512, 2016]}
    sizes="100vw"
    alt=""
    loading="lazy"
  />
  <Container>
    <ExplorationPromoCard />
  </Container>
</section>

<style>
  .homepage-areas {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 44.1875rem;
    padding-block: 7.625rem;
  }

  .homepage-areas :global([data-guided-reflection-promo]) {
    max-width: none;
  }

  .homepage-areas__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }

  @media (max-width: 56rem) {
    .homepage-areas {
      min-height: 0;
      padding-block: 4rem;
    }
  }
</style>
