---
import { Picture } from "astro:assets";
import { IconArrowRight } from "@tabler/icons-react";

import reflectionAccent from "../../assets/homepage/reflection-accent.jpg";
import ActionLink from "../ui/ActionLink.astro";
import Container from "../ui/Container.astro";
import { Card, CardContent } from "../ui/card";
---

<section class="homepage-areas" aria-labelledby="homepage-reflection-title">
  <Container>
    <Card className="homepage-reflection gap-0 py-0">
      <CardContent className="homepage-reflection__content">
        <h2 id="homepage-reflection-title">Ce pare să ceară atenție acum?</h2>
        <p>
          Șapte întrebări anonime, fără răspunsuri stocate. Rezultatul este
          orientativ, nu un diagnostic.
        </p>
        <ActionLink href="/reflectie-ghidata/" variant="reflection" size="lg">
          Începeți cu Primul Pas
          <IconArrowRight data-icon="inline-end" aria-hidden="true" />
        </ActionLink>
      </CardContent>
      <CardContent className="homepage-reflection__image p-0">
        <Picture
          src={reflectionAccent}
          formats={["avif", "webp"]}
          widths={[480, 720, 960]}
          sizes="(max-width: 767px) calc(100vw - 2.5rem), 46vw"
          quality={80}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </CardContent>
    </Card>
  </Container>
</section>

<style>
  .homepage-areas {
    padding-block: var(--section-space);
  }

  .homepage-reflection {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    margin-top: 0;
    background: color-mix(in oklch, var(--chart-1) 18%, var(--card));
  }

  .homepage-reflection__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .homepage-reflection h2 {
    max-width: 10ch;
    color: var(--chart-4);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 4.75rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .homepage-reflection p {
    max-width: 31rem;
    color: var(--foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .homepage-reflection__image {
    min-height: 28rem;
  }

  .homepage-reflection__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 47rem) {
    .homepage-reflection {
      grid-template-columns: 1fr;
    }

    .homepage-reflection__image {
      min-height: 18rem;
      grid-row: 1;
    }

    .homepage-reflection__content :global(a) {
      width: 100%;
    }
  }
</style>
