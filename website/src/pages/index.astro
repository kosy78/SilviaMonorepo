---
import { IconArrowRight } from "@tabler/icons-react";
import { Picture } from "astro:assets";

import practiceSky from "../assets/homepage/practice-sky.jpg";
import FaqList from "../components/sections/FaqList.astro";
import FirstSessionSection from "../components/sections/FirstSessionSection.astro";
import HomepageAbout from "../components/sections/HomepageAbout.astro";
import HomepageAreas from "../components/sections/HomepageAreas.astro";
import HomepageBlog from "../components/sections/HomepageBlog.astro";
import HomepageHero from "../components/sections/HomepageHero.astro";
import HomepageOrientation from "../components/sections/HomepageOrientation.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import { Card, CardFooter } from "../components/ui/card";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials, experience and practical wording require
// Silvia's review before publication.

const homepageFaqItems = [
  {
    question: "Despre ce voi vorbi în terapie?",
    answer:
      "Puteți vorbi despre orice vă preocupă sau vă afectează, chiar dacă nu știți încă exact cum să numiți problema. Poate fi ceva ce se întâmplă acum, o stare care revine, dificultăți în relații, o schimbare importantă sau pur și simplu senzația că nu vă mai simțiți bine cu felul în care merg lucrurile. Nu este nevoie ca problema să pară „destul de gravă” pentru a merita adusă în terapie. Dacă pentru dumneavoastră contează, are sens să vorbim despre ea.",
  },
  {
    question: "Ceea ce spun în terapie rămâne confidențial?",
    answer:
      "Da. Ceea ce discutăm în ședințe rămâne confidențial. Confidențialitatea este o parte esențială a cadrului terapeutic și oferă spațiul necesar pentru a putea vorbi cât mai liber despre ceea ce vă preocupă.",
  },
  {
    question: "Ședințele se pot desfășura și online?",
    answer:
      "Da. Ședințele pot avea loc atât în cabinet, cât și online. Vom stabili împreună care este opțiunea mai potrivită pentru dumneavoastră și pentru continuitatea procesului terapeutic.",
  },
  {
    question: "Cât durează o psihoterapie?",
    answer:
      "Nu există o durată potrivită pentru toată lumea. Psihoterapia psihanalitică presupune, de regulă, o explorare mai profundă a felului în care s-au format și se repetă anumite dificultăți, nu doar o intervenție asupra simptomelor prezente. Scopul este ca schimbările obținute să poată fi înțelese, integrate și menținute mult timp după încheierea terapiei.",
  },
] as const;

const directEmailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire";
---

<BaseLayout
  title="Psihoterapie psihanalitică în București și online"
  description="Psihoterapie psihanalitică și consiliere pentru adulți, tineri adulți și adolescenți de la 16 ani, în București, zona Piața Victoriei / Banu Manta, și online."
>
  <HomepageHero />
  <HomepageOrientation />
  <HomepageAreas />
  <HomepageAbout />

  <section
    class="homepage-faq"
    data-homepage-faq
    aria-labelledby="homepage-faq-title"
  >
    <Container>
      <div class="homepage-faq__layout">
        <header class="homepage-faq__intro">
          <h2 id="homepage-faq-title" class="section-title">
            Despre întâlnire și proces
          </h2>
          <p>Un spațiu pentru întrebări</p>
        </header>

        <div class="homepage-faq__questions">
          <FaqList items={homepageFaqItems} />
        </div>
      </div>
    </Container>
  </section>

  <HomepageBlog />

  <section class="homepage-practice" aria-labelledby="first-session-title">
    <div class="homepage-practice__background" aria-hidden="true">
      <Picture
        src={practiceSky}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1754]}
        sizes="100vw"
        quality={84}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="homepage-practice__foreground">
      <Container>
        <Card className="homepage-practice__card">
          <FirstSessionSection />

          <CardFooter className="homepage-practice__contact">
            <div
              class="homepage-practice__actions"
              data-homepage-practice-actions
            >
              <ActionLink
                href={directEmailHref}
                variant="secondary"
                icon="mail"
              >
                Scrieți-mi pe email
              </ActionLink>
              <ActionLink href="/contact/">
                Trimiteți un prim mesaj
                <IconArrowRight data-icon="inline-end" aria-hidden="true" />
              </ActionLink>
            </div>
          </CardFooter>
        </Card>
      </Container>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-faq {
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-faq__layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .homepage-faq__intro > p {
    max-width: 32rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--muted-foreground);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.8;
  }

  .homepage-faq__questions {
    min-width: 0;
  }

  @media (max-width: 56rem) {
    .homepage-faq__layout {
      grid-template-columns: 1fr;
    }
  }

  .homepage-practice {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--muted);
    padding-block: var(--section-space);
  }

  .homepage-practice::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--background) 14%, transparent),
      color-mix(in oklch, var(--background) 30%, transparent)
    );
    content: "";
    pointer-events: none;
  }

  .homepage-practice__background {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .homepage-practice__background :global(picture),
  .homepage-practice__background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-practice__background :global(img) {
    object-fit: cover;
    object-position: center 62%;
    outline: 1px solid color-mix(in oklch, var(--foreground) 10%, transparent);
    outline-offset: -1px;
  }

  .homepage-practice__foreground {
    position: relative;
    z-index: 2;
  }

  .homepage-practice__card {
    --card-spacing: clamp(1.5rem, 4vw, 3.5rem);

    gap: 0;
    padding-block: 0;
    background: color-mix(in oklch, var(--card) 90%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(90%);
    backdrop-filter: blur(12px) saturate(90%);
  }

  .homepage-practice__contact {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .homepage-practice__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 36rem) {
    .homepage-practice__actions {
      width: 100%;
      align-items: stretch;
      flex-direction: column;
    }

    .homepage-practice__actions :global(a) {
      width: 100%;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-practice__card {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
