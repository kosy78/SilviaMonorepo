---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;

const variants = {
  primary: "border-ink bg-ink text-paper hover:bg-paper hover:text-ink",
  secondary: "border-line bg-paper text-ink hover:border-ink",
};
---

<a
  href={href}
  class:list={[
    "inline-flex min-h-12 items-center justify-center border px-5 py-3 text-sm font-medium tracking-wide transition-colors",
    variants[variant],
  ]}
>
  <slot />
</a>
