{
  "name": "silvia-dinu-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\" --noTelemetry",
    "dev:astro": "astro dev",
    "build": "node scripts/build-tina.mjs && astro build",
    "build:astro": "astro build",
    "build:production": "TINA_REQUIRE_CLOUD=1 pnpm build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check",
    "test:functions": "node --test tests/functions/pages-function.test.mjs",
    "test:e2e": "pnpm build && pnpm test:functions && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "cf:whoami": "wrangler whoami",
    "deploy:cloudflare": "TINA_REQUIRE_CLOUD=1 pnpm build && wrangler pages deploy dist --project-name=silvia-dinu-website",
    "deploy:contact-mailer": "wrangler deploy --config workers/wrangler.contact-mailer.jsonc"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tinacms": "^3.10.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tinacms/cli": "^2.5.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
