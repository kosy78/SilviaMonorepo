---
import { Image } from "astro:assets";

import parentalRoomIllustration from "../../assets/competencies/parental-counseling-room-refined.png";
import parentalRoomStars from "../../assets/competencies/parental-room-stars.png";

// Copy status: draft. Adapted from the parental counseling section on
// /competente/; requires Silvia's review before publication.
// Rendered beside the Silvia Dinu card inside HomepageAbout.
---

<a
  class="homepage-parental__link"
  href="/competente/#consiliere-parentala"
  aria-labelledby="homepage-parental-title"
  aria-describedby="homepage-parental-lead"
  data-homepage-parental
>
  <article class="homepage-parental__card">
    <div class="homepage-parental__header">
      <h2 id="homepage-parental-title" class="homepage-parental__title">
        Consiliere <em>parentală</em>
      </h2>
      <div class="homepage-parental__artwork" aria-hidden="true">
        <Image
          class="homepage-parental__stars"
          src={parentalRoomStars}
          alt=""
          widths={[96, 160]}
          sizes="4.5rem"
          format="webp"
          loading="lazy"
          decoding="async"
        />
        <Image
          class="homepage-parental__room"
          src={parentalRoomIllustration}
          alt=""
          widths={[112, 224]}
          sizes="6.75rem"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <p id="homepage-parental-lead" class="homepage-parental__lead">
      Uneori, și părinții au nevoie de un spațiu în care să înțeleagă mai bine
      ce se întâmplă cu copilul sau adolescentul lor și ce ar putea ajuta
      relația dintre ei.
    </p>
  </article>
</a>

<style>
  /* Mirrors the Silvia Dinu card in HomepageAbout: same radius, padding,
     header row (title + image) and body type, in the parental palette. */
  .homepage-parental__link {
    --parental-surface: #e2e7d9;
    --parental-ink: #2f382b;
    --parental-accent: #526347;

    display: block;
    width: 100%;
    border-radius: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .homepage-parental__link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 4px;
  }

  .homepage-parental__card {
    display: grid;
    height: 100%;
    align-content: start;
    gap: 1.75rem;
    overflow: hidden;
    margin: 0;
    padding: 2.25rem 2.5rem;
    border-radius: inherit;
    background: var(--parental-surface);
    color: var(--parental-ink);
    transition:
      box-shadow var(--duration-state) var(--ease-out),
      transform var(--duration-state) var(--ease-out);
  }

  .homepage-parental__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .homepage-parental__title {
    min-width: 0;
    margin: 0;
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .homepage-parental__title em {
    color: var(--parental-accent);
    font-weight: 400;
  }

  /* Sized to match the Silvia Dinu portrait's height (5.5rem × 4/3). */
  .homepage-parental__artwork {
    display: grid;
    width: 6.75rem;
    flex-shrink: 0;
    justify-items: center;
  }

  .homepage-parental__artwork :global(img) {
    display: block;
    height: auto;
  }

  .homepage-parental__stars {
    width: 65%;
    margin-block-end: -0.5rem;
  }

  .homepage-parental__room {
    width: 100%;
  }

  .homepage-parental__lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* Share row tracks with the Silvia Dinu card so titles and body text sit
     on the same lines (see .homepage-about__grid). */
  @media (min-width: 60rem) {
    .homepage-parental__link {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
    }

    .homepage-parental__card {
      grid-row: span 2;
      grid-template-rows: subgrid;
      row-gap: 1.75rem;
    }

    .homepage-parental__header {
      align-items: start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .homepage-parental__link:hover .homepage-parental__card {
      box-shadow: 0 0 0 1px #bac5af;
      transform: translateY(-2px);
    }
  }

  @media (max-width: 43.75rem) {
    .homepage-parental__card {
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .homepage-parental__header {
      gap: 1rem;
    }

    .homepage-parental__title {
      font-size: 1.75rem;
    }

    .homepage-parental__artwork {
      width: 5.5rem;
    }

    .homepage-parental__lead {
      font-size: 1.125rem;
      letter-spacing: 0;
    }
  }

  @media (max-width: 22.4375rem) {
    .homepage-parental__card {
      padding: 1.25rem;
    }

    .homepage-parental__header {
      gap: 0.75rem;
    }

    .homepage-parental__title {
      font-size: 1.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .homepage-parental__card {
      transition: none;
    }

    .homepage-parental__link:hover .homepage-parental__card {
      transform: none;
    }
  }
</style>
