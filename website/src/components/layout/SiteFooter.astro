---
import { Image } from "astro:assets";
import logoVariant4 from "../../assets/brand/logo-variant-4.png";
import footerLeafShadows from "../../assets/footer/homepage-hero-leaf-shadows.jpg";
import acppbLogo from "../../assets/footer/affiliations/acpp-b.png";
import copsiLogo from "../../assets/footer/affiliations/colegiul-psihologilor.png";
import tituMaiorescuLogo from "../../assets/footer/affiliations/universitatea-titu-maiorescu.jpg";
import { cn } from "../../lib/utils";
import Container from "../ui/Container.astro";
import ActionLink from "../ui/ActionLink.astro";
import { buttonVariants } from "../ui/button";
import { Separator } from "../ui/separator";

interface Props {
  flush?: boolean;
  showMeetingAction?: boolean;
}

const { flush = false, showMeetingAction = true } = Astro.props;
const year = new Date().getFullYear();
const preliminaryMeetingEmailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20%C3%AEnt%C3%A2lnire%20preliminar%C4%83";
const instagramHref =
  "https://www.instagram.com/despre.sine?igsi=cWJwdWN1Z3dkNDcw";
const legalLinks = [
  {
    href: "/politica-de-confidentialitate/",
    label: "Politica de confidențialitate",
  },
  { href: "/politica-cookies/", label: "Politica de cookies" },
] as const;
const explorationLinks = [
  { href: "/", label: "Acasă" },
  {
    href: "/psihoterapie-si-consiliere/",
    label: "Psihoterapia psihanalitică",
  },
  { href: "/competente/", label: "Competențe" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
  { href: "/reflectie-ghidata/", label: "O primă explorare" },
] as const;
const footerLinks = [...explorationLinks, ...legalLinks] as const;
const affiliations = [
  {
    href: "https://www.utm.ro/facultatea-de-psihologie/",
    src: tituMaiorescuLogo,
    name: "Universitatea Titu Maiorescu, Facultatea de Psihologie",
    height: 64,
    restingOpacity: 0.5,
  },
  {
    href: "https://acppb.ro/",
    src: acppbLogo,
    name: "Asociația de Consiliere și Psihoterapie Psihanalitică din București (ACPP-B)",
    height: 44,
    restingOpacity: 0.72,
  },
  {
    href: "https://www.copsi.ro/",
    src: copsiLogo,
    name: "Colegiul Psihologilor din România",
    height: 60,
    restingOpacity: 0.72,
  },
] as const;
---

<footer
  class:list={["site-footer", flush && "site-footer--flush"]}
  data-site-footer
>
  <Container>
    <div class="site-footer__inner">
      <div class="site-footer__masthead">
        <a class="site-footer__brand" href="/">
          <div class="site-footer__mark" aria-hidden="true">
            <img
              class="site-footer__logo-default"
              src="/images/despresine-logo.png"
              alt=""
              width="52"
              height="52"
            />
            <Image
              class="site-footer__logo-color"
              src={logoVariant4}
              alt=""
              width={52}
              height={52}
              format="png"
              loading="lazy"
            />
          </div>
          <div>
            <p class="site-footer__name">DespreSine</p>
            <p class="site-footer__subtitle">Psihoterapeut Silvia Dinu</p>
          </div>
        </a>
        <div class="site-footer__masthead-actions">
          <a
            class={cn(
              buttonVariants({ variant: "secondary", size: "icon" }),
              "site-footer__instagram-link",
            )}
            href={instagramHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="DespreSine pe Instagram (se deschide într-o filă nouă)"
            data-footer-instagram
            data-slot="button"
            data-variant="secondary"
            data-size="icon"
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="4.75"
              ></rect>
              <circle cx="12" cy="12" r="4.15"></circle>
              <circle
                cx="17.45"
                cy="6.65"
                r="1"
                fill="currentColor"
                stroke="none"></circle>
            </svg>
          </a>
          {
            showMeetingAction && (
              <div class="site-footer__masthead-action">
                <ActionLink
                  href={preliminaryMeetingEmailHref}
                  variant="primary"
                  icon="mail"
                >
                  Solicitați o întâlnire preliminară
                </ActionLink>
              </div>
            )
          }
        </div>
      </div>

      <Separator className="site-footer__separator" />

      <nav class="site-footer__navigation" aria-label="Navigare în subsol">
        <ul class="site-footer__links">
          {
            footerLinks.map((item) => (
              <li>
                <a
                  class={cn(
                    buttonVariants({ variant: "link", size: "inline" }),
                    "justify-start",
                  )}
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              data-analytics-settings
              hidden
              class={cn(
                buttonVariants({ variant: "link", size: "inline" }),
                "justify-start",
              )}
            >
              Setări analytics
            </button>
          </li>
        </ul>
      </nav>

      <ul
        class="site-footer__affiliations"
        aria-label="Formare și atestare profesională"
        data-footer-affiliations
      >
        {
          affiliations.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.name} (se deschide într-o filă nouă)`}
              >
                <Image
                  src={item.src}
                  alt=""
                  height={item.height}
                  densities={[1, 2]}
                  loading="lazy"
                  decoding="async"
                  style={`--affiliation-height: ${item.height / 16}rem; --affiliation-opacity: ${item.restingOpacity}`}
                />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-footer__bottom">
        <p>© {year} Despre Sine - Psihoterapeut Silvia Dinu</p>
      </div>
    </div>
  </Container>

  <div class="site-footer__artwork" data-footer-artwork aria-hidden="true">
    <Image
      class="site-footer__background"
      src={footerLeafShadows}
      widths={[640, 832]}
      sizes="100vw"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  .site-footer {
    --site-footer-quiet: color-mix(
      in oklch,
      var(--foreground) 28%,
      var(--muted-foreground)
    );
    --site-footer-surface: #f1ede6;
    --site-footer-line: color-mix(
      in oklch,
      var(--border) 78%,
      var(--foreground) 6%
    );

    margin-top: var(--section-space);
    border-top: 1px solid var(--site-footer-line);
    background: var(--site-footer-surface);
    color: var(--foreground);
    padding-block: clamp(2.5rem, 4vw, 3.5rem) 0;
  }

  .site-footer--flush {
    margin-top: 0;
  }

  .site-footer__inner {
    container-name: site-footer;
    container-type: inline-size;
  }

  .site-footer__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .site-footer__brand {
    display: flex;
    justify-self: start;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .site-footer__mark {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: 0 0 0 1px
      color-mix(in oklch, var(--foreground) 10%, transparent);
  }

  .site-footer__mark img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity var(--duration-state) var(--ease-out);
  }

  .site-footer__logo-color {
    opacity: 0;
  }

  .site-footer__brand:focus-visible .site-footer__logo-default {
    opacity: 0;
  }

  .site-footer__brand:focus-visible .site-footer__logo-color {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__brand:hover .site-footer__logo-default {
      opacity: 0;
    }

    .site-footer__brand:hover .site-footer__logo-color {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__mark img {
      transition: none;
    }
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .site-footer__subtitle,
  .site-footer__bottom {
    color: var(--site-footer-quiet);
  }

  .site-footer__subtitle {
    font-size: 0.875rem;
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .site-footer__masthead-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.75rem;
  }

  .site-footer__masthead-action :global([data-slot="button"]:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  :global(.site-footer__separator) {
    background: var(--site-footer-line);
    margin-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.125rem;
    margin: 0;
    padding: 0;
  }

  .site-footer__links li {
    list-style: none;
  }

  .site-footer__links :global(a),
  .site-footer__links :global(button) {
    min-width: 2.75rem;
    font-size: 0.9375rem;
  }

  .site-footer__affiliations {
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 2.75rem);
    margin: clamp(3rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    background: var(--site-footer-surface);
  }

  .site-footer__affiliations li {
    list-style: none;
  }

  .site-footer__affiliations a {
    display: block;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    outline: none;
  }

  .site-footer__affiliations a:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .site-footer__affiliations img {
    display: block;
    width: auto;
    height: var(--affiliation-height);
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.05);
    opacity: var(--affiliation-opacity);
    transition:
      filter var(--duration-state) var(--ease-out),
      opacity var(--duration-state) var(--ease-out);
  }

  .site-footer__affiliations a:focus-visible img {
    filter: none;
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__affiliations a:hover img {
      filter: none;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__affiliations img {
      transition: none;
    }
  }

  .site-footer__bottom {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(2.25rem, 4vw, 2.75rem);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }

  .site-footer__artwork {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(16rem, 29.25vw, 35.375rem);
    padding-block: clamp(2.5rem, 5.63vw, 6.8125rem) clamp(1.5rem, 2.48vw, 3rem);
    overflow: hidden;
    pointer-events: none;
  }

  .site-footer__background {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .site-footer__artwork::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(to bottom, #f1ede6, rgb(241 237 230 / 66%));
  }

  @container site-footer (max-width: 58rem) {
    .site-footer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container site-footer (max-width: 40rem) {
    .site-footer__masthead {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__masthead-actions {
      width: 100%;
    }

    .site-footer__masthead-action {
      flex: 1;
      min-width: 0;
    }

    .site-footer__masthead-action :global(a) {
      width: 100%;
    }

    .site-footer__links {
      grid-template-columns: 1fr;
    }

    .site-footer__affiliations {
      gap: 0.5rem;
    }

    .site-footer__affiliations a {
      padding: 0.375rem;
    }

    .site-footer__affiliations img {
      height: calc(var(--affiliation-height) * 0.85);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-footer__masthead-action :global([data-slot="button"]) {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
