---
import { Picture } from "astro:assets";

import orientationBackground from "../../assets/homepage/psychotherapy-orientation-background.png";
import ActionLink from "../ui/ActionLink.astro";
import Container from "../ui/Container.astro";
---

<section
  class="homepage-orientation"
  aria-labelledby="homepage-orientation-title"
>
  <div class="homepage-orientation__atmosphere" aria-hidden="true">
    <Picture
      src={orientationBackground}
      formats={["avif", "webp"]}
      widths={[480, 768, 1024, 1280]}
      sizes="(max-width: 56rem) 100vw, min(46vw, 42rem)"
      quality={84}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>

  <Container class="homepage-orientation__container">
    <div class="homepage-orientation__layout">
      <header class="homepage-orientation__intro">
        <h2 id="homepage-orientation-title" class="section-title">
          Despre Psihoterapia Psihanalitică
        </h2>

        <div class="homepage-orientation__summary">
          <p class="homepage-orientation__lead">
            Psihoterapia psihanalitică este o formă contemporană de terapie care
            își are rădăcinile în psihanaliză, una dintre tradițiile clasice ale
            psihoterapiei moderne.
          </p>

          <div class="homepage-orientation__action">
            <ActionLink href="/psihoterapie-si-consiliere/" variant="secondary">
              Citiți despre psihoterapie și consiliere
            </ActionLink>
          </div>
        </div>
      </header>
    </div>
  </Container>
</section>

<style>
  .homepage-orientation {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--background);
    padding-block: clamp(5rem, 11vw, 9rem);
  }

  .homepage-orientation__atmosphere {
    position: absolute;
    z-index: 0;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(46vw, 42rem);
    opacity: 0.42;
    pointer-events: none;
  }

  .homepage-orientation :global(.homepage-orientation__container) {
    position: relative;
    z-index: 1;
  }

  .homepage-orientation__atmosphere :global(picture),
  .homepage-orientation__atmosphere :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-orientation__atmosphere :global(img) {
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(0.92) brightness(1.04);
    mix-blend-mode: multiply;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgb(0 0 0 / 78%) 21%,
      #000 49%
    );
  }

  .homepage-orientation__layout {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  .homepage-orientation__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .homepage-orientation__intro .section-title {
    max-width: 16ch;
    text-wrap: balance;
  }

  .homepage-orientation__summary {
    display: grid;
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }

  .homepage-orientation__lead {
    max-width: 36rem;
    color: var(--foreground);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .homepage-orientation__action {
    justify-self: start;
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-orientation__atmosphere {
      opacity: 0.14;
    }
  }

  @media (max-width: 56rem) {
    .homepage-orientation {
      padding-block: 0 clamp(4.5rem, 12vw, 6rem);
    }

    .homepage-orientation__atmosphere {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(13rem, 52vw, 19rem);
      margin-bottom: clamp(2.5rem, 8vw, 4rem);
      opacity: 0.5;
    }

    .homepage-orientation__atmosphere :global(img) {
      mask-image: linear-gradient(
        to bottom,
        #000 0%,
        rgb(0 0 0 / 88%) 48%,
        transparent 100%
      );
    }

    .homepage-orientation__intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .homepage-orientation__action :global(a) {
      width: 100%;
    }
  }
</style>
