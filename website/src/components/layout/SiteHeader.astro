---
interface Props {
  variant?: "default" | "hero";
}

const { variant = "default" } = Astro.props;
const isHero = variant === "hero";

const navigation = [
  { href: "/", label: "Acasă" },
  { href: "/despre-silvia/", label: "Formare și orientare" },
  {
    href: "/psihoterapie-si-consiliere/",
    label: "Psihoterapie și consiliere",
  },
  { href: "/reflectie-ghidata/", label: "Reflecție ghidată" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
] as const;

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header
  class:list={[
    "site-header z-30",
    isHero
      ? "site-header--hero fixed inset-x-0"
      : "site-header--default relative",
  ]}
  data-site-header
  data-scrolled="false"
>
  <div class="site-header__bar">
    <div class="site-header__top-row">
      <a
        href="/"
        class="site-header__brand inline-flex min-h-11 items-center justify-center gap-2 no-underline"
        aria-label="DespreSine, Silvia Dinu"
      >
        <img
          src="/images/despresine-mark-purple.svg"
          alt=""
          width="38"
          height="38"
          aria-hidden="true"
        />
        <span class="site-header__wordmark inline-flex flex-col">
          <span class="site-header__name"> DespreSine </span>
          <span class="site-header__practitioner"> Silvia Dinu </span>
        </span>
      </a>

      <button
        type="button"
        class="site-header__menu-toggle inline-flex min-h-11 min-w-11 items-center justify-center rounded-xl border border-[#2f1a99]/25 bg-white/20 text-[#2f1a99] backdrop-blur-[6px]"
        aria-expanded="false"
        aria-controls="navigatie-principala"
        aria-label="Deschideți meniul"
        data-navigation-toggle
      >
        <span class="site-header__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <nav
      id="navigatie-principala"
      aria-label="Navigație principală"
      aria-hidden="true"
      class="site-header__navigation mt-4"
      data-site-navigation
      inert
    >
      <ul
        class="site-header__links grid border-t border-[#2f1a99]/15 p-0 text-sm"
      >
        {
          navigation.map((item) => (
            <li class="list-none">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "site-header__link flex min-h-11 items-center border-b border-[#2f1a99]/15 decoration-1 underline-offset-6 hover:underline",
                  isActive(item.href) && "site-header__link--active",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --header-purple: #2f1a99;
    --header-ease: cubic-bezier(0.23, 1, 0.32, 1);
    --header-enter-duration: 260ms;
    --header-exit-duration: 200ms;
    color: var(--header-purple);
    font-family: "Source Serif Pro", Georgia, serif;
  }

  .site-header--hero {
    top: 1.3125rem;
  }

  .site-header--default {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    padding-block: 1.25rem;
  }

  .site-header__bar {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - (2 * var(--page-gutter))), 79.0625rem);
    min-height: 2.375rem;
    margin-inline: auto;
  }

  .site-header--hero .site-header__bar {
    width: min(calc(100% - (2.5 * var(--page-gutter))), 72rem);
    padding: 0.5rem 0.75rem;
  }

  .site-header__bar::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 80%);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 28%);
    box-shadow: inset 0 -4px 5.6px rgb(255 255 255 / 25%);
    opacity: 0;
    transform: translateY(-0.25rem) scale(1.01);
    backdrop-filter: blur(6px);
    content: "";
    pointer-events: none;
    transition:
      opacity 240ms ease-out,
      transform var(--header-exit-duration) var(--header-ease);
  }

  .site-header--hero[data-scrolled="true"] .site-header__bar::before,
  .site-header--hero[data-navigation-open="true"] .site-header__bar::before {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .site-header__top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header--hero .site-header__top-row,
  .site-header--hero .site-header__navigation {
    transform: translateY(-0.125rem);
    transition: transform var(--header-exit-duration) var(--header-ease);
  }

  .site-header--hero[data-scrolled="true"] .site-header__bar::before,
  .site-header--hero[data-navigation-open="true"] .site-header__bar::before {
    transition-duration: 240ms, var(--header-enter-duration);
  }

  .site-header--hero[data-scrolled="true"] .site-header__top-row,
  .site-header--hero[data-scrolled="true"] .site-header__navigation,
  .site-header--hero[data-navigation-open="true"] .site-header__top-row,
  .site-header--hero[data-navigation-open="true"] .site-header__navigation {
    transform: translateY(0);
    transition-duration: var(--header-enter-duration);
  }

  .site-header__brand {
    flex-shrink: 0;
  }

  .site-header__menu-toggle {
    flex-shrink: 0;
    transition: transform 140ms ease-out;
  }

  .site-header__menu-toggle:active {
    transform: scale(0.96);
  }

  .site-header__menu-icon {
    position: relative;
    display: block;
    width: 1.375rem;
    height: 0.875rem;
  }

  .site-header__menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 0.109375rem;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 200ms cubic-bezier(0.77, 0, 0.175, 1),
      opacity 150ms linear;
  }

  .site-header__menu-icon span:nth-child(1) {
    top: 0;
  }

  .site-header__menu-icon span:nth-child(2) {
    top: 0.3828125rem;
  }

  .site-header__menu-icon span:nth-child(3) {
    bottom: 0;
  }

  .site-header[data-navigation-open="true"]
    .site-header__menu-icon
    span:nth-child(1) {
    transform: translateY(0.3828125rem) rotate(45deg);
  }

  .site-header[data-navigation-open="true"]
    .site-header__menu-icon
    span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.5);
  }

  .site-header[data-navigation-open="true"]
    .site-header__menu-icon
    span:nth-child(3) {
    transform: translateY(-0.3828125rem) rotate(-45deg);
  }

  .site-header__wordmark {
    gap: 0.125rem;
    color: var(--header-purple);
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 400;
  }

  .site-header__name {
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .site-header__practitioner {
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .site-header__links {
    gap: 1rem;
  }

  .site-header__link {
    padding: 0.625rem;
    color: var(--header-purple);
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .site-header__link--active {
    text-decoration-line: underline;
  }

  @media (min-width: 68rem) {
    .site-header__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }

    .site-header__navigation {
      display: block !important;
      margin-top: 0;
      margin-left: auto;
    }

    .site-header__menu-toggle {
      display: none;
    }

    .site-header__brand,
    .site-header__link {
      min-height: 0;
    }

    .site-header__links {
      display: flex;
      border-top: 0;
    }

    .site-header__link {
      border-bottom: 0;
    }
  }

  @media (max-width: 47.999rem) {
    .site-header--hero {
      top: 0.75rem;
    }

    .site-header--default {
      padding-block: 0.75rem;
    }

    .site-header--default .site-header__bar {
      width: calc(100% - 1.5rem);
    }

    .site-header--hero .site-header__bar {
      width: calc(100% - 2rem);
      padding: 0.75rem 1rem;
    }

    .site-header__links {
      gap: 0;
    }
  }

  @media (max-width: 67.999rem) {
    .site-header--hero .site-header__bar {
      padding: 0.75rem 1rem;
    }

    .site-header__navigation {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      width: min(22rem, calc(100vw - 2rem));
      margin-top: 0;
      border: 1px solid rgb(255 255 255 / 80%);
      border-radius: 1rem;
      background: rgb(255 255 255 / 82%);
      box-shadow: 0 1rem 3rem rgb(47 26 153 / 12%);
      opacity: 0;
      padding: 0.75rem;
      transform: translateY(-0.5rem) scale(0.98);
      transform-origin: top right;
      visibility: hidden;
      pointer-events: none;
      backdrop-filter: blur(14px) saturate(140%);
      transition:
        opacity 180ms ease-out,
        transform 220ms var(--header-ease),
        visibility 0s linear 220ms;
    }

    .site-header[data-navigation-open="true"] .site-header__navigation {
      opacity: 1;
      transform: translateY(0) scale(1);
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    .site-header__links {
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:not([data-motion-preview="full"])) .site-header__bar,
    :global(html:not([data-motion-preview="full"])) .site-header__bar::before,
    :global(html:not([data-motion-preview="full"])) .site-header__top-row,
    :global(html:not([data-motion-preview="full"])) .site-header__navigation,
    :global(html:not([data-motion-preview="full"])) .site-header__menu-toggle,
    :global(html:not([data-motion-preview="full"]))
      .site-header__menu-icon
      span {
      transition: none;
    }
  }
</style>

<script>
  const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");
  const navigationToggle = document.querySelector<HTMLElement>(
    "[data-navigation-toggle]",
  );
  const siteNavigation = document.querySelector<HTMLElement>(
    "[data-site-navigation]",
  );
  const desktopNavigation = window.matchMedia("(min-width: 1088px)");

  const setNavigationOpen = (open: boolean) => {
    if (!navigationToggle || !siteNavigation) return;

    const nextOpen = desktopNavigation.matches ? false : open;
    const navigationIsAvailable = desktopNavigation.matches || nextOpen;

    navigationToggle.setAttribute("aria-expanded", String(nextOpen));
    navigationToggle.setAttribute(
      "aria-label",
      nextOpen ? "Închideți meniul" : "Deschideți meniul",
    );
    siteNavigation.setAttribute("aria-hidden", String(!navigationIsAvailable));
    siteNavigation.toggleAttribute("inert", !navigationIsAvailable);
    siteHeader?.setAttribute("data-navigation-open", String(nextOpen));
  };

  navigationToggle?.addEventListener("click", () => {
    setNavigationOpen(
      navigationToggle.getAttribute("aria-expanded") !== "true",
    );
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      navigationToggle?.getAttribute("aria-expanded") === "true"
    ) {
      setNavigationOpen(false);
      navigationToggle?.focus();
    }
  });

  desktopNavigation.addEventListener("change", () => {
    setNavigationOpen(false);
  });

  setNavigationOpen(false);

  let headerIsScrolled = window.scrollY > 48;
  let headerFrame = 0;

  const updateScrolledState = () => {
    const nextScrolled = headerIsScrolled
      ? window.scrollY > 12
      : window.scrollY > 48;

    if (nextScrolled === headerIsScrolled) return;
    headerIsScrolled = nextScrolled;
    siteHeader?.setAttribute("data-scrolled", String(headerIsScrolled));
  };

  const requestHeaderUpdate = () => {
    cancelAnimationFrame(headerFrame);
    headerFrame = requestAnimationFrame(updateScrolledState);
  };

  siteHeader?.setAttribute("data-scrolled", String(headerIsScrolled));
  updateScrolledState();
  window.addEventListener("scroll", requestHeaderUpdate, { passive: true });
</script>
