---
import Container from "../ui/Container.astro";
import ReflectionPromoCard from "../ui/ReflectionPromoCard.astro";

const reflectionDescription = [
  "Alegeți răspunsurile care vi se potrivesc cel mai bine.",
  "Astfel, vă puteți face o idee mai clară despre sursa dificultăților.",
] as const;
const reflectionPrivacy =
  "Cele zece întrebări sunt anonime. Răspunsurile nu sunt stocate, iar rezultatul este orientativ și nu reprezintă un diagnostic.";
---

<section
  class="homepage-areas"
  aria-labelledby="homepage-reflection-title"
  aria-describedby="homepage-reflection-privacy"
>
  <Container>
    <ReflectionPromoCard
      class="homepage-reflection"
      idPrefix="homepage-reflection"
      title="O primă explorare"
      description={reflectionDescription}
      note="Nu există răspunsuri corecte sau greșite."
      privacyDescription={reflectionPrivacy}
      href="/reflectie-ghidata/"
      actionLabel="Începeți explorarea"
    />
  </Container>
</section>

<style>
  .homepage-areas {
    padding-block: var(--section-space);
  }
</style>
