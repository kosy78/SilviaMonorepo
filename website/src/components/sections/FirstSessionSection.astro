---
import { Picture } from "astro:assets";

import firstSessionIllustration from "../../assets/homepage/first-session-conversation-transparent-2026-10-08.png";
---

<div class="first-session-card" data-first-session>
  <header
    class="first-session-card__header px-(--card-spacing) py-(--card-spacing)"
  >
    <h2 id="first-session-title" class="heading-long max-w-[20ch]">
      Oare cum va fi prima ședință, la ce să mă aștept?
    </h2>
    <div class="first-session-card__illustration" aria-hidden="true">
      <Picture
        src={firstSessionIllustration}
        formats={["avif", "webp"]}
        widths={[256, 384, 512, 768]}
        sizes="(min-width: 56rem) 24rem, 16rem"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </header>

  <div class="border-line border-t px-(--card-spacing) py-(--card-spacing)">
    <ol
      class="m-0 grid list-none p-0 lg:grid-cols-3"
      aria-label="La ce vă puteți aștepta"
    >
      <li
        class="grid content-start gap-4 pb-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:grid-cols-1 lg:gap-6 lg:pe-10 lg:pb-0"
      >
        <p
          class="text-muted-foreground font-display text-xl leading-none"
          aria-hidden="true"
        >
          01
        </p>
        <div>
          <h3 class="text-2xl leading-tight tracking-[-0.02em]">
            Convorbirea telefonică
          </h3>
          <p class="text-body text-muted-foreground mt-4 max-w-[65ch]">
            Înainte de prima întâlnire în cabinet, vom avea o scurtă convorbire
            telefonică. Aceasta ne ajută să clarificăm motivul pentru care vă
            doriți să începeți terapia, câteva aspecte practice și să stabilim
            împreună prima ședință.
          </p>
        </div>
      </li>

      <li
        class="border-line grid content-start gap-4 border-t py-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:grid-cols-1 lg:gap-6 lg:border-t-0 lg:border-s lg:px-10 lg:py-0"
      >
        <p
          class="text-muted-foreground font-display text-xl leading-none"
          aria-hidden="true"
        >
          02
        </p>
        <div>
          <h3 class="text-2xl leading-tight tracking-[-0.02em]">
            Prima întâlnire
          </h3>
          <p class="text-body text-muted-foreground mt-4 max-w-[65ch]">
            Ședințele nu urmează o listă fixă de exerciții și nu este nevoie să
            veniți cu un subiect pregătit. Puteți porni de la ceva ce s-a
            întâmplat recent, de la o relație, o amintire, un vis, o stare din
            corp sau chiar de la faptul că nu știți cu ce să începeți.
          </p>
        </div>
      </li>

      <li
        class="border-line grid content-start gap-4 border-t pt-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:grid-cols-1 lg:gap-6 lg:border-t-0 lg:border-s lg:pt-0 lg:ps-10"
      >
        <p
          class="text-muted-foreground font-display text-xl leading-none"
          aria-hidden="true"
        >
          03
        </p>
        <div>
          <h3 class="text-2xl leading-tight tracking-[-0.02em]">
            Cum lucrăm împreună
          </h3>
          <p class="text-body mt-4 max-w-[65ch]">
            Eu voi asculta și vă voi ajuta să observăm împreună legăturile care
            se conturează. Întâlnirile au câteva repere clare, care oferă
            continuitate și siguranță, însă direcția procesului se construiește
            în funcție de nevoile și ritmul propriu.
          </p>
        </div>
      </li>
    </ol>
  </div>
</div>

<style>
  .first-session-card {
    container: first-session / inline-size;
  }

  .first-session-card__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
  }

  .first-session-card__illustration {
    display: grid;
    inline-size: min(100%, 16rem);
    aspect-ratio: 3 / 2;
    place-items: center;
  }

  .first-session-card__illustration :global(picture),
  .first-session-card__illustration :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .first-session-card__illustration :global(img) {
    object-fit: contain;
  }

  @container first-session (min-width: 48rem) {
    .first-session-card__header {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(42cqi, 24rem));
      gap: clamp(2rem, 4cqi, 3rem);
    }

    .first-session-card__illustration {
      inline-size: 100%;
    }
  }
</style>
