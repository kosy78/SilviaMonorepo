---
import { IconArrowRight, IconMail } from "@tabler/icons-react";
import { Picture } from "astro:assets";

import practiceSky from "../assets/homepage/practice-sky.jpg";
import FaqList from "../components/sections/FaqList.astro";
import HomepageAbout from "../components/sections/HomepageAbout.astro";
import HomepageAreas from "../components/sections/HomepageAreas.astro";
import HomepageBlog from "../components/sections/HomepageBlog.astro";
import HomepageHero from "../components/sections/HomepageHero.astro";
import HomepageOrientation from "../components/sections/HomepageOrientation.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import { Separator } from "../components/ui/separator";
import { Tag } from "../components/ui/tag";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials, experience and practical wording require
// Silvia's review before publication.

const homepageFaqItems = [
  {
    question: "Cum decurge prima întâlnire?",
    answer:
      "Prima întâlnire oferă timp pentru a discuta ce vă aduce, întrebările pe care le aveți și cadrul în care ar putea continua lucrul. Continuarea poate fi decisă după clarificarea acestor lucruri.",
  },
  {
    question: "Este nevoie să știu exact ce vreau să discut?",
    answer:
      "Nu. Punctul de plecare poate fi o dificultate pe care o puteți numi sau doar sentimentul că ceva important are nevoie de atenție. Nu este necesar să aveți de la început o explicație sau o concluzie.",
  },
  {
    question: "Trebuie să aleg dinainte între consiliere și psihoterapie?",
    answer:
      "Nu este necesar să faceți această alegere înainte de primul mesaj. Punctul de pornire și cadrul pot fi clarificate în primele întâlniri.",
  },
] as const;
---

<BaseLayout
  title="Psihoterapie psihanalitică în București și online"
  description="Psihoterapie psihanalitică și consiliere pentru adulți, tineri adulți și adolescenți de la 16 ani, în București, zona Piața Victoriei / Banu Manta, și online."
>
  <HomepageHero />
  <HomepageAreas />
  <HomepageOrientation />
  <HomepageAbout />

  <section
    class="homepage-faq"
    data-homepage-faq
    aria-labelledby="homepage-faq-title"
  >
    <Container>
      <div class="homepage-faq__layout">
        <header class="homepage-faq__intro">
          <Tag variant="section">Întrebări frecvente</Tag>
          <h2 id="homepage-faq-title" class="section-title">
            Înainte de a începe
          </h2>
          <p>
            Câteva răspunsuri despre prima întâlnire și despre cadrul în care
            poate începe lucrul.
          </p>
        </header>

        <div class="homepage-faq__questions">
          <FaqList items={homepageFaqItems} />
        </div>
      </div>
    </Container>
  </section>

  <HomepageBlog />

  <section class="homepage-practice" aria-labelledby="homepage-practice-title">
    <div class="homepage-practice__background" aria-hidden="true">
      <Picture
        src={practiceSky}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1754]}
        sizes="100vw"
        quality={84}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="homepage-practice__foreground">
      <Container>
        <Card className="homepage-practice__card">
          <CardHeader className="homepage-practice__header">
            <Tag variant="section">Contact</Tag>
            <CardTitle>
              <h2 id="homepage-practice-title" class="section-title">
                În cabinet și online
              </h2>
            </CardTitle>
          </CardHeader>

          <Separator />

          <CardContent className="homepage-practice__steps">
            <article class="homepage-practice__step">
              <div class="homepage-practice__step-heading">
                <Tag variant="index">01</Tag>
                <h3>Primul mesaj</h3>
              </div>
              <p>
                Puteți întreba despre disponibilitate și puteți menționa
                formatul preferat. Nu este nevoie să trimiteți detalii sensibile
                sau să explicați întreaga situație.
              </p>
            </article>

            <Separator
              orientation="vertical"
              className="homepage-practice__separator homepage-practice__separator--wide"
            />
            <Separator
              className="homepage-practice__separator homepage-practice__separator--narrow"
            />

            <article class="homepage-practice__step">
              <div class="homepage-practice__step-heading">
                <Tag variant="index">02</Tag>
                <h3>Detaliile și prima întâlnire</h3>
              </div>
              <p>
                Vă răspund cu informații despre disponibilitate, onorariu și
                format. Dacă decideți să stabilim o primă întâlnire, putem vorbi
                atunci mai pe larg despre ceea ce vă preocupă și despre
                întrebările pe care le aveți.
              </p>
            </article>
          </CardContent>

          <CardFooter className="homepage-practice__contact">
            <div class="homepage-practice__contact-copy">
              <IconMail aria-hidden="true" />
              <p>Puteți folosi formularul sau adresa de email.</p>
            </div>
            <ActionLink href="/contact/">
              Trimiteți un prim mesaj
              <IconArrowRight data-icon="inline-end" aria-hidden="true" />
            </ActionLink>
          </CardFooter>
        </Card>
      </Container>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-faq {
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-faq__layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .homepage-faq__intro .section-title {
    margin-top: 1.5rem;
  }

  .homepage-faq__intro > p {
    max-width: 32rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--muted-foreground);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.8;
  }

  .homepage-faq__questions {
    min-width: 0;
  }

  @media (max-width: 56rem) {
    .homepage-faq__layout {
      grid-template-columns: 1fr;
    }
  }

  .homepage-practice {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--muted);
    padding-block: var(--section-space);
  }

  .homepage-practice::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--background) 14%, transparent),
      color-mix(in oklch, var(--background) 30%, transparent)
    );
    content: "";
    pointer-events: none;
  }

  .homepage-practice__background {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .homepage-practice__background :global(picture),
  .homepage-practice__background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-practice__background :global(img) {
    object-fit: cover;
    object-position: center 62%;
    outline: 1px solid color-mix(in oklch, var(--foreground) 10%, transparent);
    outline-offset: -1px;
  }

  .homepage-practice__foreground {
    position: relative;
    z-index: 2;
  }

  .homepage-practice__card {
    --card-spacing: clamp(1.5rem, 4vw, 3.5rem);

    gap: 0;
    padding-block: 0;
    background: color-mix(in oklch, var(--card) 90%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(90%);
    backdrop-filter: blur(12px) saturate(90%);
  }

  .homepage-practice__header {
    gap: 1.5rem;
    padding-block: var(--card-spacing);
  }

  .homepage-practice__steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: var(--card-spacing);
  }

  .homepage-practice__step {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .homepage-practice__step-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .homepage-practice__step h3 {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .homepage-practice__step p {
    max-width: 40rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.75;
  }

  .homepage-practice__separator--narrow {
    display: none;
  }

  .homepage-practice__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .homepage-practice__contact-copy {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .homepage-practice__contact-copy :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: var(--foreground);
  }

  @media (max-width: 56rem) {
    .homepage-practice__steps {
      display: flex;
      flex-direction: column;
      gap: var(--card-spacing);
    }

    .homepage-practice__separator--wide {
      display: none;
    }

    .homepage-practice__separator--narrow {
      display: block;
    }

    .homepage-practice__contact {
      align-items: stretch;
      flex-direction: column;
    }

    .homepage-practice__contact :global(a) {
      width: 100%;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-practice__card {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
