---
import { cn } from "../../lib/utils";
import Container from "../ui/Container.astro";
import ActionLink from "../ui/ActionLink.astro";
import { buttonVariants } from "../ui/button";
import { Separator } from "../ui/separator";

interface Props {
  flush?: boolean;
}

const { flush = false } = Astro.props;
const year = new Date().getFullYear();
const preliminaryMeetingEmailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20%C3%AEnt%C3%A2lnire%20preliminar%C4%83";
const legalLinks = [
  {
    href: "/politica-de-confidentialitate/",
    label: "Politica de confidențialitate",
  },
  { href: "/politica-cookies/", label: "Politica de cookies" },
] as const;
---

<footer
  class:list={["site-footer", flush && "site-footer--flush"]}
  data-site-footer
>
  <Container>
    <div class="site-footer__inner">
      <div class="site-footer__masthead">
        <div class="site-footer__brand">
          <div class="site-footer__mark" aria-hidden="true">
            <img
              src="/images/despresine-logo.png"
              alt=""
              width="52"
              height="52"
            />
          </div>
          <div>
            <p class="site-footer__name">DespreSine</p>
            <p class="site-footer__subtitle">Psihoterapeut Silvia Dinu</p>
          </div>
        </div>
        <div class="site-footer__masthead-action">
          <ActionLink href={preliminaryMeetingEmailHref} icon="mail">
            Solicitați o întâlnire preliminară
          </ActionLink>
        </div>
      </div>

      <Separator className="site-footer__separator" />

      <div class="site-footer__grid">
        <section>
          <h2 class="site-footer__label">Practica profesională</h2>
          <p class="site-footer__copy">
            Psiholog cu drept de liberă practică<br />
            Psihoterapeut psihanalitic sub supervizare
          </p>
        </section>

        <section>
          <h2 class="site-footer__label">Loc și format</h2>
          <p class="site-footer__copy">
            București, zona Piața Victoriei / Banu Manta<br />
            Ședințe în cabinet și online
          </p>
        </section>

        <nav aria-label="Informații legale">
          <h2 class="site-footer__label">Informații legale</h2>
          <ul class="site-footer__links">
            {
              legalLinks.map((item) => (
                <li>
                  <a
                    class={cn(
                      buttonVariants({ variant: "link", size: "inline" }),
                      "justify-start",
                    )}
                    href={item.href}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                type="button"
                data-analytics-settings
                hidden
                class={cn(
                  buttonVariants({ variant: "link", size: "inline" }),
                  "justify-start",
                )}
              >
                Setări analytics
              </button>
            </li>
          </ul>
        </nav>

        <section>
          <h2 class="site-footer__label">Soluționarea litigiilor</h2>
          <a
            class="site-footer__anpc ui-control"
            href="https://reclamatiisal.anpc.ro/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Soluționarea Alternativă a Litigiilor prin ANPC"
          >
            <img
              src="/trust/anpc-sal-online.png"
              alt="ANPC - Soluționarea alternativă a litigiilor"
              width="250"
              height="49"
              loading="lazy"
              decoding="async"
            />
          </a>
        </section>
      </div>

      <Separator
        className="site-footer__separator site-footer__separator--last"
      />
      <div class="site-footer__bottom">
        <p>© {year} Despre Sine - Psihoterapeut Silvia Dinu</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    --site-footer-quiet: color-mix(
      in oklch,
      var(--foreground) 28%,
      var(--muted-foreground)
    );
    --site-footer-line: color-mix(
      in oklch,
      var(--border) 78%,
      var(--foreground) 6%
    );

    margin-top: var(--section-space);
    border-top: 1px solid var(--site-footer-line);
    background: var(--muted);
    color: var(--foreground);
    padding-block: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 2.5vw, 2rem);
  }

  .site-footer--flush {
    margin-top: 0;
  }

  .site-footer__inner {
    container-name: site-footer;
    container-type: inline-size;
  }

  .site-footer__masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-footer__mark {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: 0 0 0 1px
      color-mix(in oklch, var(--foreground) 10%, transparent);
  }

  .site-footer__mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .site-footer__subtitle,
  .site-footer__label,
  .site-footer__bottom {
    color: var(--site-footer-quiet);
  }

  .site-footer__subtitle {
    font-size: 0.875rem;
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .site-footer__masthead-action :global([data-slot="button"]) {
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    transition-property: color, background-color, border-color, transform;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .site-footer__masthead-action :global([data-slot="button"]:hover) {
    background: var(--background);
    color: var(--foreground);
  }

  .site-footer__masthead-action :global([data-slot="button"]:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  :global(.site-footer__separator) {
    background: var(--site-footer-line);
    margin-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.85fr 1fr;
    align-items: start;
    gap: clamp(2rem, 3.5vw, 3rem);
  }

  .site-footer__label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .site-footer__copy {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .site-footer__links {
    display: grid;
    gap: 0.125rem;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .site-footer__links li {
    list-style: none;
  }

  .site-footer__links :global(a),
  .site-footer__links :global(button) {
    font-size: 0.9375rem;
  }

  .site-footer__anpc {
    display: inline-flex;
    width: min(100%, 15.625rem);
    min-height: 3.0625rem;
    max-width: 15.625rem;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--foreground) 4%, transparent);
    transition: border-color var(--duration-exit) var(--ease-out);
  }

  .site-footer__anpc:hover {
    border-color: color-mix(in oklch, var(--foreground) 16%, transparent);
  }

  .site-footer__anpc:focus-visible {
    box-shadow:
      var(--focus-ring),
      0 1px 2px color-mix(in oklch, var(--foreground) 4%, transparent);
  }

  .site-footer__anpc img {
    width: 100%;
    height: auto;
  }

  :global(.site-footer__separator--last) {
    margin-bottom: 1.5rem;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @container site-footer (max-width: 58rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container site-footer (max-width: 40rem) {
    .site-footer__masthead,
    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__masthead-action,
    .site-footer__masthead-action :global(a) {
      width: 100%;
    }

    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-footer__masthead-action :global([data-slot="button"]) {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
