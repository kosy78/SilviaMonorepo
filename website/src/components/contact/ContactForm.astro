---
import { Alert, AlertDescription } from "../ui/alert";
import { Button } from "../ui/button";
import { Field, FieldDescription, FieldGroup, FieldLabel } from "../ui/field";
import { Input } from "../ui/input";
import { Textarea } from "../ui/textarea";

const emailHref =
  "mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire";
---

<div class="contact-letter-form">
  <form
    action="/api/contact"
    method="post"
    class="max-w-none"
    aria-labelledby="formular-contact"
    data-contact-form
  >
    <FieldGroup className="gap-7">
      <div class="contact-letter-form__identity">
        <Field>
          <FieldLabel htmlFor="contact-email">Adresă de email</FieldLabel>
          <Input
            className="contact-letter-form__line-input min-h-12 rounded-none border-x-0 border-t-0 bg-transparent px-0 text-base shadow-none md:text-base"
            id="contact-email"
            name="email"
            type="email"
            autoComplete="email"
            inputMode="email"
            maxLength={254}
            required
          />
        </Field>

        <Field>
          <FieldLabel htmlFor="contact-name">
            Nume
            <span
              class="shrink-0 whitespace-nowrap font-normal text-muted-foreground"
            >
              (opțional)
            </span>
          </FieldLabel>
          <Input
            className="contact-letter-form__line-input min-h-12 rounded-none border-x-0 border-t-0 bg-transparent px-0 text-base shadow-none md:text-base"
            id="contact-name"
            name="name"
            type="text"
            autoComplete="name"
            maxLength={100}
          />
        </Field>
      </div>

      <div
        class="border-line bg-muted/40 hidden items-start justify-between gap-4 rounded-lg border p-4 sm:flex-row"
        data-contact-reflection
        hidden
      >
        <div>
          <p class="font-medium">Rezultatul reflecției este inclus</p>
          <p class="text-muted-foreground mt-1 max-w-xl text-sm leading-6">
            Se vor trimite rezumatul și distribuția, nu răspunsurile
            individuale.
          </p>
        </div>
        <Button
          className="shrink-0"
          variant="link"
          size="inline"
          type="button"
          data-contact-reflection-remove
        >
          Eliminați rezultatul
        </Button>
        <input
          type="hidden"
          name="reflection_result"
          data-contact-reflection-input
          disabled
        />
      </div>

      <Field>
        <FieldLabel htmlFor="contact-availability">
          Când v-ar fi mai ușor să stabilim o întâlnire?
          <span
            class="shrink-0 whitespace-nowrap font-normal text-muted-foreground"
          >
            (opțional)
          </span>
        </FieldLabel>
        <Textarea
          className="contact-letter-form__writing-area min-h-52 rounded-md border-0 bg-transparent px-1 py-1 text-lg leading-7 shadow-none md:text-lg"
          id="contact-availability"
          name="availability"
          rows={7}
          maxLength={400}
          placeholder="De exemplu: luni după 17:00 sau miercuri dimineața"
        />
      </Field>

      <div class="hp-field" aria-hidden="true">
        <label for="contact-company">Companie</label>
        <input
          id="contact-company"
          name="company"
          type="text"
          autocomplete="off"
          tabindex="-1"
        />
      </div>

      <Alert
        variant="default"
        className="hidden"
        role="status"
        aria-live="polite"
        tabIndex={-1}
        data-contact-status
      >
        <AlertDescription />
      </Alert>

      <Field>
        <Button
          className="w-full sm:w-auto sm:self-end"
          type="submit"
          data-contact-submit
        >
          Trimiteți mesajul
        </Button>
        <FieldDescription className="max-w-xl leading-6">
          Mesajul ajunge direct pe email și nu este păstrat într-o bază de date.
          {" "}
          <a href="/politica-de-confidentialitate/">
            Politica de confidențialitate.
          </a>
        </FieldDescription>
      </Field>

      <noscript>
        <p class="border-line border-y py-4 leading-7">
          Pentru trimiterea formularului este necesar JavaScript. Puteți scrie
          direct la {" "}
          <a class="underline" href={emailHref}>silvia.drn@gmail.com</a>.
        </p>
      </noscript>
    </FieldGroup>
  </form>

  <p
    class="contact-letter-form__postscript text-muted-foreground mt-8 max-w-2xl text-sm leading-6"
    data-contact-direct-email
  >
    <span class="contact-letter-form__postscript-mark" aria-hidden="true">
      P.S.
    </span>{" "}
    Preferați să îmi scrieți direct? {" "}
    <a
      class="text-foreground inline-flex min-h-11 items-center font-medium underline decoration-1 underline-offset-4"
      href={emailHref}
    >
      silvia.drn@gmail.com
    </a>
  </p>
</div>

<style>
  .contact-letter-form__identity {
    display: grid;
    gap: 1.75rem;
  }

  .contact-letter-form__postscript-mark {
    color: var(--foreground);
    font-family: var(--font-editorial);
    font-size: 1rem;
    font-style: italic;
  }

  :global(.contact-letter-form__line-input),
  :global(.contact-letter-form__writing-area) {
    caret-color: var(--foreground);
    font-family: var(--font-editorial);
    transition:
      background-color var(--duration-exit) var(--ease-out),
      border-color var(--duration-exit) var(--ease-out),
      box-shadow var(--duration-exit) var(--ease-out);
  }

  :global(.contact-letter-form__line-input:focus-visible) {
    border-color: var(--foreground);
    box-shadow: inset 0 -2px 0 var(--foreground);
  }

  :global(.contact-letter-form__writing-area) {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(1.75rem - 1px),
      var(--input) calc(1.75rem - 1px),
      var(--input) 1.75rem
    );
    background-attachment: local;
    background-position: 0 0.45rem;
    resize: vertical;
  }

  :global(.contact-letter-form__writing-area:focus-visible) {
    background-color: color-mix(in oklch, var(--ring) 3%, transparent);
    box-shadow: inset 0 -2px 0
      color-mix(in oklch, var(--ring) 72%, var(--foreground));
  }

  @media (forced-colors: active) {
    :global(.contact-letter-form__line-input:focus-visible),
    :global(.contact-letter-form__writing-area:focus-visible) {
      outline: 2px solid CanvasText;
      outline-offset: 2px;
      box-shadow: none;
    }
  }

  :global([data-contact-status][data-state="error"]) {
    border-color: var(--color-destructive);
    color: var(--color-destructive);
  }

  :global([data-contact-status]:not(.hidden)) {
    animation: contact-status-enter var(--duration-exit) var(--ease-out) both;
  }

  @keyframes contact-status-enter {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>

<script>
  const contactForm = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );
  const contactStatus = document.querySelector<HTMLElement>(
    "[data-contact-status]",
  );
  const contactSubmit = document.querySelector<HTMLButtonElement>(
    "[data-contact-submit]",
  );
  const contactReflection = document.querySelector<HTMLElement>(
    "[data-contact-reflection]",
  );
  const contactReflectionInput = document.querySelector<HTMLInputElement>(
    "[data-contact-reflection-input]",
  );
  const contactReflectionRemove = document.querySelector<HTMLButtonElement>(
    "[data-contact-reflection-remove]",
  );
  const reflectionTransferKey = "despresine.reflectionResult";
  const maxReflectionResultLength = 2_000;
  let reflectionTransfer: unknown = null;

  try {
    const serializedReflection = window.sessionStorage.getItem(
      reflectionTransferKey,
    );
    window.sessionStorage.removeItem(reflectionTransferKey);
    reflectionTransfer = serializedReflection
      ? JSON.parse(serializedReflection)
      : null;
  } catch {
    reflectionTransfer = null;
  }

  const transferredReflectionText =
    typeof reflectionTransfer === "object" &&
    reflectionTransfer !== null &&
    "version" in reflectionTransfer &&
    reflectionTransfer.version === 1 &&
    "text" in reflectionTransfer &&
    typeof reflectionTransfer.text === "string" &&
    reflectionTransfer.text.length <= maxReflectionResultLength &&
    reflectionTransfer.text.startsWith(
      "Rezultat al reflecției ghidate — DespreSine",
    )
      ? reflectionTransfer.text
      : null;

  if (transferredReflectionText && contactReflectionInput) {
    contactReflectionInput.value = transferredReflectionText;
    contactReflectionInput.disabled = false;
    contactReflection?.removeAttribute("hidden");
    contactReflection?.classList.remove("hidden");
    contactReflection?.classList.add("flex");
  }

  const showContactStatus = (message: string, state: "success" | "error") => {
    if (!contactStatus) return;

    contactStatus.textContent = message;
    contactStatus.dataset.state = state;
    contactStatus.classList.remove("hidden");
    contactStatus.focus();
  };

  const clearReflectionAttachment = (announce: boolean) => {
    if (contactReflectionInput) {
      contactReflectionInput.value = "";
      contactReflectionInput.disabled = true;
    }

    contactReflection?.setAttribute("hidden", "");
    contactReflection?.classList.add("hidden");
    contactReflection?.classList.remove("flex");

    if (announce) {
      showContactStatus(
        "Rezultatul reflecției a fost eliminat din mesaj.",
        "success",
      );
    }
  };

  contactReflectionRemove?.addEventListener("click", () => {
    clearReflectionAttachment(true);
  });

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!contactForm.reportValidity()) return;

    contactSubmit?.setAttribute("disabled", "");
    if (contactSubmit) contactSubmit.textContent = "Se trimite…";
    contactStatus?.classList.add("hidden");

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(contactForm),
      });

      if (!response.ok) {
        throw new Error(`Contact form failed with ${response.status}`);
      }

      contactForm.reset();
      clearReflectionAttachment(false);
      showContactStatus(
        "Mesajul a fost trimis. Vă voi răspunde la adresa indicată.",
        "success",
      );
    } catch {
      showContactStatus(
        "Mesajul nu a fost trimis. Încercați din nou sau scrieți direct la silvia.drn@gmail.com.",
        "error",
      );
    } finally {
      contactSubmit?.removeAttribute("disabled");
      if (contactSubmit) contactSubmit.textContent = "Trimiteți mesajul";
    }
  });
</script>
