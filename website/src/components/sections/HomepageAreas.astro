---
import { Image } from "astro:assets";
import reflectionBackground from "../../assets/homepage/content-pixie-Px5UF7da7q4-unsplash.jpg";
import reflectionIllustration from "../../assets/homepage/reflection-door-light.jpg";
import ExplorationPromoCard from "../ui/ExplorationPromoCard.astro";
import Container from "../ui/Container.astro";
---

<section class="homepage-areas" aria-labelledby="homepage-reflection-title">
  <div class="homepage-areas__background" aria-hidden="true">
    <Image
      src={reflectionBackground}
      widths={[640, 960, 1512, 2016]}
      sizes="100vw"
      alt=""
      loading="lazy"
    />
  </div>
  <Container>
    <ExplorationPromoCard illustration={reflectionIllustration} />
  </Container>
</section>

<style>
  .homepage-areas {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 44.1875rem;
    padding-block: calc(var(--section-space) + 0.5rem);
    background: var(--background);
  }

  .homepage-areas__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: var(--botanical-backdrop-opacity);
    mask-image: var(--botanical-backdrop-fade);
  }

  .homepage-areas__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .homepage-areas__background::after {
    position: absolute;
    inset: 0;
    background: var(--botanical-backdrop-wash);
    content: "";
    pointer-events: none;
  }

  @media (max-width: 56rem) {
    .homepage-areas {
      min-height: 0;
      padding-block: var(--section-space);
    }
  }

  /* Followed by the Silvia Dinu / parental cards: close up to the same
     1.25rem gap those cards share, so the three read as one bento grid. */
  :global(.homepage-areas:has(+ .homepage-about)) {
    min-height: 0;
    padding-block-end: 1.25rem;
  }
</style>
