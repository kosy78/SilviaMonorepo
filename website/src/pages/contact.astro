---
import ContactForm from "../components/contact/ContactForm.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const googleMapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY?.trim();

// Copy status: in review after adding the minimal contact form. Practical,
// privacy and retention wording require Silvia's final review before launch.
---

<BaseLayout
  title="Contact"
  description="Contactați-o pe Silvia Dinu pentru a întreba despre disponibilitatea pentru psihoterapie psihanalitică și consiliere, în București sau online."
  footerFlush
>
  <section class="contact-letter-section" data-contact-section>
    <Container>
      <article class="contact-letter" data-contact-letter>
        <div class="contact-letter__recipient">
          <span class="contact-letter__recipient-label">Către</span>
          <span class="contact-letter__recipient-name">Silvia Dinu</span>
        </div>

        <div class="contact-letter__layout">
          <header class="contact-letter__intro">
            <h1 class="contact-letter__title">
              Solicitați o întâlnire preliminară.
            </h1>
            <p class="contact-letter__opening">
              Dacă doriți să aflați mai multe sau să stabilim o primă întâlnire,
              îmi puteți scrie și pe adresa de email
              {" "}
              <a
                href="mailto:silvia.drn@gmail.com?subject=Solicitare%20pentru%20o%20prim%C4%83%20%C3%AEnt%C3%A2lnire"
                >silvia.drn@gmail.com</a
              >.
            </p>
          </header>

          <div class="contact-letter__form">
            <h2 id="formular-contact" class="contact-letter__form-title">
              Formular de contact
            </h2>
            <ContactForm />
          </div>

          <figure
            class="contact-letter__map"
            data-contact-map
            data-map-state="idle"
          >
            {
              googleMapsApiKey ? (
                <div
                  class="contact-letter__map-canvas"
                  data-contact-map-canvas
                  data-api-key={googleMapsApiKey}
                  role="img"
                  aria-label="Hartă Google pentru zona Piața Victoriei / Banu Manta din București"
                />
              ) : (
                <iframe
                  class="contact-letter__map-frame"
                  title="Google Maps — zona Piața Victoriei / Banu Manta"
                  data-contact-map-frame
                  src="https://www.google.com/maps?ll=44.4553,26.0806&z=15&hl=ro&output=embed"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  allowfullscreen
                />
              )
            }
            <figcaption class="sr-only">
              Hartă orientativă pentru zona Piața Victoriei / Banu Manta din
              București. Adresa exactă nu este publicată pe website.
            </figcaption>
            <p
              class="contact-letter__map-fallback"
              data-contact-map-fallback
              hidden
            >
              <a
                href="https://www.google.com/maps/search/?api=1&query=Pia%C8%9Ba%20Victoriei%20Banu%20Manta%20Bucure%C8%99ti"
                target="_blank"
                rel="noopener noreferrer">Deschideți zona în Google Maps</a
              >.
            </p>
            <noscript>
              <p class="contact-letter__map-noscript">
                <a
                  href="https://www.google.com/maps/search/?api=1&query=Pia%C8%9Ba%20Victoriei%20Banu%20Manta%20Bucure%C8%99ti"
                  target="_blank"
                  rel="noopener noreferrer">Deschideți zona în Google Maps</a
                >.
              </p>
            </noscript>
          </figure>
        </div>
      </article>
    </Container>
  </section>
</BaseLayout>

<style>
  .contact-letter-section {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(
        circle at 15% 10%,
        color-mix(in oklch, var(--secondary) 72%, transparent),
        transparent 36rem
      ),
      color-mix(in oklch, var(--muted) 52%, var(--background));
  }

  .contact-letter {
    position: relative;
    isolation: isolate;
    max-width: 68rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--card);
    padding: clamp(1.5rem, 5vw, 4.5rem);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--foreground) 8%, transparent),
      0 0.25rem 1rem color-mix(in oklch, var(--foreground) 4%, transparent),
      0 1.75rem 4.5rem color-mix(in oklch, var(--foreground) 9%, transparent);
  }

  .contact-letter::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        color-mix(in oklch, var(--background) 34%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 82% 18%,
        color-mix(in oklch, var(--foreground) 1.8%, transparent),
        transparent 28rem
      );
    content: "";
    pointer-events: none;
  }

  .contact-letter__recipient {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid
      color-mix(in oklch, var(--border) 72%, transparent);
  }

  .contact-letter__recipient-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-letter__recipient-name {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
  }

  .contact-letter__layout {
    display: grid;
    grid-template-areas:
      "intro"
      "form"
      "map";
    gap: clamp(2.75rem, 5vw, 4.5rem);
    padding-block-start: clamp(2.25rem, 5vw, 4.5rem);
  }

  .contact-letter__intro {
    grid-area: intro;
    max-width: 32rem;
  }

  .contact-letter__title {
    max-width: 10ch;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .contact-letter__opening {
    max-width: 36ch;
    margin-block-start: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--muted-foreground);
    font-family: var(--font-editorial);
    font-size: 1rem;
    line-height: 1.65;
  }

  .contact-letter__opening a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact-letter__map {
    position: relative;
    isolation: isolate;
    grid-area: map;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--muted);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--foreground) 8%, transparent),
      0 0.75rem 2rem color-mix(in oklch, var(--foreground) 6%, transparent);
  }

  .contact-letter__map::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--card) 24%, transparent),
        transparent 18% 77%,
        color-mix(in oklch, var(--secondary) 20%, transparent)
      ),
      linear-gradient(
        90deg,
        color-mix(in oklch, var(--card) 12%, transparent),
        transparent 16% 84%,
        color-mix(in oklch, var(--secondary) 12%, transparent)
      );
    content: "";
    pointer-events: none;
  }

  .contact-letter__map::before {
    position: absolute;
    z-index: 2;
    inset: 50% auto auto 50%;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid color-mix(in oklch, var(--foreground) 18%, transparent);
    border-block-start-color: var(--foreground);
    border-radius: 50%;
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .contact-letter__map[data-map-state="loading"]::before {
    animation: contact-map-loading 800ms linear infinite;
    opacity: 1;
  }

  .contact-letter__map-fallback {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    background: var(--muted);
    padding: 1.25rem;
    text-align: center;
  }

  .contact-letter__map-fallback[hidden] {
    display: none;
  }

  .contact-letter__map-fallback a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .contact-letter__map-frame,
  .contact-letter__map-canvas {
    display: block;
    width: 100%;
    height: clamp(12rem, 55vw, 15rem);
    border: 0;
  }

  .contact-letter__map-frame {
    filter: sepia(0.12) saturate(0.74) hue-rotate(332deg) contrast(0.92)
      brightness(1.02);
  }

  .contact-letter__form {
    grid-area: form;
    min-width: 0;
  }

  .contact-letter__form-title {
    margin-block-end: 1.75rem;
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  @keyframes contact-map-loading {
    to {
      transform: translate(-50%, -50%) rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-letter__map[data-map-state="loading"]::before {
      animation: none;
    }
  }

  @media (min-width: 56rem) {
    .contact-letter__layout {
      grid-template-columns: minmax(18rem, 0.95fr) minmax(0, 1.05fr);
      grid-template-areas:
        "intro form"
        "map form";
      align-items: start;
      column-gap: clamp(2.75rem, 5vw, 4.5rem);
      row-gap: clamp(2rem, 4vw, 3rem);
    }

    .contact-letter__map-frame,
    .contact-letter__map-canvas {
      height: clamp(16rem, 30vw, 20rem);
    }
  }
</style>

<script is:inline>
  (() => {
    const mapShell = document.querySelector("[data-contact-map]");
    const fallback = mapShell?.querySelector("[data-contact-map-fallback]");
    const frame = mapShell?.querySelector("[data-contact-map-frame]");
    const canvas = document.querySelector("[data-contact-map-canvas]");
    const apiKey = canvas?.dataset.apiKey;
    if (!mapShell) return;

    let readinessTimer;

    const setMapState = (state) => {
      mapShell.dataset.mapState = state;
      mapShell.setAttribute(
        "aria-busy",
        state === "loading" ? "true" : "false",
      );
      if (fallback) fallback.hidden = state !== "error";
    };

    const clearReadinessTimer = () => {
      if (!readinessTimer) return;
      window.clearTimeout(readinessTimer);
      readinessTimer = undefined;
    };

    const markMapReady = () => {
      clearReadinessTimer();
      setMapState("ready");
    };

    const markMapError = () => {
      clearReadinessTimer();
      setMapState("error");
    };

    const startLoading = () => {
      if (mapShell.dataset.mapState === "ready") return;
      setMapState("loading");
      clearReadinessTimer();
      readinessTimer = window.setTimeout(markMapError, 12_000);
    };

    const observeMap = (load) => {
      if (!("IntersectionObserver" in window)) {
        startLoading();
        load();
        return;
      }

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          startLoading();
          load();
        },
        { rootMargin: "400px" },
      );
      observer.observe(mapShell);
    };

    if (frame) {
      frame.addEventListener("load", markMapReady, { once: true });
      frame.addEventListener("error", markMapError, { once: true });
      observeMap(() => {});
      return;
    }

    if (!canvas || !apiKey) {
      markMapError();
      return;
    }

    // CC0 base: "Flat Pale" by Hidenori Ikeda on Snazzy Maps, adapted to
    // the DespreSine Linen + Quiet Olive palette.
    const styles = [
      {
        elementType: "geometry",
        stylers: [{ color: "#f3eee5" }],
      },
      {
        elementType: "labels.icon",
        stylers: [{ visibility: "off" }],
      },
      {
        elementType: "labels.text.fill",
        stylers: [{ color: "#6f685f" }],
      },
      {
        elementType: "labels.text.stroke",
        stylers: [{ color: "#fbf8f2" }],
      },
      {
        featureType: "administrative",
        elementType: "geometry.stroke",
        stylers: [{ color: "#d8d0c3" }],
      },
      {
        featureType: "administrative.land_parcel",
        elementType: "labels",
        stylers: [{ visibility: "off" }],
      },
      {
        featureType: "landscape",
        elementType: "geometry.fill",
        stylers: [{ color: "#f3eee5" }],
      },
      {
        featureType: "poi",
        elementType: "all",
        stylers: [{ visibility: "off" }],
      },
      {
        featureType: "poi.park",
        elementType: "geometry.fill",
        stylers: [{ color: "#e1e4cf" }, { visibility: "on" }],
      },
      {
        featureType: "poi.park",
        elementType: "labels.text.fill",
        stylers: [{ color: "#596140" }, { visibility: "on" }],
      },
      {
        featureType: "road",
        elementType: "geometry.fill",
        stylers: [{ color: "#fdfaf4" }],
      },
      {
        featureType: "road",
        elementType: "geometry.stroke",
        stylers: [{ color: "#e4dccf" }],
      },
      {
        featureType: "road.highway",
        elementType: "geometry.fill",
        stylers: [{ color: "#e9e3d6" }],
      },
      {
        featureType: "road.highway",
        elementType: "labels.text.fill",
        stylers: [{ color: "#514c45" }],
      },
      {
        featureType: "transit",
        elementType: "geometry",
        stylers: [{ color: "#ded8cc" }],
      },
      {
        featureType: "transit.station",
        elementType: "labels.text.fill",
        stylers: [{ color: "#596140" }],
      },
      {
        featureType: "water",
        elementType: "geometry.fill",
        stylers: [{ color: "#dfe4dc" }],
      },
      {
        featureType: "water",
        elementType: "labels.text.fill",
        stylers: [{ color: "#687367" }],
      },
    ];

    window.initDespreSineContactMap = () => {
      const center = { lat: 44.4553, lng: 26.0806 };
      try {
        const map = new window.google.maps.Map(canvas, {
          backgroundColor: "#f3eee5",
          center,
          clickableIcons: false,
          disableDefaultUI: true,
          gestureHandling: "none",
          keyboardShortcuts: false,
          styles,
          zoom: 15,
        });

        new window.google.maps.Circle({
          center,
          clickable: false,
          fillColor: "#596140",
          fillOpacity: 0.1,
          map,
          radius: 450,
          strokeColor: "#596140",
          strokeOpacity: 0.34,
          strokeWeight: 1,
        });
        window.google.maps.event.addListenerOnce(map, "idle", markMapReady);
      } catch {
        markMapError();
      }
    };

    const loadMap = () => {
      const script = document.createElement("script");
      script.async = true;
      script.defer = true;
      script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&callback=initDespreSineContactMap&loading=async&language=ro&region=RO&v=weekly`;
      script.dataset.contactMapsApi = "";
      script.addEventListener("error", markMapError, { once: true });
      document.head.append(script);
    };

    observeMap(loadMap);
  })();
</script>
