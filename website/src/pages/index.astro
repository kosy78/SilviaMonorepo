---
import { IconArrowRight, IconMail } from "@tabler/icons-react";
import { Picture } from "astro:assets";

import practiceSky from "../assets/homepage/practice-sky.jpg";
import HomepageAbout from "../components/sections/HomepageAbout.astro";
import HomepageAreas from "../components/sections/HomepageAreas.astro";
import FaqList from "../components/sections/FaqList.astro";
import HomepageHero from "../components/sections/HomepageHero.astro";
import HomepageOrientation from "../components/sections/HomepageOrientation.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import { Badge } from "../components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "../components/ui/card";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. Credentials, experience and practical wording require
// Silvia's review before publication.

const homepageFaqItems = [
  {
    question: "Cum decurge prima întâlnire?",
    answer:
      "Prima întâlnire oferă timp pentru a discuta ce vă aduce, întrebările pe care le aveți și cadrul în care ar putea continua lucrul. Continuarea poate fi decisă după clarificarea acestor lucruri.",
  },
  {
    question: "Este nevoie să știu exact ce vreau să discut?",
    answer:
      "Nu. Punctul de plecare poate fi o dificultate pe care o puteți numi sau doar sentimentul că ceva important are nevoie de atenție. Nu este necesar să aveți de la început o explicație sau o concluzie.",
  },
  {
    question: "Cum aleg între întâlnirile în cabinet și cele online?",
    answer:
      "Ambele formate sunt disponibile. Puteți alege varianta care se potrivește mai bine contextului dumneavoastră, iar detaliile cadrului sunt clarificate înaintea primei întâlniri.",
  },
  {
    question: "Trebuie să aleg dinainte între consiliere și psihoterapie?",
    answer:
      "Nu este necesar să faceți această alegere înainte de primul mesaj. Punctul de pornire și cadrul pot fi clarificate în primele întâlniri.",
  },
] as const;
---

<BaseLayout
  title="Psihoterapie psihanalitică în București și online"
  description="Psihoterapie psihanalitică și consiliere pentru adulți, tineri adulți și adolescenți de la 16 ani, în București, zona Piața Victoriei / Banu Manta, și online."
>
  <HomepageHero />
  <HomepageOrientation />
  <HomepageAbout />

  <HomepageAreas />

  <section
    class="homepage-faq"
    data-homepage-faq
    aria-labelledby="homepage-faq-title"
  >
    <Container>
      <div class="homepage-faq__layout">
        <header class="homepage-faq__intro">
          <Badge variant="secondary">Întrebări frecvente</Badge>
          <h2 id="homepage-faq-title" class="section-title">
            Înainte de a începe
          </h2>
          <p>
            Câteva răspunsuri despre prima întâlnire și despre cadrul în care
            poate începe lucrul.
          </p>
        </header>

        <div class="homepage-faq__questions">
          <FaqList items={homepageFaqItems} />
        </div>
      </div>
    </Container>
  </section>

  <section class="homepage-practice">
    <div class="homepage-practice__background" aria-hidden="true">
      <Picture
        src={practiceSky}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1754]}
        sizes="100vw"
        quality={84}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="homepage-practice__foreground">
      <Container>
        <div class="homepage-practice__header">
          <div>
            <Badge variant="secondary">Cadrul practic</Badge>
            <h2 class="section-title">În cabinet și online</h2>
          </div>
        </div>

        <div class="homepage-practice__steps">
          <Card>
            <CardHeader>
              <Badge variant="outline">01</Badge>
              <CardTitle asChild className="mt-4 text-3xl">
                <h3>Primul mesaj</h3>
              </CardTitle>
              <CardDescription className="text-base leading-7">
                Puteți întreba despre disponibilitate și puteți menționa
                formatul preferat. Nu este nevoie să trimiteți detalii sensibile
                sau să explicați întreaga situație.
              </CardDescription>
            </CardHeader>
          </Card>

          <Card>
            <CardHeader>
              <Badge variant="outline">02</Badge>
              <CardTitle asChild className="mt-4 text-3xl">
                <h3>Detaliile și prima întâlnire</h3>
              </CardTitle>
              <CardDescription className="text-base leading-7">
                Vă răspund cu informații despre disponibilitate, onorariu și
                format. Dacă decideți să stabilim o primă întâlnire, putem vorbi
                atunci mai pe larg despre ceea ce vă preocupă și despre
                întrebările pe care le aveți.
              </CardDescription>
            </CardHeader>
          </Card>
        </div>

        <Card className="homepage-practice__contact">
          <CardContent className="homepage-practice__contact-content">
            <div>
              <IconMail aria-hidden="true" />
              <p>Puteți folosi formularul sau adresa de email.</p>
            </div>
            <ActionLink href="/contact/" size="lg">
              Trimiteți un prim mesaj
              <IconArrowRight data-icon="inline-end" aria-hidden="true" />
            </ActionLink>
          </CardContent>
        </Card>
      </Container>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-practice {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #dceff4;
    padding-block: var(--section-space);
  }

  .homepage-practice::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 24%),
      rgb(255 255 255 / 42%)
    );
    content: "";
    pointer-events: none;
  }

  .homepage-practice__background {
    position: absolute;
    z-index: 0;
    inset: 0;
  }

  .homepage-practice__background :global(picture),
  .homepage-practice__background :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .homepage-practice__background :global(img) {
    object-fit: cover;
    object-position: center 55%;
  }

  .homepage-practice__foreground {
    position: relative;
    z-index: 2;
  }

  .homepage-practice__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .homepage-practice__header .section-title {
    margin-top: 1.5rem;
  }

  .homepage-practice__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .homepage-practice__steps :global([data-slot="card"]) {
    min-height: 19rem;
  }

  .homepage-practice :global([data-slot="card"]) {
    background: rgb(255 255 255 / 86%);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .homepage-practice__steps :global([data-slot="card-header"]) {
    height: 100%;
    align-content: start;
    padding: 2rem;
  }

  .homepage-practice__contact {
    margin-top: 1rem;
  }

  .homepage-practice__contact-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .homepage-practice__contact-content > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .homepage-practice__contact-content > div :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--chart-3);
  }

  .homepage-faq {
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-faq__layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.78fr) minmax(0, 1.22fr);
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .homepage-faq__intro .section-title {
    margin-top: 1.5rem;
  }

  .homepage-faq__intro > p {
    max-width: 32rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--muted-foreground);
    font-size: 1rem;
    font-weight: 200;
    line-height: 1.8;
  }

  .homepage-faq__questions {
    min-width: 0;
  }

  @media (max-width: 56rem) {
    .homepage-faq__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 48rem) {
    .homepage-practice__header,
    .homepage-practice__steps {
      grid-template-columns: 1fr;
    }

    .homepage-practice__contact-content {
      align-items: stretch;
      flex-direction: column;
    }

    .homepage-practice__contact-content :global(a) {
      width: 100%;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .homepage-practice :global([data-slot="card"]) {
      background: var(--background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
