---
import ActionLink from "../ui/ActionLink.astro";
import Container from "../ui/Container.astro";

const startingPoints = [
  {
    title: "Stări emoționale și manifestări ale corpului",
    description:
      "Anxietate și neliniște, stări depresive sau manifestări psihosomatice.",
  },
  {
    title: "Relații, identitate și stimă de sine",
    description:
      "Dificultăți relaționale, situații care se repetă sau întrebări despre felul în care vă raportați la dumneavoastră și la ceilalți.",
  },
  {
    title: "Schimbări și tranziții de viață",
    description:
      "Perioade în care rolurile, relațiile sau reperele obișnuite se schimbă.",
  },
] as const;
---

<section
  class="homepage-orientation"
  aria-labelledby="homepage-orientation-title"
>
  <Container>
    <div class="homepage-orientation__layout">
      <header class="homepage-orientation__intro">
        <h2 id="homepage-orientation-title" class="section-title">
          Despre Psihoterapia Psihanalitică
        </h2>

        <div class="homepage-orientation__summary">
          <p class="homepage-orientation__lead">
            Psihoterapia psihanalitică este o formă contemporană de terapie care
            își are rădăcinile în psihanaliză, una dintre tradițiile clasice ale
            psihoterapiei moderne.
          </p>

          <div class="homepage-orientation__action">
            <ActionLink href="/psihoterapie-si-consiliere/" variant="secondary">
              Citiți despre psihoterapie și consiliere
            </ActionLink>
          </div>
        </div>
      </header>

      <div class="homepage-orientation__areas">
        {
          startingPoints.map((item, index) => (
            <article>
              <p class="homepage-orientation__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</section>

<style>
  .homepage-orientation {
    border-bottom: 1px solid var(--border);
    background: var(--background);
    padding-block: var(--section-space);
  }

  .homepage-orientation__layout {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  .homepage-orientation__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .homepage-orientation__summary {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .homepage-orientation__lead {
    max-width: 42rem;
    color: var(--foreground);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .homepage-orientation__areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
  }

  .homepage-orientation__areas article {
    border-block-start: 1px solid var(--border);
    padding-block-start: clamp(1.5rem, 3vw, 2rem);
  }

  .homepage-orientation__index {
    margin-block-end: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1;
  }

  .homepage-orientation__areas h3 {
    max-width: 16ch;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .homepage-orientation__areas p {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--muted-foreground);
    line-height: 1.7;
  }

  .homepage-orientation__action {
    justify-self: start;
  }

  @media (max-width: 56rem) {
    .homepage-orientation__intro {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47rem) {
    .homepage-orientation__areas {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .homepage-orientation__areas article {
      padding-block-start: 1.5rem;
    }

    .homepage-orientation__action :global(a) {
      width: 100%;
    }
  }
</style>
