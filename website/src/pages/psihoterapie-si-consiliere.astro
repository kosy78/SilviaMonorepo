---
import { getImage } from "astro:assets";

import firstSessionDoor from "../assets/psychotherapy/first-session-door.jpg";
import PageIntro from "../components/sections/PageIntro.astro";
import PsychotherapyBibliography from "../components/sections/PsychotherapyBibliography";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: in review. Service wording and the explanation for adolescents
// aged 16-17 require Silvia's professional/legal review before launch. The
// consent summary was checked against the CPR Code of Ethics on 2026-07-10.
// The psychoanalytic psychotherapy references were supplied on 2026-08-04 and
// remain subject to source and professional review before publication.

const introParagraphs = [
  "Psihoterapia psihanalitică este o formă contemporană de terapie care își are rădăcinile în psihanaliză, una dintre tradițiile clasice ale psihoterapiei moderne. Păstrează interesul pentru viața interioară, pentru experiențele care ne-au format, pentru emoțiile contradictorii și pentru acele moduri de a reacționa, de a ne proteja sau de a ne raporta la ceilalți care se repetă fără să ne dăm întotdeauna seama de ele (Gabbard, 2017; McWilliams, 2004; Shedler, 2010).",
  "Psihoterapia psihanalitică nu este identică cu psihanaliza clasică. Folosește reperele teoretice și clinice ale psihanalizei într-un cadru psihoterapeutic, de regulă cu o frecvență mai redusă a ședințelor. Pornim de la ceea ce trăiți în prezent și urmărim legăturile dintre stările actuale, relațiile importante, experiențele anterioare și ceea ce se conturează în relația terapeutică (American Psychoanalytic Association, n.d.; Gabbard, 2017; Shedler, 2010).",
];

const firstSessionBackground = await getImage({
  src: firstSessionDoor,
  width: 960,
  format: "webp",
  quality: 76,
});
---

<BaseLayout
  title="Psihoterapie psihanalitică și consiliere în București și online"
  description="Psihoterapie psihanalitică și consiliere pentru adulți, tineri adulți și adolescenți de la 16 ani, în București, zona Piața Victoriei / Banu Manta, și online."
>
  <PageIntro
    title="Despre Psihoterapia Psihanalitică"
    subtitle="O abordare cu rădăcini în psihanaliză"
    description={introParagraphs}
    layout="split"
    showAccent={false}
  >
    <PsychotherapyBibliography slot="description-after" client:visible />
  </PageIntro>

  <section
    class="py-(--section-space)"
    aria-labelledby="first-session-title"
    data-first-session
  >
    <Container>
      <div
        class="first-session-card grid overflow-hidden rounded-3xl bg-muted lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]"
        style={`--first-session-image: url("${firstSessionBackground.src}")`}
      >
        <header
          class="first-session-card__image relative isolate min-h-[23rem] px-6 py-9 sm:min-h-[28rem] sm:px-10 sm:py-12 lg:min-h-0 lg:px-16 lg:py-16"
        >
          <p class="text-foreground/80 text-sm leading-6">Prima ședință</p>
          <h2 id="first-session-title" class="section-title mt-4 max-w-[13ch]">
            Oare cum va fi prima ședință, la ce să mă aștept?
          </h2>
        </header>

        <div class="px-6 py-9 sm:px-10 sm:py-12 lg:py-16 lg:pr-16 lg:pl-10">
          <ol
            class="m-0 grid list-none p-0"
            aria-label="La ce vă puteți aștepta"
          >
            <li
              class="grid gap-4 pb-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:pb-10"
            >
              <p
                class="text-muted-foreground font-display text-xl leading-none"
                aria-hidden="true"
              >
                01
              </p>
              <div>
                <h3 class="text-2xl leading-tight tracking-[-0.02em]">
                  Convorbirea telefonică
                </h3>
                <p class="text-muted-foreground mt-4 max-w-[65ch] leading-7">
                  Înainte de prima întâlnire în cabinet, vom avea o scurtă
                  convorbire telefonică. Aceasta ne ajută să clarificăm motivul
                  pentru care vă doriți să începeți terapia, câteva aspecte
                  practice și să stabilim împreună prima ședință.
                </p>
              </div>
            </li>

            <li
              class="border-line grid gap-4 border-t py-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:py-10"
            >
              <p
                class="text-muted-foreground font-display text-xl leading-none"
                aria-hidden="true"
              >
                02
              </p>
              <div>
                <h3 class="text-2xl leading-tight tracking-[-0.02em]">
                  Prima întâlnire
                </h3>
                <p class="text-muted-foreground mt-4 max-w-[65ch] leading-7">
                  Ședințele nu urmează o listă fixă de exerciții și nu este
                  nevoie să veniți cu un subiect pregătit. Puteți porni de la
                  ceva ce s-a întâmplat recent, de la o relație, o amintire, un
                  vis, o stare din corp sau chiar de la faptul că nu știți cu ce
                  să începeți.
                </p>
              </div>
            </li>

            <li
              class="border-line grid gap-4 border-t pt-8 sm:grid-cols-[2.5rem_1fr] sm:gap-6 lg:pt-10"
            >
              <p
                class="text-muted-foreground font-display text-xl leading-none"
                aria-hidden="true"
              >
                03
              </p>
              <div>
                <h3 class="text-2xl leading-tight tracking-[-0.02em]">
                  Cum lucrăm împreună
                </h3>
                <p class="mt-4 max-w-[65ch] text-lg leading-8">
                  Eu voi asculta și vă voi ajuta să observăm împreună legăturile
                  care se conturează. Întâlnirile au câteva repere clare, care
                  oferă continuitate și siguranță, însă direcția procesului se
                  construiește în funcție de nevoile și ritmul propriu.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-line border-t py-(--section-space)">
    <Container
      class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <div>
        <h2 class="section-title max-w-2xl">
          Pentru a afla dacă există disponibilitate
        </h2>
        <p class="text-muted-foreground mt-5 max-w-xl text-lg leading-7">
          Puteți începe cu un mesaj scurt și, dacă știți deja, puteți menționa
          dacă preferați întâlniri în cabinet sau online.
        </p>
      </div>
      <ActionLink href="/contact/" size="lg">
        Întrebați despre disponibilitate
      </ActionLink>
    </Container>
  </section>
</BaseLayout>

<style>
  .first-session-card {
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / 0.08);
  }

  .first-session-card__image {
    background: var(--muted);
  }

  .first-session-card__image::before,
  .first-session-card__image::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: "";
    pointer-events: none;
  }

  .first-session-card__image::before {
    background-image: var(--first-session-image);
    background-position: center 54%;
    background-size: cover;
    filter: brightness(1.12);
    opacity: 0.8;
  }

  .first-session-card__image::after {
    background-image:
      linear-gradient(
        to bottom,
        color-mix(in oklch, var(--muted) 18%, transparent) 45%,
        var(--muted) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in oklch, var(--background) 18%, transparent) 0%,
        transparent 58%,
        var(--muted) 100%
      );
  }

  .first-session-card__image > * {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 64rem) {
    .first-session-card__image::before {
      background-position: center 52%;
    }

    .first-session-card__image::after {
      background-image: linear-gradient(
        to right,
        color-mix(in oklch, var(--background) 16%, transparent) 0%,
        transparent 52%,
        var(--muted) 100%
      );
    }
  }
</style>
