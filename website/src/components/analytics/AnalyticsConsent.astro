---
import { Button } from "../ui/button";
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "../ui/card";

const defaultMeasurementId = "G-D490J31F6H";
const measurementId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || defaultMeasurementId;
const hasMeasurementId = Boolean(measurementId);
---

{
  hasMeasurementId && (
    <>
      <Card
        data-analytics-consent
        hidden
        className="ui-panel-enter fixed inset-x-4 bottom-4 z-50 mx-auto max-w-2xl gap-0 py-0 shadow-[0_1.25rem_3.75rem_color-mix(in_oklch,var(--foreground)_16%,transparent)] md:bottom-6"
        aria-labelledby="analytics-consent-title"
        aria-describedby="analytics-consent-description"
        role="dialog"
        tabIndex={-1}
      >
        <CardHeader className="px-5 py-5 md:px-6 md:py-6">
          <CardTitle id="analytics-consent-title" className="text-2xl">
            Confidențialitate
          </CardTitle>
          <CardDescription
            id="analytics-consent-description"
            className="mt-1 max-w-xl leading-6 text-foreground!"
          >
            Google Analytics se încarcă numai dacă acceptați. Îl folosim pentru
            statistici agregate despre paginile vizitate și accesarea linkurilor
            de email pentru contact. Nu trimitem răspunsurile din reflecție,
            datele completate în formular sau conținutul mesajelor.
          </CardDescription>
        </CardHeader>

        <CardFooter className="flex-col items-stretch gap-2 px-5 py-4 sm:flex-row sm:justify-end md:px-6">
          <Button type="button" data-analytics-accept size="sm">
            Acceptați măsurarea
          </Button>
          <Button
            type="button"
            data-analytics-reject
            size="sm"
            variant="outline"
          >
            Continuați fără măsurare
          </Button>
        </CardFooter>
      </Card>

      <script
        is:inline
        defer
        src="/analytics-consent.js"
        data-ga-measurement-id={measurementId}
      />
    </>
  )
}
