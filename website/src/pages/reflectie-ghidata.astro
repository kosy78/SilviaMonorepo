---
import GuidedReflection from "../components/islands/GuidedReflection";
import ActionLink from "../components/ui/ActionLink.astro";
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy status: draft. The guided reflection is non-diagnostic and requires
// Silvia's review before publication.
---

<BaseLayout
  title="Despre sine: Reflecție ghidată"
  description="O reflecție ghidată anonimă despre felul în care o dificultate se poate face vizibilă în corp, în stări emoționale sau în relații."
>
  <section class="border-line border-b py-(--intro-space)">
    <Container>
      <h1 class="display-page">Ce pare să ceară atenție acum?</h1>

      <div class="mt-9 grid gap-8 md:grid-cols-[1.25fr_0.75fr] md:items-end">
        <p class="text-muted max-w-2xl text-lg leading-8 md:text-xl">
          O reflecție scurtă pentru momentele în care dificultatea nu este încă
          ușor de formulat. Cele șapte întrebări vă invită să observați ce apare
          mai des în răspunsuri: corpul, stările emoționale sau relațiile.
        </p>
        <ActionLink href="#reflectie">Începeți reflecția</ActionLink>
      </div>

      <ul
        class="border-line mt-10 grid border-t p-0 text-sm md:grid-cols-3 md:divide-x"
      >
        <li class="border-line list-none border-b py-4 md:border-b-0 md:pr-5">
          7 întrebări, câte una pe ecran
        </li>
        <li class="border-line list-none border-b py-4 md:border-b-0 md:px-5">
          Răspunsurile nu sunt stocate
        </li>
        <li class="list-none py-4 md:pl-5">
          Puteți opri sau relua parcursul oricând
        </li>
      </ul>
      <p class="text-muted mt-4 max-w-2xl text-sm leading-6">
        Reîncărcarea sau părăsirea paginii șterge răspunsurile. Rezultatul este
        orientativ și nu reprezintă un diagnostic.
      </p>
    </Container>
  </section>

  <GuidedReflection client:load />
</BaseLayout>
